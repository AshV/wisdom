# ==============================================================================
# WISDOM COLLECTION — SOCIAL MEDIA PUBLISHER CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. YOUTUBE SHORTS (YouTube Data API v3)
# ------------------------------------------------------------------------------
# Steps to obtain:
#   1. Go to Google Cloud Console (https://console.cloud.google.com)
#   2. Create a project and enable "YouTube Data API v3"
#   3. Go to "Credentials" -> "Create Credentials" -> "OAuth 2.0 Client ID"
#   4. Application type: Web application
#   5. Add Authorized Redirect URI: http://localhost:8989/oauth2callback
#   6. Fill in CLIENT_ID and CLIENT_SECRET below.
#   7. Run: `npx wisdom publish --auth-youtube` to authorize and auto-populate REFRESH_TOKEN!
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token_auto_populated_by_cli

# ------------------------------------------------------------------------------
# 2. CLOUDINARY (Free Tier Temporary Video Hosting for Meta API)
# ------------------------------------------------------------------------------
# Meta requires a public HTTPS video URL. The publisher script uploads the video
# to your Cloudinary free account, gives the URL to Meta, and then automatically
# deletes it as soon as Meta has processed it (preserving 100% of your free storage).
# Sign up free at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# 3. INSTAGRAM REELS (Meta Graph API)
# ------------------------------------------------------------------------------
# Steps to obtain:
#   1. Have an Instagram Professional (Creator or Business) Account
#   2. Link your Instagram account to a Facebook Page
#   3. Go to Meta for Developers (https://developers.facebook.com)
#   4. Create an App (Type: Business), add "Instagram Graph API"
#   5. Generate User/Page Access Token with:
#      - instagram_basic
#      - instagram_content_publish
#      - pages_show_list
#   6. Get your Instagram Business Account ID from:
#      GET graph.facebook.com/v19.0/me/accounts?fields=instagram_business_account
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_meta_access_token
