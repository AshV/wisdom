---
/**
 * ExploreDrawer — High-end slide-up discovery sheet.
 *
 * Tabs:
 * 1. Liked (Saved quotes from localStorage with instant unlike & jump-to)
 * 2. Moods (Visual mood cards)
 * 3. Categories (Categorized wisdom)
 * 4. Authors (Directory of timeless thinkers)
 * 5. Tags (Topic tag cloud)
 */
import { getCollection } from 'astro:content';
import { moodMeta, allMoods } from '../data/mediaRegistry';
import { slugifyQuote } from '../utils/slug';

const allQuotes = await getCollection('quotes');
const BASE = '/wisdom';

// Aggregate counts
const moodCounts: Record<string, number> = {};
const categoryCounts: Record<string, { name: string; slug: string; count: number }> = {};
const authorCounts: Record<string, { name: string; slug: string; count: number }> = {};
const tagCounts: Record<string, number> = {};

allQuotes.forEach((q) => {
  const d = q.data;
  moodCounts[d.mood] = (moodCounts[d.mood] || 0) + 1;
  if (!categoryCounts[d.categorySlug]) {
    categoryCounts[d.categorySlug] = { name: d.category, slug: d.categorySlug, count: 0 };
  }
  categoryCounts[d.categorySlug].count++;
  if (!authorCounts[d.authorSlug]) {
    authorCounts[d.authorSlug] = { name: d.author, slug: d.authorSlug, count: 0 };
  }
  authorCounts[d.authorSlug].count++;
  d.tags.forEach((t) => {
    tagCounts[t] = (tagCounts[t] || 0) + 1;
  });
});

const categories = Object.values(categoryCounts).sort((a, b) => b.count - a.count);
const totalAuthorsCount = Object.keys(authorCounts).length;
const totalTagsCount = Object.keys(tagCounts).length;
const popularAuthors = Object.values(authorCounts).sort((a, b) => b.count - a.count).slice(0, 24);
const popularTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]).slice(0, 48);

const categoryIcons: Record<string, string> = {
  philosophy: '🏛️',
  wisdom: '📜',
  resilience: '🛡️',
  nature: '🌿',
  creativity: '🎨',
  love: '💕',
  science: '🔬',
  spirituality: '🕊️',
  humor: '😄',
  leadership: '👑',
};
---

<div
  id="explore-drawer"
  class="fixed inset-0 z-50 hidden flex items-end sm:items-center justify-center p-0 sm:p-6 md:p-8 lg:p-12"
  style="display: none;"
  aria-modal="true"
  role="dialog"
>
  <!-- Backdrop -->
  <div
    id="explore-backdrop"
    class="absolute inset-0 bg-black/80 backdrop-blur-2xl transition-opacity duration-300 cursor-pointer"
  ></div>

  <!-- Sheet: Centered, expansive, luxury sanctuary dialog on desktop / sleek bottom sheet on mobile -->
  <div
    id="explore-sheet"
    class="relative w-full sm:max-w-4xl lg:max-w-5xl flex flex-col z-10 animate-slide-up-sheet overflow-hidden rounded-t-[28px] sm:rounded-3xl border border-white/10"
    style="height: min(84vh, 800px); max-height: calc(100vh - 3.5rem); background: linear-gradient(180deg, rgba(20, 15, 38, 0.98) 0%, rgba(10, 8, 20, 0.99) 100%); box-shadow: 0 25px 80px -15px rgba(0, 0, 0, 0.95), 0 0 0 1px rgba(255, 255, 255, 0.08);"
  >
    <!-- Top Pull Bar (Mobile drag affordance) -->
    <div id="explore-drag-handle" class="sm:hidden flex justify-center pt-3 pb-1 cursor-grab active:cursor-grabbing">
      <div class="w-12 h-1.5 rounded-full bg-white/25 hover:bg-white/40 transition-colors"></div>
    </div>

    <!-- Header -->
    <div
      class="flex items-center justify-between border-b border-white/6"
      style="padding-left: clamp(1.5rem, 4vw, 3rem); padding-right: clamp(1.5rem, 4vw, 3rem); padding-top: 1.25rem; padding-bottom: 1rem;"
    >
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-amber-400/20 via-purple-500/15 to-transparent border border-amber-400/30 flex items-center justify-center text-amber-300 shadow-sm flex-shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
          </svg>
        </div>
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight leading-tight">Explore Wisdom</h2>
          <div class="flex items-center gap-2 mt-0.5">
            <span class="text-xs text-white/50">{allQuotes.length} Timeless Quotes</span>
            <span class="text-white/20">•</span>
            <span class="text-xs text-white/50">{totalAuthorsCount} Authors</span>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2.5">
        <button
          id="pwa-drawer-install-btn"
          type="button"
          class="hidden items-center gap-2 px-4 py-2 rounded-full bg-amber-400/15 border border-amber-400/30 text-amber-300 hover:bg-amber-400/25 hover:text-amber-200 text-xs font-medium tracking-wide transition-all cursor-pointer shadow-sm"
          title="Install Wisdom App to Home Screen"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span>Install App</span>
        </button>
        <button
          id="explore-close-btn"
          class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/8 hover:bg-white/18 active:scale-90 flex items-center justify-center transition-all text-white/60 hover:text-white cursor-pointer border border-white/10"
          aria-label="Close Explore"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Search Input -->
    <div style="padding-left: clamp(1.5rem, 4vw, 3rem); padding-right: clamp(1.5rem, 4vw, 3rem); padding-top: 1rem; padding-bottom: 0.75rem;">
      <div class="relative flex items-center">
        <svg
          class="absolute left-4 text-white/40 pointer-events-none z-10"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.35-4.35" />
        </svg>
        <input
          id="explore-search"
          type="text"
          placeholder="Search quotes, authors, topics, or keywords..."
          style="padding-left: 52px; padding-right: 48px;"
          class="w-full py-3 sm:py-3.5 rounded-2xl bg-white/[0.05] hover:bg-white/[0.08] focus:bg-white/[0.1] border border-white/[0.1] focus:border-amber-400/50 text-sm sm:text-base text-white placeholder:text-white/35 focus:outline-none focus:ring-2 focus:ring-amber-400/20 transition-all leading-normal shadow-inner"
          autocomplete="off"
        />
        <button
          id="explore-search-clear"
          class="absolute right-3.5 w-7 h-7 rounded-full bg-white/10 hover:bg-white/20 text-white/60 hover:text-white hidden items-center justify-center cursor-pointer transition-colors z-10"
          aria-label="Clear search"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Horizontal Tab Bar -->
    <div
      class="border-b border-white/8 flex items-center gap-2 overflow-x-auto no-scrollbar py-2.5 bg-white/[0.02]"
      style="padding-left: clamp(1.5rem, 4vw, 3rem); padding-right: clamp(1.5rem, 4vw, 3rem);"
    >
      <button
        class="explore-tab active flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap cursor-pointer transition-all duration-200 border bg-white/15 text-white border-white/20 shadow-sm backdrop-blur-md"
        data-tab="liked"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-red-400">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
        </svg>
        <span>Liked</span>
        <span id="liked-tab-badge" class="text-[10px] font-bold px-2 py-1 rounded-full bg-white/10 text-white/60 ml-0.5 min-w-[20px] text-center inline-flex items-center justify-center leading-none">0</span>
      </button>

      <button
        class="explore-tab flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap cursor-pointer transition-all duration-200 border border-transparent text-white/55 hover:text-white hover:bg-white/8"
        data-tab="moods"
      >
        <span>✨</span>
        <span>Moods</span>
        <span class="text-[11px] text-white/40 font-normal">({allMoods.length})</span>
      </button>

      <button
        class="explore-tab flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap cursor-pointer transition-all duration-200 border border-transparent text-white/55 hover:text-white hover:bg-white/8"
        data-tab="categories"
      >
        <span>📂</span>
        <span>Categories</span>
        <span class="text-[11px] text-white/40 font-normal">({categories.length})</span>
      </button>

      <button
        class="explore-tab flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap cursor-pointer transition-all duration-200 border border-transparent text-white/55 hover:text-white hover:bg-white/8"
        data-tab="authors"
      >
        <span>✍️</span>
        <span>Authors</span>
        <span class="text-[11px] text-white/40 font-normal">({totalAuthorsCount})</span>
      </button>

      <button
        class="explore-tab flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap cursor-pointer transition-all duration-200 border border-transparent text-white/55 hover:text-white hover:bg-white/8"
        data-tab="tags"
      >
        <span>🏷️</span>
        <span>Tags</span>
        <span class="text-[11px] text-white/40 font-normal">({totalTagsCount})</span>
      </button>

      <button
        class="explore-tab flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap cursor-pointer transition-all duration-200 border border-transparent text-white/55 hover:text-white hover:bg-white/8"
        data-tab="rituals"
      >
        <span>🧘</span>
        <span>Rituals</span>
      </button>
    </div>

    <!-- Content Area (Scrollable Viewport with Generous Padding) -->
    <div
      id="explore-scroll-area"
      class="flex-1 overflow-y-auto overflow-x-hidden scrollbar-thin"
      style="padding-left: clamp(1.5rem, 4vw, 3rem); padding-right: clamp(1.5rem, 4vw, 3rem); padding-top: 1.75rem; padding-bottom: 6rem;"
    >
      
      <!-- 1. Liked Tab -->
      <div id="tab-liked" class="explore-tab-content">
        <!-- Liked items populated dynamically via JS in 2-column responsive grid -->
        <div id="liked-items-container" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>

        <!-- Empty State for Liked -->
        <div id="liked-empty-state" class="flex flex-col items-center justify-center py-20 px-6 text-center">
          <div class="w-20 h-20 rounded-3xl bg-gradient-to-tr from-pink-500/20 via-red-500/15 to-transparent border border-red-500/25 flex items-center justify-center mb-5 shadow-xl shadow-red-500/10">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#f43f5e" stroke-width="2">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-white mb-2 font-serif">Your Sanctuary Awaits</h3>
          <p class="text-sm text-white/50 max-w-md leading-relaxed mb-6">
            Double-tap any quote or tap the heart in the action rail while browsing to save timeless reflections here for offline contemplation.
          </p>
          <button
            id="liked-browse-btn"
            class="px-6 py-3 rounded-full bg-white/12 hover:bg-white/20 active:scale-95 text-sm font-semibold text-white border border-white/15 transition-all cursor-pointer shadow-lg hover:shadow-white/5"
          >
            Explore Moods &amp; Inspirations
          </button>
        </div>
      </div>

      <!-- 2. Moods Tab -->
      <div id="tab-moods" class="explore-tab-content hidden grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-5">
        {allMoods.map((mood) => (
          <a
            href={`${BASE}/mood/${mood}/`}
            class={`explore-item mood-pill-${mood} rounded-2xl sm:rounded-3xl flex flex-col justify-between min-h-[190px] sm:min-h-[200px] hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 shadow-xl group border border-white/15 hover:border-white/30 relative overflow-hidden`}
            style="padding: 1.5rem 1.5rem 2.25rem 1.5rem;"
            data-search-text={`${moodMeta[mood].label} ${mood}`}
          >
            <div class="flex items-center justify-between z-10">
              <span class="text-4xl sm:text-5xl group-hover:scale-110 transition-transform duration-300 select-none">{moodMeta[mood].emoji}</span>
              <span class="text-xs font-bold text-white/95 bg-black/40 backdrop-blur-md rounded-full px-3 py-1.5 border border-white/15 min-w-[32px] text-center inline-flex items-center justify-center leading-none">
                {moodCounts[mood] || 0}
              </span>
            </div>
            <div class="z-10 mt-auto pt-4">
              <span class="text-base sm:text-lg font-bold text-white block capitalize tracking-tight leading-tight mb-1">{moodMeta[mood].label}</span>
              <span class="text-xs text-white/80 group-hover:text-white font-medium flex items-center gap-1 transition-colors">
                Explore stream <span class="group-hover:translate-x-1 transition-transform">→</span>
              </span>
            </div>
            <!-- Subtle bottom contrast vignette -->
            <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/50 via-black/20 to-transparent pointer-events-none"></div>
          </a>
        ))}
      </div>

      <!-- 3. Categories Tab -->
      <div id="tab-categories" class="explore-tab-content hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4">
        {categories.map((cat) => (
          <a
            href={`${BASE}/category/${cat.slug}/`}
            class="explore-item glass rounded-2xl px-5 py-4 sm:py-4.5 flex items-center justify-between hover:bg-white/[0.09] active:scale-[0.98] border border-white/8 hover:border-white/20 transition-all duration-200 group"
            data-search-text={cat.name}
          >
            <div class="flex items-center gap-4">
              <span class="w-12 h-12 rounded-xl bg-white/8 border border-white/10 flex items-center justify-center text-2xl flex-shrink-0 group-hover:scale-110 transition-transform select-none">
                {categoryIcons[cat.slug.toLowerCase()] || '📂'}
              </span>
              <div>
                <span class="text-sm sm:text-base font-bold text-white group-hover:text-amber-200 transition-colors block mb-0.5">{cat.name}</span>
                <span class="text-xs text-white/50">{cat.count} curated quotes</span>
              </div>
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-white/30 group-hover:text-white group-hover:translate-x-1 transition-all flex-shrink-0">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </a>
        ))}
      </div>

      <!-- 4. Authors Tab -->
      <div id="tab-authors" class="explore-tab-content hidden space-y-4">
        <!-- Author Roadmap / ToDo Banner -->
        <a
          href={`${BASE}/todo/`}
          class="rounded-2xl sm:rounded-3xl p-5 sm:p-6 flex items-center justify-between gap-4 bg-gradient-to-r from-purple-950/60 via-indigo-950/40 to-purple-950/60 border border-purple-400/30 hover:border-purple-400/50 hover:scale-[1.005] active:scale-[0.99] transition-all group shadow-xl"
        >
          <div class="flex items-center gap-4">
            <span class="w-12 h-12 rounded-2xl bg-purple-500/20 border border-purple-400/40 flex items-center justify-center text-purple-300 text-lg font-bold flex-shrink-0">
              ✦
            </span>
            <div>
              <span class="text-base font-bold text-purple-200 block mb-0.5">Author Roadmap &amp; Curation Tracker</span>
              <span class="text-xs text-white/50">Planned 100+ batches across Eastern, Stoic, and Modern philosophers</span>
            </div>
          </div>
          <span class="text-xs text-purple-300 font-semibold flex items-center gap-1.5 group-hover:translate-x-1 transition-transform flex-shrink-0 bg-purple-500/20 px-4 py-2 rounded-full border border-purple-400/30">
            View Roadmap
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6" /></svg>
          </span>
        </a>

        <!-- Authors Grid (Curated Primary Thinkers) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
          {popularAuthors.map((auth, i) => {
            const hue = (i * 137.5) % 360;
            return (
              <a
                href={`${BASE}/author/${auth.slug}/`}
                class="explore-item glass rounded-2xl p-4 flex items-center gap-3.5 hover:bg-white/[0.09] active:scale-[0.98] border border-white/8 hover:border-white/20 transition-all duration-200 group"
                data-search-text={auth.name}
              >
                <span
                  class="w-11 h-11 rounded-full flex items-center justify-center text-sm font-bold text-white shadow-md flex-shrink-0 select-none"
                  style={`background: linear-gradient(135deg, hsl(${hue}, 65%, 48%), hsl(${(hue + 45) % 360}, 55%, 38%)); border: 1px solid rgba(255,255,255,0.25);`}
                >
                  {auth.name.charAt(0)}
                </span>
                <div class="flex-1 min-w-0">
                  <span class="text-sm font-bold text-white block group-hover:text-amber-200 transition-colors truncate mb-0.5">{auth.name}</span>
                  <span class="text-xs text-white/50">{auth.count} {auth.count === 1 ? 'timeless quote' : 'timeless quotes'}</span>
                </div>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-white/25 group-hover:text-white/80 group-hover:translate-x-1 transition-all flex-shrink-0">
                  <polyline points="9 18 15 12 9 6" />
                </svg>
              </a>
            );
          })}
        </div>
      </div>

      <!-- 5. Tags Tab (Popular & Trending Themes) -->
      <div id="tab-tags" class="explore-tab-content hidden">
        <div class="flex flex-wrap gap-2.5 sm:gap-3 pt-1">
          {popularTags.map(([tag, count]) => {
            const isHighCount = count >= 3;
            return (
              <a
                href={`${BASE}/tag/${tag}/`}
                class={`explore-item rounded-full px-4 py-2 text-xs sm:text-sm font-medium transition-all duration-200 inline-flex items-center gap-2.5 active:scale-95 border leading-normal ${
                  isHighCount
                    ? 'bg-white/12 hover:bg-white/22 text-white border-white/20 shadow-sm'
                    : 'bg-white/6 hover:bg-white/14 text-white/80 border-white/8'
                }`}
                data-search-text={tag}
              >
                <span>#{tag}</span>
                <span class="text-[10px] text-white/70 font-bold bg-black/35 rounded-full px-2.5 py-1 min-w-[20px] text-center inline-flex items-center justify-center leading-none">
                  {count}
                </span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- 6. Rituals Tab -->
      <div id="tab-rituals" class="explore-tab-content hidden space-y-5">
        <!-- Header Banner -->
        <div class="p-6 rounded-2xl sm:rounded-3xl bg-gradient-to-br from-amber-500/15 via-purple-500/10 to-transparent border border-amber-400/20 shadow-xl">
          <div class="flex items-center gap-3.5 mb-2.5">
            <span class="text-3xl select-none">🧘</span>
            <div>
              <h3 class="text-lg font-bold text-white tracking-wide font-serif">Daily Contemplation Rituals</h3>
              <span class="text-xs text-amber-300/80 font-medium">Sacred pauses delivered directly to your device</span>
            </div>
          </div>
          <p class="text-sm text-white/65 leading-relaxed font-sans max-w-2xl">
            Anchor your daily life with timeless philosophy. Receive gentle, mindful reflections on your screen at your chosen sacred hours — 100% offline, privacy-first, zero distractions.
          </p>
        </div>

        <!-- Ritual Cards in 3-column responsive grid on desktop -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Ritual Card 1: Morning Reflection -->
          <div class="p-5 rounded-2xl bg-white/[0.04] border border-white/8 hover:border-white/18 transition-all flex flex-col justify-between gap-4">
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <span class="text-3xl select-none">🌅</span>
                <div>
                  <div class="text-sm font-semibold text-white mb-0.5">Morning Awakening</div>
                  <div class="text-xs text-white/50">Awaken your mind with purpose</div>
                </div>
              </div>
              <label class="relative inline-flex items-center cursor-pointer flex-shrink-0 mt-1">
                <input type="checkbox" id="ritual-morning-toggle" class="sr-only peer">
                <div class="w-11 h-6 bg-white/15 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-400 shadow-inner"></div>
              </label>
            </div>
            <div class="flex items-center justify-between pt-3 border-t border-white/8 text-xs text-white/65">
              <span class="font-medium">Scheduled Time</span>
              <input
                type="time"
                id="ritual-morning-time"
                value="08:00"
                class="bg-white/10 border border-white/15 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none focus:border-amber-400 font-mono transition-colors"
              />
            </div>
          </div>

          <!-- Ritual Card 2: Evening Stillness -->
          <div class="p-5 rounded-2xl bg-white/[0.04] border border-white/8 hover:border-white/18 transition-all flex flex-col justify-between gap-4">
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <span class="text-3xl select-none">🌌</span>
                <div>
                  <div class="text-sm font-semibold text-white mb-0.5">Evening Stillness</div>
                  <div class="text-xs text-white/50">Release the day into peace</div>
                </div>
              </div>
              <label class="relative inline-flex items-center cursor-pointer flex-shrink-0 mt-1">
                <input type="checkbox" id="ritual-evening-toggle" class="sr-only peer">
                <div class="w-11 h-6 bg-white/15 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-400 shadow-inner"></div>
              </label>
            </div>
            <div class="flex items-center justify-between pt-3 border-t border-white/8 text-xs text-white/65">
              <span class="font-medium">Scheduled Time</span>
              <input
                type="time"
                id="ritual-evening-time"
                value="21:00"
                class="bg-white/10 border border-white/15 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none focus:border-amber-400 font-mono transition-colors"
              />
            </div>
          </div>

          <!-- Ritual Card 3: Zen Contemplation Bell -->
          <div class="p-5 rounded-2xl bg-white/[0.04] border border-white/8 hover:border-white/18 transition-all flex flex-col justify-between gap-4">
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <span class="text-3xl select-none">🔔</span>
                <div>
                  <div class="text-sm font-semibold text-white mb-0.5">Zen Temple Bell</div>
                  <div class="text-xs text-white/50">Gentle chime while reading</div>
                </div>
              </div>
              <label class="relative inline-flex items-center cursor-pointer flex-shrink-0 mt-1">
                <input type="checkbox" id="ritual-zen-toggle" class="sr-only peer">
                <div class="w-11 h-6 bg-white/15 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-amber-400 shadow-inner"></div>
              </label>
            </div>
            <div class="flex items-center justify-between pt-3 border-t border-white/8 text-xs text-white/65">
              <span class="font-medium">Chime Interval</span>
              <select
                id="ritual-zen-interval"
                class="bg-neutral-900 border border-white/15 rounded-xl px-3 py-1.5 text-xs text-white focus:outline-none focus:border-amber-400 font-sans cursor-pointer transition-colors"
              >
                <option value="5">Every 5 min</option>
                <option value="10" selected>Every 10 min</option>
                <option value="15">Every 15 min</option>
                <option value="20">Every 20 min</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Action Buttons: Send Test Reflection & Status -->
        <div class="pt-2 flex flex-col gap-3 max-w-md mx-auto">
          <button
            id="ritual-test-btn"
            type="button"
            class="w-full py-3.5 px-6 rounded-2xl bg-white/8 hover:bg-white/15 active:scale-95 text-sm font-semibold text-white border border-white/12 hover:border-white/25 transition-all flex items-center justify-center gap-2.5 cursor-pointer shadow-lg"
          >
            <svg class="w-4 h-4 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
              <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
            <span>Preview Daily Reflection Notification</span>
          </button>
          <div id="ritual-status-msg" class="text-xs text-center text-white/50 hidden py-1"></div>
        </div>
      </div>

      <!-- Empty Search Filter State -->
      <div id="explore-search-empty" class="hidden flex-col items-center justify-center py-20 text-center">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-white/20 mb-4">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.35-4.35" />
        </svg>
        <p class="text-base font-semibold text-white/70 mb-1">No matches found</p>
        <p class="text-xs text-white/40 mt-1">Try a different author, mood, or keyword</p>
        <button
          id="explore-reset-search-btn"
          class="mt-5 px-5 py-2 rounded-full bg-white/10 hover:bg-white/20 text-xs text-white/80 hover:text-white font-medium cursor-pointer transition-colors border border-white/12"
        >
          Clear search filter
        </button>
      </div>

    </div>
  </div>
</div>

<!-- Base URL configuration -->
<script is:inline>
  window.__wisdomBaseUrl = '/wisdom';
</script>

<script is:inline>
  function setupExploreDrawer() {
    const drawer = document.getElementById('explore-drawer');
    const backdrop = document.getElementById('explore-backdrop');
    const closeBtn = document.getElementById('explore-close-btn');
    const sheet = document.getElementById('explore-sheet');
    const tabs = document.querySelectorAll('.explore-tab');
    const tabContents = document.querySelectorAll('.explore-tab-content');
    const searchInput = document.getElementById('explore-search');
    const searchClear = document.getElementById('explore-search-clear');
    const searchEmpty = document.getElementById('explore-search-empty');
    const resetSearchBtn = document.getElementById('explore-reset-search-btn');
    const likedBadge = document.getElementById('liked-tab-badge');
    const likedContainer = document.getElementById('liked-items-container');
    const likedEmpty = document.getElementById('liked-empty-state');
    const likedBrowseBtn = document.getElementById('liked-browse-btn');
    const dragHandle = document.getElementById('explore-drag-handle');

    let currentActiveTab = 'liked';

    // ── Update Liked Tab Badge & Render (Self-Contained Local Storage) ──
    function refreshLikedQuotes() {
      if (!window.likedQuotes) return;
      const allLikes = window.likedQuotes.getAll();

      // Update count badge
      if (likedBadge) {
        likedBadge.textContent = String(allLikes.length);
        if (allLikes.length > 0) {
          likedBadge.classList.remove('bg-white/10', 'text-white/50');
          likedBadge.classList.add('bg-red-500/25', 'text-red-300');
        } else {
          likedBadge.classList.remove('bg-red-500/25', 'text-red-300');
          likedBadge.classList.add('bg-white/10', 'text-white/50');
        }
      }

      if (!likedContainer) return;
      likedContainer.innerHTML = '';

      if (allLikes.length === 0) {
        if (likedEmpty) likedEmpty.classList.remove('hidden');
        return;
      }

      if (likedEmpty) likedEmpty.classList.add('hidden');

      // Render cards in reverse chronological order (newest likes first)
      const base = window.__wisdomBaseUrl || '/wisdom';

      allLikes.slice().reverse().forEach((item) => {
        const quote = (typeof item === 'object' && item !== null) ? item : (window.__wisdomQuoteMap ? window.__wisdomQuoteMap[item] : null);
        if (!quote || !quote.content) return;
        const id = quote.id;

        const card = document.createElement('div');
        card.className =
          'explore-item rounded-2xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 hover:border-white/20 transition-all duration-200 group relative flex flex-col justify-between gap-4 shadow-sm';
        card.style.cssText = 'padding: clamp(1.25rem, 2.5vw, 1.75rem);';
        card.dataset.searchText = `${quote.content} ${quote.author} ${quote.category}`;

        // Quote text & Author
        const contentBlock = document.createElement('div');
        contentBlock.className = 'cursor-pointer flex-1';
        contentBlock.innerHTML = `
          <div class="flex items-start gap-2 mb-2">
            <span class="text-2xl sm:text-3xl text-amber-400/40 font-serif leading-none select-none">“</span>
            <p class="font-serif text-[15px] sm:text-[16px] text-white/95 leading-relaxed italic line-clamp-4 group-hover:text-white transition-colors">
              ${escapeHtml(quote.content)}
            </p>
          </div>
          <div class="mt-3 flex items-center justify-between">
            <span class="text-xs font-semibold text-white/75 tracking-wide">— ${escapeHtml(quote.author)}</span>
            <span class="text-[10px] font-semibold text-white/60 bg-white/10 px-3 py-1 rounded-full border border-white/10 uppercase tracking-wider leading-normal">
              ${escapeHtml(quote.category)}
            </span>
          </div>
        `;

        // Action Row
        const actionRow = document.createElement('div');
        actionRow.className = 'pt-2 border-t border-white/8 flex items-center justify-between';

        // Navigate button
        const jumpBtn = document.createElement('button');
        jumpBtn.className =
          'inline-flex items-center gap-1.5 text-xs font-medium text-accent-start hover:text-white transition-colors cursor-pointer';
        jumpBtn.innerHTML = `
          <span>Open Quote</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        `;
        jumpBtn.onclick = (e) => {
          e.stopPropagation();
          navigateToQuote(quote);
        };

        // Unlike button
        const unlikeBtn = document.createElement('button');
        unlikeBtn.className =
          'w-7 h-7 rounded-full bg-red-500/15 hover:bg-red-500/25 active:scale-90 flex items-center justify-center transition-all text-red-400 cursor-pointer';
        unlikeBtn.title = 'Remove from Liked';
        unlikeBtn.setAttribute('aria-label', 'Remove from Liked');
        unlikeBtn.innerHTML = `
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
          </svg>
        `;
        unlikeBtn.onclick = (e) => {
          e.stopPropagation();
          window.likedQuotes.toggle(id);

          // Animate card removal
          card.style.transition = 'all 0.25s ease';
          card.style.opacity = '0';
          card.style.transform = 'scale(0.95)';
          setTimeout(() => {
            refreshLikedQuotes();
            // Sync with current slide if visible
            const activeSlide = document.querySelector('.reel-slide.is-active') || document.querySelector('.reel-slide');
            if (activeSlide && window.updateLikeUI) {
              window.updateLikeUI(window.likedQuotes.has(activeSlide.dataset.quoteId));
            }
          }, 240);

          if (window.showToast) {
            window.showToast('Removed from favorites');
          }
        };

        contentBlock.onclick = () => navigateToQuote(quote);

        actionRow.appendChild(jumpBtn);
        actionRow.appendChild(unlikeBtn);
        card.appendChild(contentBlock);
        card.appendChild(actionRow);
        likedContainer.appendChild(card);
      });
    }

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // ── Navigation to Quote ──
    function navigateToQuote(quote) {
      closeDrawer();
      const reelContainer = document.getElementById('reel-container');
      const targetHash = quote.slug || quote.id;

      if (reelContainer) {
        // We are on the main feed page — scroll directly to slide!
        const targetSlide =
          reelContainer.querySelector(`[data-quote-slug="${targetHash}"]`) ||
          document.getElementById(`slide-${quote.id}`);
        if (targetSlide) {
          setTimeout(() => {
            targetSlide.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.replaceState(null, '', `#${targetHash}`);
          }, 320);
          return;
        }
      }

      // If not in DOM or on a subpage, navigate to root feed with hash
      const base = window.__wisdomBaseUrl || '/wisdom';
      setTimeout(() => {
        window.location.href = `${base}/#${targetHash}`;
      }, 300);
    }

    // ── Tab Switching ──
    function activateTab(target) {
      currentActiveTab = target;

      tabs.forEach((tab) => {
        const isSelected = tab.dataset.tab === target;
        if (isSelected) {
          tab.classList.add('active', 'bg-white/15', 'text-white', 'border-white/20', 'shadow-sm', 'backdrop-blur-md');
          tab.classList.remove('border-transparent', 'text-white/55');
          // Ensure active tab is scrolled into view in horizontal bar
          tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          tab.classList.remove('active', 'bg-white/15', 'text-white', 'border-white/20', 'shadow-sm', 'backdrop-blur-md');
          tab.classList.add('border-transparent', 'text-white/55');
        }
      });

      tabContents.forEach((content) => {
        if (content.id === `tab-${target}`) {
          content.classList.remove('hidden');
        } else {
          content.classList.add('hidden');
        }
      });

      if (target === 'liked') {
        refreshLikedQuotes();
      }

      // Re-apply active search filter
      if (searchInput && searchInput.value.trim()) {
        filterItems(searchInput.value);
      } else {
        resetFilterVisibility();
      }

      // Reset scroll position
      const scrollArea = document.getElementById('explore-scroll-area');
      if (scrollArea) scrollArea.scrollTop = 0;
    }

    tabs.forEach((tab) => {
      tab.onclick = () => activateTab(tab.dataset.tab);
    });

    if (likedBrowseBtn) {
      likedBrowseBtn.onclick = () => activateTab('moods');
    }

    // ── Search & Filter ──
    function filterItems(query) {
      const q = query.toLowerCase().trim();
      let visibleCount = 0;

      if (searchClear) {
        if (q.length > 0) {
          searchClear.classList.remove('hidden');
          searchClear.classList.add('flex');
        } else {
          searchClear.classList.add('hidden');
          searchClear.classList.remove('flex');
        }
      }

      tabContents.forEach((tc) => {
        if (tc.classList.contains('hidden')) return;
        const items = tc.querySelectorAll('.explore-item');
        items.forEach((item) => {
          const text = (item.dataset.searchText || item.textContent || '').toLowerCase();
          const match = !q || text.includes(q);
          item.style.display = match ? '' : 'none';
          if (match) visibleCount++;
        });
      });

      if (searchEmpty) {
        if (q && visibleCount === 0) {
          searchEmpty.classList.remove('hidden');
          searchEmpty.classList.add('flex');
        } else {
          searchEmpty.classList.add('hidden');
          searchEmpty.classList.remove('flex');
        }
      }
    }

    function resetFilterVisibility() {
      tabContents.forEach((tc) => {
        const items = tc.querySelectorAll('.explore-item');
        items.forEach((item) => {
          item.style.display = '';
        });
      });
      if (searchEmpty) {
        searchEmpty.classList.add('hidden');
        searchEmpty.classList.remove('flex');
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => filterItems(e.target.value));
    }

    if (searchClear) {
      searchClear.onclick = () => {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        filterItems('');
      };
    }

    if (resetSearchBtn) {
      resetSearchBtn.onclick = () => {
        if (searchInput) {
          searchInput.value = '';
        }
        filterItems('');
      };
    }

    // ── Open / Close Mechanics ──
    function openDrawer(tabToOpen = 'liked') {
      if (!drawer) return;
      drawer.classList.remove('hidden');
      drawer.style.display = 'flex'; // Uses flexbox to perfectly center sheet on all viewports

      // Always update likes whenever opening
      refreshLikedQuotes();

      // If user has > 0 likes, default to Liked tab; otherwise default to Moods tab
      const hasLikes = window.likedQuotes && window.likedQuotes.getAll().length > 0;
      activateTab(hasLikes ? tabToOpen : 'moods');

      if (searchInput) {
        searchInput.value = '';
        filterItems('');
      }
    }

    function closeDrawer() {
      if (!drawer) return;
      if (sheet) {
        sheet.style.animation = 'slide-down-sheet 0.25s cubic-bezier(0.4, 0, 0.2, 1) forwards';
        setTimeout(() => {
          drawer.style.display = 'none';
          drawer.classList.add('hidden');
          sheet.style.animation = '';
        }, 240);
      } else {
        drawer.style.display = 'none';
        drawer.classList.add('hidden');
      }
    }

    if (backdrop) backdrop.onclick = closeDrawer;
    if (closeBtn) closeBtn.onclick = closeDrawer;

    // Keyboard ESC to close drawer
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer && drawer.style.display === 'flex') {
        closeDrawer();
      }
    });

    // Swipe down to dismiss on mobile drag handle
    let touchStartY = 0;
    let touchDiffY = 0;

    if (dragHandle && sheet) {
      dragHandle.addEventListener(
        'touchstart',
        (e) => {
          touchStartY = e.touches[0].clientY;
          touchDiffY = 0;
        },
        { passive: true }
      );

      dragHandle.addEventListener(
        'touchmove',
        (e) => {
          touchDiffY = e.touches[0].clientY - touchStartY;
          if (touchDiffY > 0) {
            sheet.style.transform = `translateY(${touchDiffY}px)`;
          }
        },
        { passive: true }
      );

      dragHandle.addEventListener('touchend', () => {
        if (touchDiffY > 120) {
          closeDrawer();
        } else {
          sheet.style.transition = 'transform 0.2s ease-out';
          sheet.style.transform = '';
          setTimeout(() => {
            sheet.style.transition = '';
          }, 200);
        }
      });
    }

    // ── Rituals & Notification Controller ──
    function initRitualsUI() {
      const morningToggle = document.getElementById('ritual-morning-toggle');
      const morningTime = document.getElementById('ritual-morning-time');
      const eveningToggle = document.getElementById('ritual-evening-toggle');
      const eveningTime = document.getElementById('ritual-evening-time');
      const zenToggle = document.getElementById('ritual-zen-toggle');
      const zenInterval = document.getElementById('ritual-zen-interval');
      const testBtn = document.getElementById('ritual-test-btn');
      const statusMsg = document.getElementById('ritual-status-msg');

      function loadSettings() {
        try {
          const raw = localStorage.getItem('wisdom_ritual_settings');
          return raw ? JSON.parse(raw) : {
            morning: false,
            morningTime: '08:00',
            evening: false,
            eveningTime: '21:00',
            zenBell: false,
            zenIntervalMinutes: 10
          };
        } catch {
          return { morning: false, morningTime: '08:00', evening: false, eveningTime: '21:00', zenBell: false, zenIntervalMinutes: 10 };
        }
      }

      function syncUI() {
        const s = loadSettings();
        if (morningToggle) morningToggle.checked = !!s.morning;
        if (morningTime) morningTime.value = s.morningTime || '08:00';
        if (eveningToggle) eveningToggle.checked = !!s.evening;
        if (eveningTime) eveningTime.value = s.eveningTime || '21:00';
        if (zenToggle) zenToggle.checked = !!s.zenBell;
        if (zenInterval) zenInterval.value = String(s.zenIntervalMinutes || 10);
      }

      function saveAndNotify() {
        const s = {
          morning: morningToggle ? morningToggle.checked : false,
          morningTime: morningTime ? morningTime.value : '08:00',
          evening: eveningToggle ? eveningToggle.checked : false,
          eveningTime: eveningTime ? eveningTime.value : '21:00',
          zenBell: zenToggle ? zenToggle.checked : false,
          zenIntervalMinutes: zenInterval ? parseInt(zenInterval.value, 10) : 10
        };
        localStorage.setItem('wisdom_ritual_settings', JSON.stringify(s));
        window.dispatchEvent(new CustomEvent('wisdom:ritual-settings-changed', { detail: s }));
      }

      async function handlePermissionCheck(targetToggle) {
        if (!('Notification' in window)) {
          alert('Notifications are not supported by this browser.');
          if (targetToggle) targetToggle.checked = false;
          return false;
        }
        if (Notification.permission === 'granted') {
          return true;
        }
        if (Notification.permission === 'denied') {
          if (statusMsg) {
            statusMsg.textContent = 'Notifications are blocked in browser settings.';
            statusMsg.classList.remove('hidden', 'text-emerald-400');
            statusMsg.classList.add('text-amber-300');
          }
          if (targetToggle) targetToggle.checked = false;
          return false;
        }
        const perm = await Notification.requestPermission();
        if (perm !== 'granted') {
          if (targetToggle) targetToggle.checked = false;
          return false;
        }
        return true;
      }

      if (morningToggle) {
        morningToggle.onchange = async () => {
          if (morningToggle.checked) {
            const ok = await handlePermissionCheck(morningToggle);
            if (!ok) return;
          }
          saveAndNotify();
        };
      }
      if (morningTime) morningTime.onchange = saveAndNotify;

      if (eveningToggle) {
        eveningToggle.onchange = async () => {
          if (eveningToggle.checked) {
            const ok = await handlePermissionCheck(eveningToggle);
            if (!ok) return;
          }
          saveAndNotify();
        };
      }
      if (eveningTime) eveningTime.onchange = saveAndNotify;

      if (zenToggle) zenToggle.onchange = saveAndNotify;
      if (zenInterval) zenInterval.onchange = saveAndNotify;

      if (testBtn) {
        testBtn.onclick = async () => {
          const ok = await handlePermissionCheck();
          if (!ok) return;

          try {
            const base = window.__wisdomBaseUrl || '/wisdom';
            const res = await fetch(`${base}/daily-quotes.json`);
            const quotes = await res.json();
            const quote = quotes[Math.floor(Math.random() * quotes.length)] || {
              author: 'Marcus Aurelius',
              content: 'When you arise in the morning think of what a privilege it is to be alive.',
              slug: 'when-you-arise'
            };

            const title = `Daily Reflection — ${quote.author}`;
            const options = {
              body: `“${quote.content}”`,
              icon: `${base}/icons/icon-192.png`,
              badge: `${base}/icons/favicon-64.png`,
              tag: 'wisdom-test-reflection',
              data: {
                url: `${base}/#${quote.slug}`,
                quoteSlug: quote.slug,
                quoteId: quote.id
              }
            };

            if ('serviceWorker' in navigator) {
              const reg = await navigator.serviceWorker.ready;
              if (reg && 'showNotification' in reg) {
                await reg.showNotification(title, options);
              } else {
                const notif = new Notification(title, options);
                notif.onclick = function() {
                  window.focus();
                  if (window.location) window.location.href = options.data.url;
                };
              }
            } else {
              const notif = new Notification(title, options);
              notif.onclick = function() {
                window.focus();
                if (window.location) window.location.href = options.data.url;
              };
            }

            if (statusMsg) {
              statusMsg.textContent = 'Reflection delivered to notification tray!';
              statusMsg.classList.remove('hidden', 'text-amber-300');
              statusMsg.classList.add('text-emerald-400');
              setTimeout(() => statusMsg.classList.add('hidden'), 4000);
            }
          } catch (e) {
            console.error('Test notification failed:', e);
          }
        };
      }

      syncUI();
    }

    initRitualsUI();

    // Global hook so RightActionRail or other triggers can open drawer directly to any tab
    window.openExploreDrawer = openDrawer;
    window.refreshExploreLikes = refreshLikedQuotes;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupExploreDrawer);
  } else {
    setupExploreDrawer();
  }
  document.addEventListener('astro:page-load', setupExploreDrawer);
</script>

