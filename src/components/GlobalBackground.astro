---
/**
 * GlobalBackground — Atmospheric Canvas Architecture.
 *
 * Combines:
 * 1. Living Fluid Gradient Mesh: Smooth, morphing multi-stop radial gradient pools
 *    that breathe and drift continuously with organic fluidity.
 * 2. Pure Elegant Line Art: Sacred geometry, celestial astrolabes, topographic
 *    contour waves, harmonic Lissajous orbits, and gossamer constellation lattices.
 * 3. Distraction-Free: Zero harsh white star dots or flashing particle sparks,
 *    ensuring text readability and pure aesthetic serenity.
 */
---
<div
  data-astro-transition-persist="global-bg"
  id="global-bg"
  class="fixed inset-0 z-0 overflow-hidden pointer-events-none select-none"
>
  <!-- Dynamic Generative Visual Canvas -->
  <canvas id="ambient-canvas" class="absolute inset-0 w-full h-full"></canvas>

  <!-- Atmospheric Light Bloom Overlays -->
  <div
    id="mood-glow-1"
    class="absolute -top-[15%] -left-[10%] w-[75vw] h-[75vw] rounded-full blur-[130px] opacity-45 transition-colors duration-1000 ease-out pointer-events-none"
  ></div>
  <div
    id="mood-glow-2"
    class="absolute -bottom-[15%] -right-[10%] w-[80vw] h-[80vw] rounded-full blur-[140px] opacity-40 transition-colors duration-1000 ease-out pointer-events-none"
  ></div>
  <div
    id="mood-glow-center"
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vw] rounded-full blur-[160px] opacity-25 transition-colors duration-1000 ease-out pointer-events-none"
  ></div>

  <!-- Cinematic Vignette Overlay (Guarantees Quote Legibility) -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/70 pointer-events-none"></div>
</div>

<script>
  (function() {
    const canvas = document.getElementById('ambient-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animId: number | null = null;
    let isVisible = true;
    let time = 0;

    // ── 10 Rich, Aesthetic Color Palettes ──
    const PALETTES = [
      {
        name: 'Midnight Aurora',
        bgTop: [10, 8, 32],
        bgMid: [14, 30, 48],
        bgBottom: [5, 14, 24],
        glow1: 'rgba(0, 245, 212, 0.45)',   // Electric Turquoise
        glow2: 'rgba(123, 44, 191, 0.45)',  // Rich Violet
        glowCenter: 'rgba(0, 187, 249, 0.25)',
        colors: [[0, 245, 212], [155, 93, 229], [0, 187, 249], [254, 228, 64]],
      },
      {
        name: 'Sunset Mirage',
        bgTop: [34, 10, 26],
        bgMid: [52, 18, 22],
        bgBottom: [18, 6, 14],
        glow1: 'rgba(255, 112, 166, 0.48)', // Rose Gold
        glow2: 'rgba(255, 158, 0, 0.42)',   // Warm Saffron
        glowCenter: 'rgba(239, 71, 111, 0.25)',
        colors: [[255, 112, 166], [255, 158, 0], [239, 71, 111], [255, 209, 102]],
      },
      {
        name: 'Cosmic Ultraviolet',
        bgTop: [16, 5, 32],
        bgMid: [32, 10, 56],
        bgBottom: [8, 3, 18],
        glow1: 'rgba(181, 23, 158, 0.48)',  // Vivid Magenta
        glow2: 'rgba(76, 201, 240, 0.42)',  // Neon Blue
        glowCenter: 'rgba(114, 9, 183, 0.3)',
        colors: [[181, 23, 158], [114, 9, 183], [76, 201, 240], [247, 37, 133]],
      },
      {
        name: 'Bioluminescent Lagoon',
        bgTop: [4, 20, 32],
        bgMid: [8, 36, 52],
        bgBottom: [3, 14, 24],
        glow1: 'rgba(6, 214, 160, 0.45)',   // Mint Jade
        glow2: 'rgba(17, 138, 178, 0.48)',  // Deep Abyss Blue
        glowCenter: 'rgba(112, 224, 239, 0.25)',
        colors: [[6, 214, 160], [112, 224, 239], [17, 138, 178], [207, 250, 254]],
      },
      {
        name: 'Golden Radiance',
        bgTop: [28, 18, 6],
        bgMid: [46, 30, 10],
        bgBottom: [16, 10, 4],
        glow1: 'rgba(245, 158, 11, 0.48)',  // Amber
        glow2: 'rgba(234, 179, 8, 0.42)',   // Goldenrod
        glowCenter: 'rgba(251, 191, 36, 0.28)',
        colors: [[254, 240, 138], [251, 191, 36], [245, 158, 11], [251, 146, 60]],
      },
      {
        name: 'Ethereal Lavender Dream',
        bgTop: [20, 12, 38],
        bgMid: [34, 20, 54],
        bgBottom: [12, 8, 24],
        glow1: 'rgba(167, 139, 250, 0.48)', // Lilac
        glow2: 'rgba(244, 114, 182, 0.42)', // Pink Quartz
        glowCenter: 'rgba(192, 132, 252, 0.25)',
        colors: [[167, 139, 250], [216, 180, 254], [244, 114, 182], [192, 132, 252]],
      },
      {
        name: 'Emerald Enchantment',
        bgTop: [6, 26, 18],
        bgMid: [10, 44, 30],
        bgBottom: [4, 18, 12],
        glow1: 'rgba(16, 185, 129, 0.48)',  // Emerald
        glow2: 'rgba(52, 211, 153, 0.42)',  // Mint
        glowCenter: 'rgba(110, 231, 183, 0.25)',
        colors: [[16, 185, 129], [110, 231, 183], [52, 211, 153], [253, 224, 71]],
      },
      {
        name: 'Crimson Nebula',
        bgTop: [34, 6, 12],
        bgMid: [54, 12, 18],
        bgBottom: [18, 4, 8],
        glow1: 'rgba(239, 68, 68, 0.48)',   // Fiery Crimson
        glow2: 'rgba(236, 72, 153, 0.42)',  // Fuchsia
        glowCenter: 'rgba(244, 63, 94, 0.28)',
        colors: [[239, 68, 68], [244, 63, 94], [236, 72, 153], [251, 113, 133]],
      },
      {
        name: 'Deep Cobalt Cosmos',
        bgTop: [6, 14, 36],
        bgMid: [10, 24, 56],
        bgBottom: [4, 8, 20],
        glow1: 'rgba(59, 130, 246, 0.48)',  // Royal Sapphire
        glow2: 'rgba(99, 102, 241, 0.42)',  // Indigo
        glowCenter: 'rgba(147, 197, 253, 0.25)',
        colors: [[59, 130, 246], [99, 102, 241], [147, 197, 253], [129, 140, 248]],
      },
      {
        name: 'Velvet Rose Gold',
        bgTop: [32, 10, 22],
        bgMid: [50, 18, 36],
        bgBottom: [18, 5, 14],
        glow1: 'rgba(244, 63, 94, 0.48)',   // Rose Red
        glow2: 'rgba(251, 146, 60, 0.42)',  // Peach Gold
        glowCenter: 'rgba(253, 164, 175, 0.28)',
        colors: [[244, 63, 94], [251, 146, 60], [253, 164, 175], [251, 191, 36]],
      }
    ];

    // 5 Pure Elegant Line Art Animation Engines
    const ANIM_TYPES = [
      'sacred_mandala',
      'contour_waves',
      'constellation_lattice',
      'lissajous_orbit',
      'celestial_armillary'
    ];

    function djb2(str: string) {
      let hash = 5381;
      for (let i = 0; i < str.length; i++) {
        hash = ((hash << 5) + hash + str.charCodeAt(i)) >>> 0;
      }
      return hash;
    }

    let currentPalette = PALETTES[0];
    let currentAnim = 'sacred_mandala';
    let currentTop = [...currentPalette.bgTop];
    let currentBottom = [...currentPalette.bgBottom];

    // Node lattice for geometric line webs (no star dots drawn at vertices)
    interface Node {
      x: number;
      y: number;
      vx: number;
      vy: number;
      phase: number;
    }
    let nodes: Node[] = [];

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.scale(dpr, dpr);
      initNodes();
    }

    function lerp(a: number, b: number, t: number) {
      return a + (b - a) * t;
    }

    function initNodes() {
      nodes = [];
      const count = 42;
      for (let i = 0; i < count; i++) {
        nodes.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.45,
          vy: (Math.random() - 0.5) * 0.45,
          phase: Math.random() * Math.PI * 2,
        });
      }
    }

    // ── Helper: Create a smooth multi-stop linear gradient across line art ──
    function createStrokeGradient(x1: number, y1: number, x2: number, y2: number, alpha = 0.22) {
      const g = ctx.createLinearGradient(x1, y1, x2, y2);
      const c1 = currentPalette.colors[0];
      const c2 = currentPalette.colors[1] || currentPalette.colors[0];
      const c3 = currentPalette.colors[2] || currentPalette.colors[0];

      g.addColorStop(0, `rgba(${c1[0]}, ${c1[1]}, ${c1[2]}, ${alpha * 0.7})`);
      g.addColorStop(0.5, `rgba(${c2[0]}, ${c2[1]}, ${c2[2]}, ${alpha})`);
      g.addColorStop(1, `rgba(${c3[0]}, ${c3[1]}, ${c3[2]}, ${alpha * 0.7})`);
      return g;
    }

    // ── Engine 1: Sacred Geometry & Astrolabe Mandala Line Art ──
    function drawSacredMandala() {
      ctx.save();
      const cx = width * 0.5;
      const cy = height * 0.5;
      const baseR = Math.min(width, height) * 0.36;

      ctx.lineWidth = 1.1;

      // Outer astrolabe coordinate ring with subtle breathing
      const breath = Math.sin(time * 0.4) * 14;
      const rOuter = baseR + breath;
      ctx.strokeStyle = createStrokeGradient(cx - rOuter, cy, cx + rOuter, cy, 0.18);
      ctx.beginPath();
      ctx.arc(cx, cy, rOuter, 0, Math.PI * 2);
      ctx.stroke();

      // Degree tick lines along outer perimeter
      const ticks = 36;
      ctx.lineWidth = 0.8;
      for (let i = 0; i < ticks; i++) {
        const theta = (Math.PI * 2 / ticks) * i + time * 0.04;
        const innerLen = (i % 3 === 0) ? 14 : 7;
        const x1 = cx + Math.cos(theta) * (rOuter - innerLen);
        const y1 = cy + Math.sin(theta) * (rOuter - innerLen);
        const x2 = cx + Math.cos(theta) * rOuter;
        const y2 = cy + Math.sin(theta) * rOuter;
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
      }

      // Intersecting Flower of Life circular arcs
      ctx.lineWidth = 0.9;
      const petalR = baseR * 0.55;
      for (let i = 0; i < 6; i++) {
        const theta = (Math.PI * 2 / 6) * i - time * 0.06;
        const ox = cx + Math.cos(theta) * petalR;
        const oy = cy + Math.sin(theta) * petalR;
        ctx.strokeStyle = createStrokeGradient(ox - petalR, oy, ox + petalR, oy, 0.14);
        ctx.beginPath();
        ctx.arc(ox, oy, petalR, 0, Math.PI * 2);
        ctx.stroke();
      }

      // Rotating inner concentric polygon wireframes
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(time * 0.05);

      // Rotating 12-point star/polygon
      ctx.beginPath();
      const points = 12;
      for (let i = 0; i <= points; i++) {
        const theta = (Math.PI * 2 / points) * i;
        const r = (i % 2 === 0) ? baseR * 0.75 : baseR * 0.42;
        const px = Math.cos(theta) * r;
        const py = Math.sin(theta) * r;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.strokeStyle = createStrokeGradient(-baseR, -baseR, baseR, baseR, 0.16);
      ctx.stroke();

      // Counter-rotating nested square
      ctx.rotate(-time * 0.1);
      const sq = baseR * 0.38;
      ctx.beginPath();
      ctx.rect(-sq, -sq, sq * 2, sq * 2);
      ctx.strokeStyle = createStrokeGradient(-sq, -sq, sq, sq, 0.14);
      ctx.stroke();

      ctx.restore();
      ctx.restore();
    }

    // ── Engine 2: Flowing Topographic Contour Lines ──
    function drawContourWaves() {
      ctx.save();
      const waveCount = 7;
      ctx.lineWidth = 1.0;

      for (let j = 0; j < waveCount; j++) {
        const progress = j / (waveCount - 1);
        const yBase = height * (0.2 + progress * 0.6);
        const grad = createStrokeGradient(0, yBase - 50, width, yBase + 50, 0.16 + (j % 2) * 0.06);
        ctx.strokeStyle = grad;

        ctx.beginPath();
        const step = 25;
        let first = true;

        for (let x = 0; x <= width + step; x += step) {
          const w1 = Math.sin(x * 0.0025 + time * 0.5 + j * 1.2) * 45;
          const w2 = Math.cos(x * 0.005 - time * 0.35 + j * 0.8) * 28;
          const w3 = Math.sin(x * 0.0012 + time * 0.2) * 55;
          const y = yBase + w1 + w2 + w3;

          if (first) {
            ctx.moveTo(x, y);
            first = false;
          } else {
            ctx.lineTo(x, y);
          }
        }
        ctx.stroke();
      }
      ctx.restore();
    }

    // ── Engine 3: Pure Gossamer Geometric Constellation Lattice (No Star Dots) ──
    function drawConstellationLattice() {
      ctx.save();
      const maxDist = 135;
      ctx.lineWidth = 0.85;

      // Update node physics smoothly
      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > width) n.vx *= -1;
        if (n.y < 0 || n.y > height) n.vy *= -1;
      }

      // Draw connecting geometric lines only (zero vertex dots)
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < maxDist) {
            const alpha = (1 - dist / maxDist) * 0.22;
            ctx.strokeStyle = createStrokeGradient(nodes[i].x, nodes[i].y, nodes[j].x, nodes[j].y, alpha);
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      }
      ctx.restore();
    }

    // ── Engine 4: Harmonic Lissajous Spirograph Orbit Line Art ──
    function drawLissajousOrbit() {
      ctx.save();
      const cx = width * 0.5;
      const cy = height * 0.5;
      const a = Math.min(width, height) * 0.38;
      const b = Math.min(width, height) * 0.32;

      ctx.lineWidth = 1.0;
      ctx.strokeStyle = createStrokeGradient(cx - a, cy - b, cx + a, cy + b, 0.18);

      const segments = 220;
      const delta = (Math.PI * 2) / segments;

      // Lissajous Knot (3:4 ratio with gentle phase precession)
      ctx.beginPath();
      for (let i = 0; i <= segments; i++) {
        const t = i * delta;
        const x = cx + Math.sin(3 * t + time * 0.2) * a;
        const y = cy + Math.cos(4 * t + time * 0.15) * b;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();

      // Outer harmonic orbital ellipse
      ctx.beginPath();
      for (let i = 0; i <= segments; i++) {
        const t = i * delta;
        const x = cx + Math.sin(5 * t - time * 0.1) * (a * 0.65);
        const y = cy + Math.sin(6 * t + time * 0.25) * (b * 0.65);
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = createStrokeGradient(cx - a * 0.7, cy, cx + a * 0.7, cy, 0.14);
      ctx.stroke();

      ctx.restore();
    }

    // ── Engine 5: Celestial Armillary 3D Wireframe Line Art ──
    function drawCelestialArmillary() {
      ctx.save();
      const cx = width * 0.5;
      const cy = height * 0.5;
      const r = Math.min(width, height) * 0.34;
      const rotY = time * 0.12;
      const rotX = Math.PI / 6;

      ctx.lineWidth = 1.0;

      // Draw latitude rings in 3D projection
      const latSteps = 5;
      for (let i = -latSteps; i <= latSteps; i++) {
        const lat = (Math.PI / 2) * (i / (latSteps + 1));
        const rLat = r * Math.cos(lat);
        const yLat = r * Math.sin(lat);

        ctx.beginPath();
        const steps = 60;
        for (let j = 0; j <= steps; j++) {
          const lon = (Math.PI * 2 / steps) * j + rotY;
          const x3d = rLat * Math.sin(lon);
          const z3d = rLat * Math.cos(lon);

          // Rotate around X
          const yProj = yLat * Math.cos(rotX) - z3d * Math.sin(rotX);
          const xProj = x3d;

          const px = cx + xProj;
          const py = cy + yProj;
          if (j === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }
        ctx.strokeStyle = createStrokeGradient(cx - rLat, cy, cx + rLat, cy, 0.12 + Math.cos(lat) * 0.08);
        ctx.stroke();
      }

      // Draw meridian circles (longitudes)
      const lonSteps = 4;
      for (let k = 0; k < lonSteps; k++) {
        const baseLon = (Math.PI / lonSteps) * k + rotY;
        ctx.beginPath();
        const steps = 60;
        for (let j = 0; j <= steps; j++) {
          const theta = (Math.PI * 2 / steps) * j;
          const x3d = r * Math.sin(theta) * Math.sin(baseLon);
          const y3d = r * Math.cos(theta);
          const z3d = r * Math.sin(theta) * Math.cos(baseLon);

          const yProj = y3d * Math.cos(rotX) - z3d * Math.sin(rotX);
          const xProj = x3d;

          const px = cx + xProj;
          const py = cy + yProj;
          if (j === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }
        ctx.strokeStyle = createStrokeGradient(cx - r, cy, cx + r, cy, 0.14);
        ctx.stroke();
      }

      ctx.restore();
    }

    // ── Living Liquid Gradient Mesh: Smooth Morphing Fluid Color Pools ──
    function drawLivingGradientMesh() {
      // Smooth background color interpolation (lerp 3% per frame)
      currentTop[0] = lerp(currentTop[0], currentPalette.bgTop[0], 0.03);
      currentTop[1] = lerp(currentTop[1], currentPalette.bgTop[1], 0.03);
      currentTop[2] = lerp(currentTop[2], currentPalette.bgTop[2], 0.03);

      currentBottom[0] = lerp(currentBottom[0], currentPalette.bgBottom[0], 0.03);
      currentBottom[1] = lerp(currentBottom[1], currentPalette.bgBottom[1], 0.03);
      currentBottom[2] = lerp(currentBottom[2], currentPalette.bgBottom[2], 0.03);

      // Deep foundation gradient
      const baseGrad = ctx.createLinearGradient(0, 0, width * 0.3, height);
      baseGrad.addColorStop(0, `rgb(${Math.round(currentTop[0])}, ${Math.round(currentTop[1])}, ${Math.round(currentTop[2])})`);
      baseGrad.addColorStop(1, `rgb(${Math.round(currentBottom[0])}, ${Math.round(currentBottom[1])}, ${Math.round(currentBottom[2])})`);
      ctx.fillStyle = baseGrad;
      ctx.fillRect(0, 0, width, height);

      // Living organic radial gradient pool 1 (drifting upper quadrant)
      const x1 = width * (0.35 + 0.22 * Math.sin(time * 0.35));
      const y1 = height * (0.3 + 0.18 * Math.cos(time * 0.3));
      const r1 = Math.max(width, height) * 0.55;
      const c1 = currentPalette.colors[0];
      const g1 = ctx.createRadialGradient(x1, y1, 0, x1, y1, r1);
      g1.addColorStop(0, `rgba(${c1[0]}, ${c1[1]}, ${c1[2]}, 0.28)`);
      g1.addColorStop(0.5, `rgba(${c1[0]}, ${c1[1]}, ${c1[2]}, 0.08)`);
      g1.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = g1;
      ctx.fillRect(0, 0, width, height);

      // Living organic radial gradient pool 2 (drifting lower quadrant)
      const x2 = width * (0.65 + 0.2 * Math.cos(time * 0.4));
      const y2 = height * (0.7 + 0.18 * Math.sin(time * 0.32));
      const r2 = Math.max(width, height) * 0.58;
      const c2 = currentPalette.colors[1] || c1;
      const g2 = ctx.createRadialGradient(x2, y2, 0, x2, y2, r2);
      g2.addColorStop(0, `rgba(${c2[0]}, ${c2[1]}, ${c2[2]}, 0.24)`);
      g2.addColorStop(0.5, `rgba(${c2[0]}, ${c2[1]}, ${c2[2]}, 0.07)`);
      g2.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = g2;
      ctx.fillRect(0, 0, width, height);

      // Living organic radial gradient pool 3 (center subtle shimmer)
      const x3 = width * (0.5 + 0.15 * Math.sin(time * 0.25));
      const y3 = height * (0.5 + 0.12 * Math.cos(time * 0.28));
      const r3 = Math.max(width, height) * 0.45;
      const c3 = currentPalette.colors[2] || c1;
      const g3 = ctx.createRadialGradient(x3, y3, 0, x3, y3, r3);
      g3.addColorStop(0, `rgba(${c3[0]}, ${c3[1]}, ${c3[2]}, 0.16)`);
      g3.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = g3;
      ctx.fillRect(0, 0, width, height);
    }

    // ── Main Render Loop (60fps Hardware Accelerated) ──
    function draw() {
      if (!isVisible) return;
      time += 0.016;

      // 1. Render Living Liquid Gradient Mesh
      drawLivingGradientMesh();

      // 2. Render Pure Elegant Line Art (Zero Star Dots)
      if (currentAnim === 'sacred_mandala') {
        drawSacredMandala();
      } else if (currentAnim === 'contour_waves') {
        drawContourWaves();
      } else if (currentAnim === 'constellation_lattice') {
        drawConstellationLattice();
      } else if (currentAnim === 'lissajous_orbit') {
        drawLissajousOrbit();
      } else if (currentAnim === 'celestial_armillary') {
        drawCelestialArmillary();
      }

      animId = requestAnimationFrame(draw);
    }

    // Public Controller: called on slide arrival
    (window as any).setBackground = function(videoSrc: string, gradientClass: string, mood: string, quoteId: string) {
      // Deterministically select unique palette and line art engine for this quote
      const key = quoteId || mood || 'wisdom';
      const hash = djb2(key);

      currentPalette = PALETTES[hash % PALETTES.length];
      currentAnim = ANIM_TYPES[hash % ANIM_TYPES.length];

      // Update ambient glow overlay CSS
      const g1 = document.getElementById('mood-glow-1');
      const g2 = document.getElementById('mood-glow-2');
      const gc = document.getElementById('mood-glow-center');
      if (g1) g1.style.background = currentPalette.glow1;
      if (g2) g2.style.background = currentPalette.glow2;
      if (gc) gc.style.background = currentPalette.glowCenter;
    };

    window.addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible && !animId) draw();
    });

    resize();
    draw();
  })();
</script>
