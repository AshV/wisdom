---
/**
 * GlobalBackground — Mood-Based Dynamic Generative Canvas Animation.
 *
 * Replaces heavy stock MP4 videos with an organic, 60fps hardware-accelerated
 * generative visual canvas tailored to each mood:
 * - Reflective: Ethereal celestial stardust & breathing nebula orbs
 * - Motivational: Radiant rising golden embers & solar dawn flares
 * - Serene: Calming ocean liquid ripples & drifting aquamarine bubbles
 * - Bold: Dynamic fiery crimson sparks & deep pulsing shockwaves
 * - Melancholic: Gentle falling luminous rain streaks & expanding ripples
 * - Joyful: Dancing vibrant fireflies with playful organic halos
 * - Philosophical: Deep-space celestial constellations with interconnected lines
 * - Romantic: Floating rose-gold bokeh & drifting petal-like orbs
 *
 * Persists across Astro ClientRouter transitions (transition:persist="global-bg").
 * Exposes window.setBackground(videoSrc, gradientClass, mood).
 */
---
<div id="global-bg" class="fixed inset-0 z-0 overflow-hidden pointer-events-none" transition:persist="global-bg">
  <!-- Dynamic Generative Canvas -->
  <canvas id="ambient-canvas" class="absolute inset-0 w-full h-full"></canvas>

  <!-- Atmospheric Light Bloom Overlays -->
  <div id="mood-glow-1" class="absolute -top-[20%] -left-[10%] w-[70vw] h-[70vw] rounded-full blur-[120px] opacity-40 transition-colors duration-1000 ease-out pointer-events-none"></div>
  <div id="mood-glow-2" class="absolute -bottom-[20%] -right-[10%] w-[75vw] h-[75vw] rounded-full blur-[140px] opacity-35 transition-colors duration-1000 ease-out pointer-events-none"></div>

  <!-- Cinematic Vignette & Deep Contrast Layer for Quote Legibility -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/70 pointer-events-none"></div>
</div>

<script is:inline>
  (function() {
    const canvas = document.getElementById('ambient-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animId = null;
    let isVisible = true;

    // Mood color schemes (RGB for smooth interpolation)
    const MOOD_THEMES = {
      reflective: {
        bgTop: [8, 7, 24],
        bgBottom: [18, 14, 45],
        glow1: 'rgba(99, 102, 241, 0.45)', // Indigo
        glow2: 'rgba(168, 85, 247, 0.35)', // Purple
        particleColors: [[165, 180, 252], [192, 132, 252], [224, 231, 255]],
        type: 'stardust',
        speed: 0.35,
        count: 55,
      },
      motivational: {
        bgTop: [26, 14, 4],
        bgBottom: [48, 24, 6],
        glow1: 'rgba(245, 158, 11, 0.45)', // Amber
        glow2: 'rgba(239, 68, 68, 0.35)',  // Red-orange
        particleColors: [[253, 230, 138], [251, 191, 36], [249, 115, 22]],
        type: 'embers',
        speed: 0.85,
        count: 65,
      },
      serene: {
        bgTop: [4, 20, 26],
        bgBottom: [8, 36, 46],
        glow1: 'rgba(6, 182, 212, 0.45)',  // Cyan
        glow2: 'rgba(16, 185, 129, 0.35)', // Emerald
        particleColors: [[165, 243, 252], [110, 231, 183], [207, 250, 254]],
        type: 'ripples',
        speed: 0.3,
        count: 45,
      },
      bold: {
        bgTop: [28, 6, 6],
        bgBottom: [52, 10, 10],
        glow1: 'rgba(239, 68, 68, 0.5)',   // Crimson
        glow2: 'rgba(185, 28, 28, 0.4)',   // Deep Ruby
        particleColors: [[254, 202, 202], [252, 165, 165], [248, 113, 113]],
        type: 'pulse',
        speed: 0.9,
        count: 60,
      },
      melancholic: {
        bgTop: [12, 10, 26],
        bgBottom: [22, 18, 48],
        glow1: 'rgba(139, 92, 246, 0.4)',  // Violet
        glow2: 'rgba(99, 102, 241, 0.3)',  // Soft indigo
        particleColors: [[216, 180, 254], [196, 181, 253], [165, 180, 252]],
        type: 'rain',
        speed: 1.2,
        count: 50,
      },
      joyful: {
        bgTop: [6, 26, 16],
        bgBottom: [10, 48, 28],
        glow1: 'rgba(16, 185, 129, 0.45)', // Emerald
        glow2: 'rgba(234, 179, 8, 0.35)',  // Warm Citrine
        particleColors: [[167, 243, 208], [253, 224, 71], [110, 231, 183]],
        type: 'fireflies',
        speed: 0.65,
        count: 60,
      },
      philosophical: {
        bgTop: [6, 10, 28],
        bgBottom: [14, 20, 52],
        glow1: 'rgba(59, 130, 246, 0.45)', // Cobalt
        glow2: 'rgba(147, 51, 234, 0.35)', // Deep Purple
        particleColors: [[191, 219, 254], [216, 180, 254], [255, 255, 255]],
        type: 'constellation',
        speed: 0.25,
        count: 50,
      },
      romantic: {
        bgTop: [28, 6, 18],
        bgBottom: [52, 12, 34],
        glow1: 'rgba(236, 72, 153, 0.45)', // Rose Pink
        glow2: 'rgba(244, 63, 94, 0.35)',  // Warm Coral
        particleColors: [[251, 207, 232], [254, 205, 211], [253, 164, 175]],
        type: 'petals',
        speed: 0.4,
        count: 50,
      },
    };

    let currentMood = 'reflective';
    let targetTheme = MOOD_THEMES.reflective;
    let currentTop = [...targetTheme.bgTop];
    let currentBottom = [...targetTheme.bgBottom];
    let particles = [];
    let ripples = [];

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.scale(dpr, dpr);
      initParticles();
    }

    function lerp(a, b, t) {
      return a + (b - a) * t;
    }

    function createParticle() {
      const colors = targetTheme.particleColors;
      const color = colors[Math.floor(Math.random() * colors.length)];
      return {
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * targetTheme.speed,
        vy: targetTheme.type === 'embers'
          ? -(Math.random() * 1.5 + 0.5) * targetTheme.speed
          : targetTheme.type === 'rain'
          ? (Math.random() * 2.5 + 1.5) * targetTheme.speed
          : (Math.random() - 0.5) * targetTheme.speed,
        radius: Math.random() * 2.8 + 1.2,
        baseRadius: Math.random() * 2.8 + 1.2,
        color: color,
        alpha: Math.random() * 0.6 + 0.2,
        pulseSpeed: Math.random() * 0.03 + 0.01,
        angle: Math.random() * Math.PI * 2,
        wobbleSpeed: Math.random() * 0.02 + 0.005,
      };
    }

    function initParticles() {
      particles = [];
      const count = targetTheme.count || 50;
      for (let i = 0; i < count; i++) {
        particles.push(createParticle());
      }
    }

    function updateParticles() {
      const type = targetTheme.type;

      particles.forEach((p, idx) => {
        p.angle += p.wobbleSpeed;

        if (type === 'embers') {
          // Ascending embers with gentle horizontal drift
          p.x += Math.sin(p.angle) * 0.6 + p.vx;
          p.y += p.vy;
          if (p.y < -10) {
            p.y = height + 10;
            p.x = Math.random() * width;
          }
        } else if (type === 'rain') {
          // Luminous soft rain with gentle angle
          p.x += p.vx * 0.5;
          p.y += p.vy;
          if (p.y > height) {
            // Chance to create ripple
            if (Math.random() < 0.25 && ripples.length < 8) {
              ripples.push({ x: p.x, y: height - Math.random() * 60, r: 2, maxR: Math.random() * 28 + 12, alpha: 0.45 });
            }
            p.y = -10;
            p.x = Math.random() * width;
          }
        } else if (type === 'petals') {
          // Floating romantic petals with organic sway
          p.x += Math.sin(p.angle) * 0.8 + p.vx * 0.4;
          p.y += Math.cos(p.angle * 0.7) * 0.3 - 0.35;
          if (p.y < -10) p.y = height + 10;
          if (p.x < -10) p.x = width + 10;
          if (p.x > width + 10) p.x = -10;
        } else if (type === 'fireflies') {
          // Playful organic Brownian motion
          p.vx += (Math.random() - 0.5) * 0.1;
          p.vy += (Math.random() - 0.5) * 0.1;
          p.vx = Math.max(-1.2, Math.min(1.2, p.vx));
          p.vy = Math.max(-1.2, Math.min(1.2, p.vy));
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0) p.x = width;
          if (p.x > width) p.x = 0;
          if (p.y < 0) p.y = height;
          if (p.y > height) p.y = 0;
        } else {
          // Default stardust / celestial constellation drift
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < -10) p.x = width + 10;
          if (p.x > width + 10) p.x = -10;
          if (p.y < -10) p.y = height + 10;
          if (p.y > height + 10) p.y = -10;
        }

        // Breathing glow pulse
        p.alpha = Math.sin(p.angle * 2) * 0.25 + 0.45;
      });

      // Update ripples
      for (let i = ripples.length - 1; i >= 0; i--) {
        const r = ripples[i];
        r.r += 0.6;
        r.alpha *= 0.95;
        if (r.r >= r.maxR || r.alpha < 0.01) {
          ripples.splice(i, 1);
        }
      }
    }

    function draw() {
      if (!isVisible) return;

      // Smooth background color interpolation (1.5% per frame)
      currentTop[0] = lerp(currentTop[0], targetTheme.bgTop[0], 0.025);
      currentTop[1] = lerp(currentTop[1], targetTheme.bgTop[1], 0.025);
      currentTop[2] = lerp(currentTop[2], targetTheme.bgTop[2], 0.025);

      currentBottom[0] = lerp(currentBottom[0], targetTheme.bgBottom[0], 0.025);
      currentBottom[1] = lerp(currentBottom[1], targetTheme.bgBottom[1], 0.025);
      currentBottom[2] = lerp(currentBottom[2], targetTheme.bgBottom[2], 0.025);

      // Render gradient background
      const grad = ctx.createLinearGradient(0, 0, width * 0.5, height);
      grad.addColorStop(0, `rgb(${Math.round(currentTop[0])}, ${Math.round(currentTop[1])}, ${Math.round(currentTop[2])})`);
      grad.addColorStop(1, `rgb(${Math.round(currentBottom[0])}, ${Math.round(currentBottom[1])}, ${Math.round(currentBottom[2])})`);
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, width, height);

      // Philosophical Constellation Web (draw connecting lines between nearby stars)
      if (targetTheme.type === 'constellation') {
        ctx.lineWidth = 0.6;
        const maxDist = 95;
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < maxDist) {
              const lineAlpha = (1 - dist / maxDist) * 0.18;
              ctx.strokeStyle = `rgba(165, 180, 252, ${lineAlpha})`;
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.stroke();
            }
          }
        }
      }

      // Draw expanding puddle ripples for melancholic rain
      if (ripples.length > 0) {
        ripples.forEach(r => {
          ctx.strokeStyle = `rgba(196, 181, 253, ${r.alpha})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.ellipse(r.x, r.y, r.r, r.r * 0.4, 0, 0, Math.PI * 2);
          ctx.stroke();
        });
      }

      // Draw particles with soft radiant glow
      particles.forEach(p => {
        const [r, g, b] = p.color;
        const rad = p.radius;

        // Radial glow halo
        const pGrad = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, rad * 2.5);
        pGrad.addColorStop(0, `rgba(${r}, ${g}, ${b}, ${p.alpha})`);
        pGrad.addColorStop(0.5, `rgba(${r}, ${g}, ${b}, ${p.alpha * 0.35})`);
        pGrad.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);

        ctx.fillStyle = pGrad;
        ctx.beginPath();
        ctx.arc(p.x, p.y, rad * 2.5, 0, Math.PI * 2);
        ctx.fill();

        // Bright particle core
        ctx.fillStyle = `rgba(255, 255, 255, ${Math.min(1, p.alpha * 1.3)})`;
        ctx.beginPath();
        ctx.arc(p.x, p.y, rad * 0.6, 0, Math.PI * 2);
        ctx.fill();
      });

      updateParticles();
      animId = requestAnimationFrame(draw);
    }

    // Window resize handler
    window.addEventListener('resize', resize);
    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible && !animId) {
        animId = requestAnimationFrame(draw);
      }
    });

    // Public controller called by ReelFeed on slide change
    window.setBackground = function(videoSrc, gradientClass, mood) {
      if (!mood || !MOOD_THEMES[mood]) mood = 'reflective';
      if (mood === currentMood) return;

      currentMood = mood;
      targetTheme = MOOD_THEMES[mood];

      // Update atmospheric glow blurs
      const glow1 = document.getElementById('mood-glow-1');
      const glow2 = document.getElementById('mood-glow-2');
      if (glow1) glow1.style.backgroundColor = targetTheme.glow1;
      if (glow2) glow2.style.backgroundColor = targetTheme.glow2;

      // Adapt existing particles smoothly to new mood colors
      const colors = targetTheme.particleColors;
      particles.forEach(p => {
        p.color = colors[Math.floor(Math.random() * colors.length)];
        if (targetTheme.type === 'embers') {
          p.vy = -(Math.random() * 1.5 + 0.5) * targetTheme.speed;
        } else if (targetTheme.type === 'rain') {
          p.vy = (Math.random() * 2.5 + 1.5) * targetTheme.speed;
        } else {
          p.vx = (Math.random() - 0.5) * targetTheme.speed;
          p.vy = (Math.random() - 0.5) * targetTheme.speed;
        }
      });
    };

    // Initial setup
    resize();
    animId = requestAnimationFrame(draw);

    // Set initial glow colors
    const glow1 = document.getElementById('mood-glow-1');
    const glow2 = document.getElementById('mood-glow-2');
    if (glow1) glow1.style.backgroundColor = targetTheme.glow1;
    if (glow2) glow2.style.backgroundColor = targetTheme.glow2;
  })();
</script>
