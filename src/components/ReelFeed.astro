---
/**
 * ReelFeed — Scroll-snap vertical reel container.
 *
 * Manages IntersectionObserver for:
 * - Background media switching
 * - URL hash updates
 * - Audio source switching
 * - Active slide tracking
 * - Double-tap like detection
 */
import ReelSlide from './ReelSlide.astro';
import RightActionRail from './RightActionRail.astro';
import ExploreDrawer from './ExploreDrawer.astro';
import ShareModal from './ShareModal.astro';
import AuthorDossierModal from './AuthorDossierModal.astro';
import { moodMeta } from '../data/mediaRegistry';

interface QuoteData {
  id: string;
  content: string;
  author: string;
  authorSlug: string;
  category: string;
  categorySlug: string;
  mood: 'reflective' | 'motivational' | 'serene' | 'bold' | 'melancholic' | 'joyful' | 'philosophical' | 'romantic';
  tags: string[];
}

interface Props {
  quotes: QuoteData[];
  feedTitle: string;
  feedType?: string;
  matchedCount?: number;
  filterLabel?: string;
}

const { quotes, feedTitle, feedType = 'master', matchedCount, filterLabel } = Astro.props;
const effectiveMatchedCount = matchedCount ?? (feedType === 'quote' ? 1 : (feedType === 'master' ? 0 : quotes.length));
const BASE = '/wisdom';
const firstQuote = quotes.length > 0 ? quotes[0] : null;
const firstMoodInfo = firstQuote ? moodMeta[firstQuote.mood] : null;

function getAuthorInitials(name: string): string {
  if (!name) return 'W';
  return name
    .split(' ')
    .map((part) => part[0])
    .filter(Boolean)
    .slice(0, 2)
    .join('')
    .toUpperCase();
}

const firstAuthorInitials = firstQuote ? getAuthorInitials(firstQuote.author) : 'W';
---

<!-- Feed Header (subtle overlay) -->
<header class="fixed top-0 left-0 right-0 z-20 pointer-events-none">
  <div class="flex items-center justify-between px-5 pt-[max(env(safe-area-inset-top),16px)] pb-3">
    <div class="w-24 flex justify-start pointer-events-auto">
      {feedType !== 'master' && (
        <a
          href="/wisdom/"
          class="glass rounded-full px-4 py-2 text-xs font-semibold text-white/80 hover:text-white flex items-center gap-1.5 transition-all duration-200 hover:scale-105 shadow-md shadow-black/20"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6" />
          </svg>
          Back
        </a>
      )}
    </div>
    <div class="text-center flex-1 mx-4 truncate">
      <h1
        id="feed-header-title"
        class="text-sm font-bold text-white/90 tracking-wide text-shadow-soft truncate transition-opacity duration-300"
      >
        {feedTitle}
      </h1>
    </div>
    <div class="w-24 flex justify-end">
      <span class="text-[11px] font-mono font-medium text-white/80 glass px-4 py-2 rounded-full flex items-center gap-1.5 shadow-sm leading-normal">
        {matchedCount && matchedCount < quotes.length ? (
          <>
            <span>{matchedCount}</span>
            <span class="text-white/30">&bull;</span>
            <span class="text-xs text-amber-300 font-sans">&infin;</span>
          </>
        ) : (
          <>
            <span>{quotes.length}</span>
            <span class="text-white/30">&bull;</span>
            <span class="text-xs text-amber-300 font-sans">&infin;</span>
          </>
        )}
      </span>
    </div>
  </div>
</header>

<!-- Scroll-Snap Reel Container (Infinite Never-Ending Stream) -->
<main
  id="reel-container"
  class="reel-container relative z-10 w-full h-[100dvh]"
  data-feed-type={feedType}
  data-matched-count={matchedCount}
>
  {quotes.map((q, i) => (
    <ReelSlide
      id={q.id}
      content={q.content}
      author={q.author}
      authorSlug={q.authorSlug}
      category={q.category}
      categorySlug={q.categorySlug}
      mood={q.mood}
      tags={q.tags}
      index={i}
      isStreamContinuation={Boolean(effectiveMatchedCount && i === effectiveMatchedCount)}
      isTopicMatch={Boolean(effectiveMatchedCount ? i < effectiveMatchedCount : true)}
    />
  ))}

  {quotes.length === 0 && (
    <div class="reel-slide flex flex-col items-center justify-center p-6 text-center">
      <p class="text-2xl text-white/70 font-light mb-4">No quotes found in this feed.</p>
      <a href="/wisdom/" class="glass px-6 py-3 rounded-full text-sm font-medium text-white hover:bg-white/10">Return to Master Feed</a>
    </div>
  )}
</main>

<!-- Right Action Rail -->
<RightActionRail />

<!-- Fixed Top Center Tags Dock (with 3D flip-in-place transition) -->
{firstQuote && (
  <nav
    id="fixed-tags-dock"
    class="fixed top-14 sm:top-16 left-0 right-0 z-20 pointer-events-none flex justify-center px-4"
    style="top: calc(max(env(safe-area-inset-top, 0px), 16px) + 48px);"
    aria-label="Quote Tags"
  >
    <div
      id="dock-tags-container"
      class="flex flex-wrap items-center justify-center gap-2 max-w-md sm:max-w-lg md:max-w-xl text-center pointer-events-none"
    >
      {firstQuote.tags.map((tag) => (
        <div class="flip-pill-wrapper inline-flex" data-dock-tag-wrapper>
          <a
            href={`${BASE}/tag/${encodeURIComponent(tag)}/`}
            class="pointer-events-auto text-xs font-medium text-white/80 hover:text-white transition-colors duration-200 bg-white/10 hover:bg-white/20 active:scale-95 px-4 py-2 rounded-full backdrop-blur-md border border-white/15 cursor-pointer shadow-md inline-flex items-center leading-normal dock-pill"
          >
            #{tag}
          </a>
        </div>
      ))}
    </div>
  </nav>
)}

<!-- Fixed Bottom Metadata Dock (About Author, Category & Mood with 3D flip-in-place transition) -->
{firstQuote && (
  <aside
    id="fixed-metadata-dock"
    class="fixed bottom-0 left-0 right-0 z-20 pointer-events-none mb-6 sm:mb-8 md:mb-10 pb-[max(env(safe-area-inset-bottom,28px),44px)] pt-2"
    style="padding-right: clamp(4.5rem, 12vw, 6.5rem); padding-left: clamp(1.25rem, 4vw, 2.5rem);"
    aria-label="Quote Metadata"
  >
    <div class="flex flex-col gap-2.5 w-full max-w-md md:max-w-lg">
      <!-- Row 1: About Author Pill (Always visible for current author, placed above mood and category pill) -->
      <div class="flex items-center">
        <div id="dock-author-wrapper" class="flip-pill-wrapper inline-flex">
          <a
            id="dock-author-pill"
            href={`${BASE}/author/${firstQuote.authorSlug}/?about=1`}
            data-author-slug={firstQuote.authorSlug}
            data-author-name={firstQuote.author}
            class="pointer-events-auto glass rounded-full px-4 py-2 text-xs font-medium text-amber-200/95 hover:text-white border border-amber-300/30 hover:border-amber-300/60 hover:bg-amber-400/15 transition-all duration-200 shadow-md inline-flex items-center gap-2 leading-normal dock-pill group active:scale-95 whitespace-nowrap cursor-pointer"
            aria-label={`About ${firstQuote.author}`}
            title={`About ${firstQuote.author}`}
          >
            <span
              id="dock-author-initial"
              class="w-4 h-4 rounded-full bg-amber-400/20 text-amber-300 text-[9px] font-serif font-bold flex items-center justify-center border border-amber-400/40 group-hover:scale-110 transition-transform"
            >
              {firstAuthorInitials}
            </span>
            <span class="text-white/80">About</span>
            <span id="dock-author-name" class="font-semibold text-amber-300">{firstQuote.author}</span>
          </a>
        </div>
      </div>

      <!-- Row 2: Category Pill + Mood Badge -->
      <div class="flex flex-wrap items-center gap-2.5">
        <div id="dock-category-wrapper" class="flip-pill-wrapper inline-flex">
          <a
            id="dock-category-pill"
            href={`${BASE}/category/${firstQuote.categorySlug}/`}
            class="pointer-events-auto glass rounded-full px-4.5 py-2 text-xs font-medium text-white/90 hover:text-white hover:bg-white/20 transition-all duration-200 shadow-sm whitespace-nowrap inline-flex items-center leading-normal dock-pill"
          >
            {firstQuote.category}
          </a>
        </div>

        <div id="dock-mood-wrapper" class="flip-pill-wrapper inline-flex">
          <a
            id="dock-mood-pill"
            href={`${BASE}/mood/${firstQuote.mood}/`}
            class={`pointer-events-auto mood-pill-${firstQuote.mood} rounded-full px-5 py-2 text-xs font-semibold text-white hover:scale-105 transition-all duration-200 shadow-md shadow-black/20 inline-flex items-center gap-2 whitespace-nowrap shrink-0 leading-normal dock-pill`}
          >
            <span id="dock-mood-emoji" class="shrink-0 text-sm leading-none">{firstMoodInfo?.emoji}</span>
            <span id="dock-mood-label" class="whitespace-nowrap tracking-wide leading-normal">{firstMoodInfo?.label}</span>
          </a>
        </div>
      </div>
    </div>
  </aside>
)}

<!-- Explore Drawer -->
<ExploreDrawer />

<!-- Share Modal -->
<ShareModal />

<!-- Author Dossier Modal -->
<AuthorDossierModal />

<script is:inline>
  function setupReelFeed() {
    const container = document.getElementById('reel-container');
    if (!container) return;

    let initialSlides = Array.from(container.querySelectorAll('.reel-slide'));
    if (initialSlides.length === 0) return;

    // Snapshot a clean slide as template for on-demand dynamic streaming
    const templateSlide = initialSlides[0].cloneNode(true);
    const initialContBanner = templateSlide.querySelector('.continuation-banner');
    if (initialContBanner) initialContBanner.remove();
    templateSlide.classList.remove('is-active');

    // ── Fisher-Yates shuffle helper ──
    function shuffleArray(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
      }
      return arr;
    }

    // ── Helper to record viewed quote ID in recentQuotes store ──
    function recordQuoteSeen(id) {
      if (!id) return;
      if (window.recentQuotes && typeof window.recentQuotes.add === 'function') {
        window.recentQuotes.add(id);
      }
    }

    // ── Mood Metadata & Video/Audio mappings for dynamic slides ──
    const moodMetaClient = {
      reflective: { label: 'Reflective', emoji: '🌙' },
      motivational: { label: 'Motivational', emoji: '🔥' },
      serene: { label: 'Serene', emoji: '🌊' },
      bold: { label: 'Bold', emoji: '⚡' },
      melancholic: { label: 'Melancholic', emoji: '🌧️' },
      joyful: { label: 'Joyful', emoji: '✨' },
      philosophical: { label: 'Philosophical', emoji: '🤔' },
      romantic: { label: 'Romantic', emoji: '💜' },
    };

    function djb2(str) {
      let hash = 5381;
      for (let i = 0; i < str.length; i++) {
        hash = ((hash << 5) + hash + str.charCodeAt(i)) >>> 0;
      }
      return hash;
    }

    const base = window.__wisdomBaseUrl || '/wisdom';

    function getMediaForClientQuote(id, mood) {
      return {
        gradient: `gradient-${mood}`,
        audio: `${base}/media/audio/chime-${mood}.wav`
      };
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // ── Factory to build full-fidelity slide DOM element from quote object ──
    function createSlideFromQuote(quote, templateElement, loopSuffix = '') {
      const clone = templateElement.cloneNode(true);
      const existingElem = document.getElementById(`slide-${quote.id}`);
      clone.id = (existingElem || loopSuffix) ? `slide-${quote.id}-${loopSuffix || 'dyn'}` : `slide-${quote.id}`;
      clone.classList.remove('is-active');

      const media = getMediaForClientQuote(quote.id, quote.mood);
      const moodInfo = moodMetaClient[quote.mood] || { label: quote.mood, emoji: '✨' };

      // Update data attributes
      clone.dataset.quoteId = quote.id;
      clone.dataset.quoteSlug = quote.slug;
      clone.dataset.content = quote.content;
      clone.dataset.author = quote.author;
      clone.dataset.authorSlug = quote.authorSlug;
      clone.dataset.videoSrc = media.video;
      clone.dataset.gradientClass = media.gradient;
      clone.dataset.mood = quote.mood;
      clone.dataset.moodLabel = moodInfo.label;
      clone.dataset.moodEmoji = moodInfo.emoji;
      clone.dataset.category = quote.category;
      clone.dataset.categorySlug = quote.categorySlug;
      clone.dataset.tags = JSON.stringify(quote.tags || []);
      clone.dataset.audioSrc = media.audio;
      clone.dataset.topicMatch = 'true';

      const srMeta = clone.querySelector('.sr-only');
      if (srMeta) {
        srMeta.innerHTML = `<span>Category: ${escapeHtml(quote.category)}</span><span>Mood: ${escapeHtml(moodInfo.label)}</span><span>Tags: ${(quote.tags || []).map(t => `#${escapeHtml(t)}`).join(' ')}</span>`;
      }

      // Remove continuation banner from cloned slides
      const banner = clone.querySelector('.continuation-banner');
      if (banner) banner.remove();

      // Double-tap zone
      const dtz = clone.querySelector('[data-doubletap-zone]');
      if (dtz) dtz.dataset.doubletapZone = quote.id;

      // Quote text & adaptive typography sizing
      const len = quote.content.length;
      let quoteSizeStyle = '';
      if (len < 55) {
        quoteSizeStyle = 'font-size: clamp(2.2rem, 5.5vw, 4.2rem); line-height: 1.18; max-width: 900px;';
      } else if (len < 110) {
        quoteSizeStyle = 'font-size: clamp(1.75rem, 4.2vw, 3.1rem); line-height: 1.25; max-width: 950px;';
      } else if (len < 180) {
        quoteSizeStyle = 'font-size: clamp(1.4rem, 3.2vw, 2.4rem); line-height: 1.32; max-width: 1000px;';
      } else {
        quoteSizeStyle = 'font-size: clamp(1.2rem, 2.6vw, 1.95rem); line-height: 1.38; max-width: 1050px;';
      }

      const quoteP = clone.querySelector('.quote-text');
      if (quoteP) {
        quoteP.textContent = quote.content;
        quoteP.style.cssText = `${quoteSizeStyle} font-family: 'Playfair Display', 'Cormorant Garamond', Georgia, serif;`;
      }

      // Author attribution
      const authorLink = clone.querySelector('a[href*="/author/"]');
      if (authorLink) {
        authorLink.href = `${base}/author/${quote.authorSlug}/`;
        authorLink.title = `More quotes by ${quote.author}`;
        const authorSpan = authorLink.querySelector('.author-name-text') || authorLink;
        authorSpan.textContent = quote.author;
      }

      // Category pill
      const categoryLink = clone.querySelector('a[href*="/category/"]');
      if (categoryLink) {
        categoryLink.className = 'pointer-events-auto glass rounded-full px-4.5 py-2 text-xs font-medium text-white/90 hover:text-white hover:bg-white/20 transition-all duration-200 shadow-sm whitespace-nowrap inline-flex items-center leading-normal';
        categoryLink.href = `${base}/category/${quote.categorySlug}/`;
        categoryLink.textContent = quote.category;
      }

      // Mood pill
      const moodLink = clone.querySelector('a[href*="/mood/"]');
      if (moodLink) {
        moodLink.className = `pointer-events-auto mood-pill-${quote.mood} rounded-full px-5 py-2 text-xs font-semibold text-white hover:scale-105 transition-all duration-200 shadow-md shadow-black/20 inline-flex items-center gap-2 whitespace-nowrap shrink-0 leading-normal`;
        moodLink.href = `${base}/mood/${quote.mood}/`;
        moodLink.innerHTML = `<span class="shrink-0 text-sm leading-none">${moodInfo.emoji}</span><span class="whitespace-nowrap tracking-wide leading-normal">${moodInfo.label}</span>`;
      }

      // Tag chips
      const tagContainer = clone.querySelector('[data-tags-container]') || clone.querySelector('.flex.flex-wrap');
      if (tagContainer) {
        tagContainer.innerHTML = (quote.tags || []).map(t =>
          `<a href="${base}/tag/${encodeURIComponent(t)}/" class="pointer-events-auto text-xs font-medium text-white/75 hover:text-white transition-colors duration-200 bg-white/10 hover:bg-white/20 active:scale-95 px-4 py-2 rounded-full backdrop-blur-sm border border-white/15 cursor-pointer shadow-sm inline-flex items-center leading-normal">#${escapeHtml(t)}</a>`
        ).join('');
      }

      return clone;
    }

    // ── Check for deep-link hash and feed configuration ──
    const rawHash = window.location.hash ? window.location.hash.slice(1) : null;
    let targetHash = rawHash ? decodeURIComponent(rawHash) : null;
    const feedType = container.dataset.feedType || 'master';
    const matchedCount = parseInt(container.dataset.matchedCount, 10) || 0;

    // Retrieve user's recently viewed quote IDs (up to 1000 seen quotes)
    const recentSeenList = (window.recentQuotes && typeof window.recentQuotes.getAll === 'function')
      ? window.recentQuotes.getAll()
      : [];
    const recentSeenSet = new Set(recentSeenList);

    // If master feed and targetHash represents a quote the user ALREADY visited,
    // it is a residual hash from an earlier session. Clear it so the user sees a fresh quote!
    if (feedType === 'master' && targetHash) {
      let isAlreadySeen = recentSeenSet.has(targetHash);
      if (!isAlreadySeen && window.__wisdomQuoteMap) {
        const matchingQuote = Object.values(window.__wisdomQuoteMap).find(q =>
          q.slug === targetHash || q.id === targetHash
        );
        if (matchingQuote && recentSeenSet.has(matchingQuote.id)) {
          isAlreadySeen = true;
        }
      }
      if (isAlreadySeen) {
        targetHash = null;
        try {
          history.replaceState(null, '', window.location.pathname);
        } catch {}
      }
    }

    // ── Intelligent Reordering & Shuffling with Visited Deduplication ──
    if (targetHash) {
      // Intentional deep link or notification target: find or create target slide
      let targetIdx = initialSlides.findIndex(s =>
        s.dataset.quoteSlug === targetHash ||
        s.id === `slide-${targetHash}` ||
        s.dataset.quoteId === targetHash
      );
      let targetSlide = null;
      if (targetIdx !== -1) {
        [targetSlide] = initialSlides.splice(targetIdx, 1);
      } else if (window.__wisdomQuoteMap) {
        const allQuotes = Object.values(window.__wisdomQuoteMap);
        const targetQuote = allQuotes.find(q =>
          q.slug === targetHash ||
          q.id === targetHash ||
          q.id.toLowerCase() === targetHash.toLowerCase()
        );
        if (targetQuote) {
          targetSlide = createSlideFromQuote(targetQuote, templateSlide, 'deep');
        }
      }

      if (targetSlide) {
        const unseenRemaining = initialSlides.filter(s => !recentSeenSet.has(s.dataset.quoteId));
        const seenRemaining = initialSlides.filter(s => recentSeenSet.has(s.dataset.quoteId));
        shuffleArray(unseenRemaining);
        seenRemaining.sort((a, b) => recentSeenList.indexOf(a.dataset.quoteId) - recentSeenList.indexOf(b.dataset.quoteId));
        initialSlides = [targetSlide, ...unseenRemaining, ...seenRemaining];
      } else {
        // Target hash not found; treat as master feed
        targetHash = null;
      }
    }

    if (!targetHash) {
      if (feedType === 'quote') {
        // On individual canonical quote pages, keep target quote first, shuffle continuation stream avoiding seen
        const primary = initialSlides[0];
        const rest = initialSlides.slice(1);
        const unseenRest = rest.filter(s => !recentSeenSet.has(s.dataset.quoteId));
        const seenRest = rest.filter(s => recentSeenSet.has(s.dataset.quoteId));
        shuffleArray(unseenRest);
        seenRest.sort((a, b) => recentSeenList.indexOf(a.dataset.quoteId) - recentSeenList.indexOf(b.dataset.quoteId));
        initialSlides = [primary, ...unseenRest, ...seenRest];
      } else if (matchedCount > 0 && matchedCount < initialSlides.length) {
        // In filtered feeds (author, category, mood, tag)
        const matched = initialSlides.slice(0, matchedCount);
        const continuation = initialSlides.slice(matchedCount);

        const unseenMatched = matched.filter(s => !recentSeenSet.has(s.dataset.quoteId));
        const seenMatched = matched.filter(s => recentSeenSet.has(s.dataset.quoteId));
        shuffleArray(unseenMatched);
        seenMatched.sort((a, b) => recentSeenList.indexOf(a.dataset.quoteId) - recentSeenList.indexOf(b.dataset.quoteId));

        const unseenCont = continuation.filter(s => !recentSeenSet.has(s.dataset.quoteId));
        const seenCont = continuation.filter(s => recentSeenSet.has(s.dataset.quoteId));
        shuffleArray(unseenCont);
        seenCont.sort((a, b) => recentSeenList.indexOf(a.dataset.quoteId) - recentSeenList.indexOf(b.dataset.quoteId));

        initialSlides = [...unseenMatched, ...seenMatched, ...unseenCont, ...seenCont];

        // Keep continuation banner precisely positioned on the first continuation slide
        initialSlides.forEach(s => {
          const b = s.querySelector('.continuation-banner');
          if (b) b.remove();
        });
        if (initialSlides[matchedCount]) {
          const bannerDiv = document.createElement('div');
          bannerDiv.className = 'continuation-banner pointer-events-none absolute top-28 sm:top-32 z-30 left-1/2 -translate-x-1/2 flex items-center gap-2 glass px-4.5 py-2 rounded-full border border-white/20 text-[11px] font-medium text-white/90 shadow-xl shadow-black/40 select-none tracking-wider uppercase leading-normal';
          bannerDiv.style.top = 'calc(max(env(safe-area-inset-top, 0px), 16px) + 94px)';
          bannerDiv.innerHTML = '<span class="text-amber-300">✦</span><span>More Wisdom Ahead</span>';
          initialSlides[matchedCount].appendChild(bannerDiv);
        }
      } else {
        // General master feed:
        // Separate into unseen and seen slides
        let unseen = initialSlides.filter(s => !recentSeenSet.has(s.dataset.quoteId));
        const seen = initialSlides.filter(s => recentSeenSet.has(s.dataset.quoteId));

        // Rely on visited quotes: always guarantee fresh unseen quotes at top
        if (window.__wisdomQuoteMap) {
          const existingIds = new Set(initialSlides.map(s => s.dataset.quoteId));
          const allQuotes = Object.values(window.__wisdomQuoteMap);
          const freshCatalogQuotes = allQuotes.filter(q => !recentSeenSet.has(q.id) && !existingIds.has(q.id));
          shuffleArray(freshCatalogQuotes);
          const needed = Math.max(0, 35 - unseen.length);
          if (needed > 0) {
            const toInject = freshCatalogQuotes.slice(0, needed);
            toInject.forEach(q => {
              const newSlide = createSlideFromQuote(q, templateSlide, 'init');
              unseen.push(newSlide);
            });
          }
        }

        shuffleArray(unseen);
        // Sort seen slides by oldest seen first
        seen.sort((a, b) => recentSeenList.indexOf(a.dataset.quoteId) - recentSeenList.indexOf(b.dataset.quoteId));
        initialSlides = [...unseen, ...seen];
      }
    }

    // Reorder DOM nodes in container
    const fragment = document.createDocumentFragment();
    initialSlides.forEach(slide => fragment.appendChild(slide));
    container.innerHTML = '';
    container.appendChild(fragment);

    let batchNumber = 1;
    let currentChunkPage = 1;
    let isFetchingChunk = false;
    let loadedQuoteList = [];

    async function loadNextQuoteChunk() {
      if (isFetchingChunk) return [];
      isFetchingChunk = true;
      try {
        const base = window.__wisdomBaseUrl || '/wisdom';
        const res = await fetch(`${base}/api/quotes/chunk-${currentChunkPage}.json`);
        if (res.ok) {
          const data = await res.json();
          if (data && data.quotes) {
            loadedQuoteList.push(...data.quotes);
            currentChunkPage++;
            return data.quotes;
          }
        }
      } catch (e) {
        console.warn('Could not load quote chunk:', e);
      } finally {
        isFetchingChunk = false;
      }
      return [];
    }

    // Pre-warm chunk 1 on idle
    if (typeof window !== 'undefined') {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => loadNextQuoteChunk());
      } else {
        setTimeout(() => loadNextQuoteChunk(), 1200);
      }
    }

    // ── Infinite Scroll Appender: Appends fresh unseen quotes avoiding the last 50 seen ──
    async function appendNextBatch() {
      const batchFragment = document.createDocumentFragment();
      const appendedSlides = [];

      const currentSeenList = (window.recentQuotes && typeof window.recentQuotes.getAll === 'function')
        ? window.recentQuotes.getAll()
        : [];
      const currentSeenSet = new Set(currentSeenList);

      // Quote IDs currently rendered in the DOM
      const domQuoteIds = new Set(
        Array.from(container.querySelectorAll('.reel-slide')).map(s => s.dataset.quoteId)
      );

      // If quotes pool is running low, trigger next chunk fetch
      if (loadedQuoteList.length < 35) {
        await loadNextQuoteChunk();
      }

      const quoteMap = window.__wisdomQuoteMap || {};
      const allQuoteList = loadedQuoteList.length > 0 ? loadedQuoteList : Object.values(quoteMap);
      if (allQuoteList.length === 0) return;

      // Candidate quotes from loaded catalog:
      // 1. Must NOT be in the last 50 seen quotes (currentSeenSet)
      // 2. Must NOT be currently in the DOM (domQuoteIds)
      let freshCandidates = allQuoteList.filter(q =>
        !currentSeenSet.has(q.id) && !domQuoteIds.has(q.id)
      );

      // In filtered feeds, prioritize matching topic quotes if any remain unseen
      const firstSlide = initialSlides[0];
      if (feedType === 'category' && firstSlide && firstSlide.dataset.categorySlug) {
        const catSlug = firstSlide.dataset.categorySlug;
        const matchingFresh = freshCandidates.filter(q => q.categorySlug === catSlug);
        if (matchingFresh.length > 0) {
          freshCandidates = matchingFresh;
        }
      } else if (feedType === 'author' && firstSlide && firstSlide.dataset.authorSlug) {
        const authSlug = firstSlide.dataset.authorSlug;
        const matchingFresh = freshCandidates.filter(q => q.authorSlug === authSlug);
        if (matchingFresh.length > 0) {
          freshCandidates = matchingFresh;
        }
      } else if (feedType === 'mood' && firstSlide && firstSlide.dataset.mood) {
        const m = firstSlide.dataset.mood;
        const matchingFresh = freshCandidates.filter(q => q.mood === m);
        if (matchingFresh.length > 0) {
          freshCandidates = matchingFresh;
        }
      }

      if (freshCandidates.length > 0) {
        shuffleArray(freshCandidates);
        const batch = freshCandidates.slice(0, 15);
        batch.forEach(quote => {
          const slide = createSlideFromQuote(quote, templateSlide, `b${batchNumber}`);
          batchFragment.appendChild(slide);
          appendedSlides.push(slide);
        });
      } else {
        // Fallback when all catalog quotes were viewed:
        // Pick quotes from catalog that are NOT currently in the last 50 seen quotes
        let eligible = allQuoteList.filter(q => !currentSeenSet.has(q.id));
        if (eligible.length === 0) {
          // If total catalog <= 50, select quotes whose last view was oldest in history
          eligible = allQuoteList.slice().sort((a, b) => {
            const idxA = currentSeenList.indexOf(a.id);
            const idxB = currentSeenList.indexOf(b.id);
            return (idxA === -1 ? -1 : idxA) - (idxB === -1 ? -1 : idxB);
          });
        }
        shuffleArray(eligible);
        const batch = eligible.slice(0, 15);
        batch.forEach(quote => {
          const slide = createSlideFromQuote(quote, templateSlide, `b${batchNumber}`);
          batchFragment.appendChild(slide);
          appendedSlides.push(slide);
        });
      }

      batchNumber++;
      container.appendChild(batchFragment);

      // Observe all newly appended slides
      appendedSlides.forEach(slide => observer.observe(slide));
    }

    let lastTapTime = 0;
    let lastTapTarget = null;

    function getAuthorInitialsClient(name) {
      if (!name) return 'W';
      return name
        .split(' ')
        .map(function(part) { return part[0]; })
        .filter(Boolean)
        .slice(0, 2)
        .join('')
        .toUpperCase();
    }

    // ── Fixed Metadata Dock Flip-in-Place Controller ──
    let currentDockQuoteId = (initialSlides.length > 0 && initialSlides[0].dataset) ? initialSlides[0].dataset.quoteId : null;
    let currentDockAuthor = (initialSlides.length > 0 && initialSlides[0].dataset) ? initialSlides[0].dataset.author : null;
    let flipToken = 0;

    function renderDockTagsHtml(tagsArray, isFlipping = false) {
      return tagsArray.map((t, idx) => `
        <div class="flip-pill-wrapper inline-flex" data-dock-tag-wrapper>
          <a href="${base}/tag/${encodeURIComponent(t)}/"
             class="pointer-events-auto text-xs font-medium text-white/80 hover:text-white transition-colors duration-200 bg-white/10 hover:bg-white/20 active:scale-95 px-4 py-2 rounded-full backdrop-blur-md border border-white/15 cursor-pointer shadow-md inline-flex items-center leading-normal dock-pill ${isFlipping ? 'pill-flipping-in' : ''}"
             ${isFlipping ? `style="animation-delay: ${idx * 30}ms;"` : ''}>
            #${escapeHtml(t)}
          </a>
        </div>
      `).join('');
    }

    function updateDockPills(slide, immediate = false) {
      if (!slide || !slide.dataset) return;
      const quoteId = slide.dataset.quoteId;
      if (!quoteId) return;
      if (!immediate && quoteId === currentDockQuoteId) return;

      currentDockQuoteId = quoteId;
      const thisToken = ++flipToken;

      const author = slide.dataset.author || 'Wisdom';
      const authorSlug = slide.dataset.authorSlug || 'wisdom';
      const authorChanged = (!currentDockAuthor || currentDockAuthor !== author);
      currentDockAuthor = author;

      const category = slide.dataset.category || 'Wisdom';
      const categorySlug = slide.dataset.categorySlug || 'wisdom';
      const mood = slide.dataset.mood || 'reflective';
      const moodInfo = moodMetaClient[mood] || { label: mood, emoji: '✨' };
      const moodLabel = slide.dataset.moodLabel || moodInfo.label;
      const moodEmoji = slide.dataset.moodEmoji || moodInfo.emoji;

      let tags = [];
      if (slide.dataset.tags) {
        try {
          tags = JSON.parse(slide.dataset.tags);
        } catch {}
      }

      const authorPill = document.getElementById('dock-author-pill');
      const authorNameSpan = document.getElementById('dock-author-name');
      const authorInitialSpan = document.getElementById('dock-author-initial');
      const catPill = document.getElementById('dock-category-pill');
      const moodPill = document.getElementById('dock-mood-pill');
      const moodEmojiSpan = document.getElementById('dock-mood-emoji');
      const moodLabelSpan = document.getElementById('dock-mood-label');
      const tagsContainer = document.getElementById('dock-tags-container');

      const prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (immediate || prefersReducedMotion) {
        if (authorPill) {
          authorPill.href = `${base}/author/${authorSlug}/?about=1`;
          authorPill.setAttribute('data-author-slug', authorSlug);
          authorPill.setAttribute('data-author-name', author);
          authorPill.setAttribute('aria-label', `About ${author}`);
          authorPill.setAttribute('title', `About ${author}`);
          if (authorNameSpan) authorNameSpan.textContent = author;
          if (authorInitialSpan) authorInitialSpan.textContent = getAuthorInitialsClient(author);
        }
        if (catPill) {
          catPill.textContent = category;
          catPill.href = `${base}/category/${categorySlug}/`;
          catPill.className = 'pointer-events-auto glass rounded-full px-4.5 py-2 text-xs font-medium text-white/90 hover:text-white hover:bg-white/20 transition-all duration-200 shadow-sm whitespace-nowrap inline-flex items-center leading-normal dock-pill';
        }
        if (moodPill) {
          moodPill.href = `${base}/mood/${mood}/`;
          moodPill.className = `pointer-events-auto mood-pill-${mood} rounded-full px-5 py-2 text-xs font-semibold text-white hover:scale-105 transition-all duration-200 shadow-md shadow-black/20 inline-flex items-center gap-2 whitespace-nowrap shrink-0 leading-normal dock-pill`;
          if (moodEmojiSpan) moodEmojiSpan.textContent = moodEmoji;
          if (moodLabelSpan) moodLabelSpan.textContent = moodLabel;
        }
        if (tagsContainer) {
          tagsContainer.innerHTML = renderDockTagsHtml(tags, false);
        }
        return;
      }

      // ── 3D Perspective Flip-in-Place Sequence ──
      // 0. About Author Pill Flip (starts at 0ms if author changed)
      if (authorPill && authorChanged) {
        authorPill.classList.remove('pill-flipping-in');
        authorPill.classList.add('pill-flipping-out');
        setTimeout(() => {
          if (thisToken !== flipToken) return;
          authorPill.href = `${base}/author/${authorSlug}/?about=1`;
          authorPill.setAttribute('data-author-slug', authorSlug);
          authorPill.setAttribute('data-author-name', author);
          authorPill.setAttribute('aria-label', `About ${author}`);
          authorPill.setAttribute('title', `About ${author}`);
          if (authorNameSpan) authorNameSpan.textContent = author;
          if (authorInitialSpan) authorInitialSpan.textContent = getAuthorInitialsClient(author);
          authorPill.classList.remove('pill-flipping-out');
          authorPill.classList.add('pill-flipping-in');
          setTimeout(() => {
            if (thisToken !== flipToken) return;
            authorPill.classList.remove('pill-flipping-in');
          }, 240);
        }, 140);
      }

      // 1. Category Pill Flip (starts at 35ms)
      if (catPill) {
        setTimeout(() => {
          if (thisToken !== flipToken) return;
          catPill.classList.remove('pill-flipping-in');
          catPill.classList.add('pill-flipping-out');
          setTimeout(() => {
            if (thisToken !== flipToken) return;
            catPill.textContent = category;
            catPill.href = `${base}/category/${categorySlug}/`;
            catPill.classList.remove('pill-flipping-out');
            catPill.classList.add('pill-flipping-in');
            setTimeout(() => {
              if (thisToken !== flipToken) return;
              catPill.classList.remove('pill-flipping-in');
            }, 240);
          }, 140);
        }, 35);
      }

      // 2. Mood Badge Flip (starts at 70ms)
      if (moodPill) {
        setTimeout(() => {
          if (thisToken !== flipToken) return;
          moodPill.classList.remove('pill-flipping-in');
          moodPill.classList.add('pill-flipping-out');
          setTimeout(() => {
            if (thisToken !== flipToken) return;
            moodPill.href = `${base}/mood/${mood}/`;
            moodPill.className = `pointer-events-auto mood-pill-${mood} rounded-full px-5 py-2 text-xs font-semibold text-white hover:scale-105 transition-all duration-200 shadow-md shadow-black/20 inline-flex items-center gap-2 whitespace-nowrap shrink-0 leading-normal dock-pill pill-flipping-in`;
            if (moodEmojiSpan) moodEmojiSpan.textContent = moodEmoji;
            if (moodLabelSpan) moodLabelSpan.textContent = moodLabel;
            setTimeout(() => {
              if (thisToken !== flipToken) return;
              moodPill.classList.remove('pill-flipping-in');
            }, 240);
          }, 140);
        }, 70);
      }

      // 3. Tag Chips Flip (starts at 105ms)
      if (tagsContainer) {
        setTimeout(() => {
          if (thisToken !== flipToken) return;
          const oldTagPills = Array.from(tagsContainer.querySelectorAll('.dock-pill'));
          if (oldTagPills.length > 0) {
            oldTagPills.forEach((p, idx) => {
              p.classList.remove('pill-flipping-in');
              p.style.animationDelay = `${idx * 25}ms`;
              p.classList.add('pill-flipping-out');
            });
          }

          setTimeout(() => {
            if (thisToken !== flipToken) return;
            tagsContainer.innerHTML = renderDockTagsHtml(tags, true);
            setTimeout(() => {
              if (thisToken !== flipToken) return;
              const newPills = Array.from(tagsContainer.querySelectorAll('.dock-pill'));
              newPills.forEach(p => {
                p.classList.remove('pill-flipping-in');
                p.style.animationDelay = '';
              });
            }, 240 + (tags.length * 30));
          }, oldTagPills.length > 0 ? 140 : 0);
        }, 105);
      }
    }

    // ── IntersectionObserver for active slide detection ──
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          const slide = entry.target;
          const quoteId = slide.dataset.quoteId;
          const videoSrc = slide.dataset.videoSrc;
          const gradientClass = slide.dataset.gradientClass;
          const mood = slide.dataset.mood;
          const audioSrc = slide.dataset.audioSrc;

          // Check if approaching the end of current slides — append next batch!
          const currentSlides = Array.from(container.querySelectorAll('.reel-slide'));
          const activeIdx = currentSlides.indexOf(slide);

          if (activeIdx >= currentSlides.length - 4) {
            appendNextBatch();
          }

          currentSlides.forEach(s => s.classList.remove('is-active'));
          slide.classList.add('is-active');

          // Flip dock metadata pills (category, mood, tags) to match newly active slide
          updateDockPills(slide, false);

          // Record as viewed in the last 50 seen quotes history
          recordQuoteSeen(quoteId);

          // Update background animation with quoteId for unique diverse visual personality
          if (window.setBackground) {
            window.setBackground(videoSrc, gradientClass, mood, quoteId);
          }

          // Play peaceful Zen chime once on slide arrival (then complete silence)
          if (window.wisdomAudio && mood) {
            window.wisdomAudio.playOnce(mood);
          }

          const quoteSlug = slide.dataset.quoteSlug;

          // Update URL hash for natural-language quote permalink
          if (quoteSlug) {
            history.replaceState(null, '', `#${quoteSlug}`);
          } else if (quoteId) {
            history.replaceState(null, '', `#${quoteId}`);
          }

          // Update like button state
          if (window.likedQuotes && window.updateLikeUI) {
            window.updateLikeUI(window.likedQuotes.has(quoteId));
          }

          // Update header topic text (remove on scroll if topic is deviated in infinite scroll)
          updateHeaderTopicState(slide);

          // Update share context & background prepare 9:16 quote card image
          if (window.updateShareContext) {
            window.updateShareContext(slide);
          }
          if (window.prepareQuoteCardImage) {
            window.prepareQuoteCardImage(slide);
            const nextSlide = slide.nextElementSibling;
            if (nextSlide && nextSlide.classList && nextSlide.classList.contains('reel-slide')) {
              if ('requestIdleCallback' in window) {
                requestIdleCallback(() => window.prepareQuoteCardImage(nextSlide));
              } else {
                setTimeout(() => window.prepareQuoteCardImage(nextSlide), 350);
              }
            }
          }
        }
      });
    }, {
      root: container,
      threshold: 0.5,
    });

    // Helper: update header topic visibility when scrolling between matched and continuation quotes
    function updateHeaderTopicState(slide) {
      if (!slide) return;
      const isTopicMatch = slide.dataset.topicMatch !== 'false';
      const headerTitle = document.getElementById('feed-header-title');
      if (headerTitle && feedType !== 'master') {
        if (isTopicMatch) {
          headerTitle.classList.remove('opacity-0', 'pointer-events-none');
          headerTitle.classList.add('opacity-100');
          headerTitle.removeAttribute('aria-hidden');
        } else {
          headerTitle.classList.remove('opacity-100');
          headerTitle.classList.add('opacity-0', 'pointer-events-none');
          headerTitle.setAttribute('aria-hidden', 'true');
        }
      }
    }

    initialSlides.forEach(slide => observer.observe(slide));

    // Initialize first slide (target quote or freshly randomized top quote)
    if (initialSlides.length > 0) {
      const first = initialSlides[0];
      initialSlides.forEach(s => s.classList.remove('is-active'));
      first.classList.add('is-active');
      recordQuoteSeen(first.dataset.quoteId);
      updateHeaderTopicState(first);
      updateDockPills(first, true);

      if (window.setBackground) {
        window.setBackground(first.dataset.videoSrc, first.dataset.gradientClass, first.dataset.mood, first.dataset.quoteId);
      }
      if (window.likedQuotes && window.updateLikeUI) {
        window.updateLikeUI(window.likedQuotes.has(first.dataset.quoteId));
      }
      if (window.updateShareContext) {
        window.updateShareContext(first);
      }
      if (window.prepareQuoteCardImage) {
        window.prepareQuoteCardImage(first);
        const second = initialSlides[1];
        if (second) {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(() => window.prepareQuoteCardImage(second));
          } else {
            setTimeout(() => window.prepareQuoteCardImage(second), 400);
          }
        }
      }
      if (window.wisdomAudio && first.dataset.mood) {
        window.wisdomAudio.setMood(first.dataset.mood);
        window.wisdomAudio.playOnce(first.dataset.mood);
      }

      // Sync URL hash with the first quote only if explicit targetHash was requested or on filtered pages
      if (targetHash) {
        history.replaceState(null, '', `#${targetHash}`);
      } else if (feedType !== 'master' && first.dataset.quoteSlug) {
        history.replaceState(null, '', `#${first.dataset.quoteSlug}`);
      }
    }

    // ── Deep-Link & Notification Navigation Engine ──
    function navigateToQuote(slugOrId) {
      if (!slugOrId) return false;
      const cleanTarget = decodeURIComponent(slugOrId).replace(/^#/, '');

      // 1. Check if matching slide is already rendered in container
      const currentSlides = Array.from(container.querySelectorAll('.reel-slide'));
      let match = currentSlides.find(s =>
        s.dataset.quoteSlug === cleanTarget ||
        s.dataset.quoteId === cleanTarget ||
        s.id === `slide-${cleanTarget}` ||
        (s.dataset.quoteId && s.dataset.quoteId.toLowerCase() === cleanTarget.toLowerCase())
      );

      // 2. If not found in DOM, look up in catalog and instantiate slide dynamically
      if (!match && window.__wisdomQuoteMap) {
        const allQuotes = Object.values(window.__wisdomQuoteMap);
        const quoteObj = allQuotes.find(q =>
          q.slug === cleanTarget ||
          q.id === cleanTarget ||
          q.id.toLowerCase() === cleanTarget.toLowerCase()
        );
        if (quoteObj) {
          match = createSlideFromQuote(quoteObj, templateSlide, 'nav');
          const activeSlide = container.querySelector('.reel-slide.is-active');
          if (activeSlide) {
            container.insertBefore(match, activeSlide);
          } else {
            container.insertBefore(match, container.firstChild);
          }
          observer.observe(match);
        }
      }

      // 3. Scroll to and activate match
      if (match) {
        match.scrollIntoView({ behavior: 'smooth', block: 'start' });
        const updatedSlides = Array.from(container.querySelectorAll('.reel-slide'));
        updatedSlides.forEach(s => s.classList.remove('is-active'));
        match.classList.add('is-active');
        recordQuoteSeen(match.dataset.quoteId);
        updateDockPills(match, false);
        if (window.setBackground) {
          window.setBackground(match.dataset.videoSrc, match.dataset.gradientClass, match.dataset.mood, match.dataset.quoteId);
        }
        if (window.wisdomAudio && match.dataset.mood) {
          window.wisdomAudio.playOnce(match.dataset.mood);
        }
        if (window.likedQuotes && window.updateLikeUI) {
          window.updateLikeUI(window.likedQuotes.has(match.dataset.quoteId));
        }
        if (window.updateShareContext) {
          window.updateShareContext(match);
        }
        updateHeaderTopicState(match);
        return true;
      }
      return false;
    }

    // Global hook & live event listeners
    window.__wisdomNavigateToQuote = navigateToQuote;

    window.addEventListener('hashchange', () => {
      if (window.location.hash) {
        navigateToQuote(window.location.hash.slice(1));
      }
    });

    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.addEventListener('message', (event) => {
        if (event.data && event.data.type === 'WISDOM_NAVIGATE_QUOTE') {
          const target = event.data.quoteSlug || event.data.quoteId || (event.data.url && event.data.url.split('#')[1]);
          if (target) {
            navigateToQuote(target);
          }
        }
      });
    }

    // ── Double-tap to Like ──
    container.onclick = (e) => {
      const zone = e.target.closest('[data-doubletap-zone]');
      if (!zone) return;

      const now = Date.now();
      const zoneId = zone.dataset.doubletapZone;

      if (now - lastTapTime < 380 && lastTapTarget === zoneId) {
        e.preventDefault();
        triggerDoubleTapLike(zoneId);
        lastTapTime = 0;
        lastTapTarget = null;
      } else {
        lastTapTime = now;
        lastTapTarget = zoneId;
      }
    };

    function triggerDoubleTapLike(quoteId) {
      if (window.likedQuotes) {
        if (!window.likedQuotes.has(quoteId)) {
          window.likedQuotes.toggle(quoteId);
          if (window.updateLikeUI) window.updateLikeUI(true);
        }
      }

      // Heart burst animation
      const overlay = document.getElementById('heart-burst-overlay');
      if (overlay) {
        overlay.style.display = 'flex';
        const svg = overlay.querySelector('svg');
        if (svg) {
          svg.style.animation = 'none';
          svg.offsetHeight; // force reflow
          svg.style.animation = 'heart-burst 0.65s var(--ease-spring) forwards';
        }
        setTimeout(() => { overlay.style.display = 'none'; }, 700);
      }
    }

    // ── About Author Pill click handler ──
    const authorPill = document.getElementById('dock-author-pill');
    if (authorPill) {
      authorPill.onclick = (e) => {
        e.preventDefault();
        const activeSlide = document.querySelector('.reel-slide.is-active') || document.querySelector('.reel-slide');
        const authorSlug = activeSlide?.dataset?.authorSlug || authorPill.getAttribute('data-author-slug') || '';
        const authorName = activeSlide?.dataset?.author || authorPill.getAttribute('data-author-name') || document.getElementById('dock-author-name')?.textContent?.trim() || '';
        if (window.openAuthorDossierModal) {
          window.openAuthorDossierModal(authorSlug, authorName);
        } else if (authorPill.href) {
          window.location.href = authorPill.href;
        }
      };
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupReelFeed);
  } else {
    setupReelFeed();
  }
  document.addEventListener('astro:page-load', setupReelFeed);
</script>
