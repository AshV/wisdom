---
/**
 * ReelFeed — Scroll-snap vertical reel container.
 *
 * Manages IntersectionObserver for:
 * - Background media switching
 * - URL hash updates
 * - Audio source switching
 * - Active slide tracking
 * - Double-tap like detection
 */
import ReelSlide from './ReelSlide.astro';
import RightActionRail from './RightActionRail.astro';
import ExploreDrawer from './ExploreDrawer.astro';
import ShareModal from './ShareModal.astro';

interface QuoteData {
  id: string;
  content: string;
  author: string;
  authorSlug: string;
  category: string;
  categorySlug: string;
  mood: 'reflective' | 'motivational' | 'serene' | 'bold' | 'melancholic' | 'joyful' | 'philosophical' | 'romantic';
  tags: string[];
}

interface Props {
  quotes: QuoteData[];
  feedTitle: string;
  feedType?: string;
  matchedCount?: number;
  filterLabel?: string;
}

const { quotes, feedTitle, feedType = 'master', matchedCount, filterLabel } = Astro.props;
const effectiveMatchedCount = matchedCount ?? (feedType === 'quote' ? 1 : (feedType === 'master' ? 0 : quotes.length));
---

<!-- Feed Header (subtle overlay) -->
<header class="fixed top-0 left-0 right-0 z-20 pointer-events-none">
  <div class="flex items-center justify-between px-5 pt-[max(env(safe-area-inset-top),16px)] pb-3">
    <div class="pointer-events-auto">
      {feedType !== 'master' ? (
        <a
          href="/wisdom/"
          class="glass rounded-full px-4 py-2 text-xs font-semibold text-white/80 hover:text-white flex items-center gap-1.5 transition-all duration-200 hover:scale-105 shadow-md shadow-black/20"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6" />
          </svg>
          Back
        </a>
      ) : (
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-xs font-bold tracking-widest text-white/60 uppercase">WISDOM</span>
        </div>
      )}
    </div>
    <div class="text-center flex-1 mx-4 truncate">
      <h1
        id="feed-header-title"
        class="text-sm font-bold text-white/90 tracking-wide text-shadow-soft truncate transition-opacity duration-300"
      >
        {feedTitle}
      </h1>
    </div>
    <div class="w-24 flex justify-end">
      <span class="text-[11px] font-mono font-medium text-white/80 glass px-3.5 py-1.5 rounded-full flex items-center gap-1.5 shadow-sm leading-normal">
        {matchedCount && matchedCount < quotes.length ? (
          <>
            <span>{matchedCount}</span>
            <span class="text-white/30">&bull;</span>
            <span class="text-xs text-amber-300 font-sans">&infin;</span>
          </>
        ) : (
          <>
            <span>{quotes.length}</span>
            <span class="text-white/30">&bull;</span>
            <span class="text-xs text-amber-300 font-sans">&infin;</span>
          </>
        )}
      </span>
    </div>
  </div>
</header>

<!-- Scroll-Snap Reel Container (Infinite Never-Ending Stream) -->
<main
  id="reel-container"
  class="reel-container relative z-10 w-full h-[100dvh]"
  data-feed-type={feedType}
  data-matched-count={matchedCount}
>
  {quotes.map((q, i) => (
    <ReelSlide
      id={q.id}
      content={q.content}
      author={q.author}
      authorSlug={q.authorSlug}
      category={q.category}
      categorySlug={q.categorySlug}
      mood={q.mood}
      tags={q.tags}
      index={i}
      isStreamContinuation={Boolean(effectiveMatchedCount && i === effectiveMatchedCount)}
      isTopicMatch={Boolean(effectiveMatchedCount ? i < effectiveMatchedCount : true)}
    />
  ))}

  {quotes.length === 0 && (
    <div class="reel-slide flex flex-col items-center justify-center p-6 text-center">
      <p class="text-2xl text-white/70 font-light mb-4">No quotes found in this feed.</p>
      <a href="/wisdom/" class="glass px-6 py-3 rounded-full text-sm font-medium text-white hover:bg-white/10">Return to Master Feed</a>
    </div>
  )}
</main>

<!-- Right Action Rail -->
<RightActionRail />

<!-- Explore Drawer -->
<ExploreDrawer />

<!-- Share Modal -->
<ShareModal />

<script is:inline>
  function setupReelFeed() {
    const container = document.getElementById('reel-container');
    if (!container) return;

    let initialSlides = Array.from(container.querySelectorAll('.reel-slide'));
    if (initialSlides.length === 0) return;

    // Snapshot a clean slide as template for on-demand dynamic streaming
    const templateSlide = initialSlides[0].cloneNode(true);
    const initialContBanner = templateSlide.querySelector('.continuation-banner');
    if (initialContBanner) initialContBanner.remove();
    templateSlide.classList.remove('is-active');

    // ── Fisher-Yates shuffle helper ──
    function shuffleArray(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
      }
      return arr;
    }

    // ── Helper to record viewed quote ID in recentQuotes store ──
    function recordQuoteSeen(id) {
      if (!id) return;
      if (window.recentQuotes && typeof window.recentQuotes.add === 'function') {
        window.recentQuotes.add(id);
      }
    }

    // ── Mood Metadata & Video/Audio mappings for dynamic slides ──
    const moodMetaClient = {
      reflective: { label: 'Reflective', emoji: '🌙' },
      motivational: { label: 'Motivational', emoji: '🔥' },
      serene: { label: 'Serene', emoji: '🌊' },
      bold: { label: 'Bold', emoji: '⚡' },
      melancholic: { label: 'Melancholic', emoji: '🌧️' },
      joyful: { label: 'Joyful', emoji: '✨' },
      philosophical: { label: 'Philosophical', emoji: '🤔' },
      romantic: { label: 'Romantic', emoji: '💜' },
    };

    function djb2(str) {
      let hash = 5381;
      for (let i = 0; i < str.length; i++) {
        hash = ((hash << 5) + hash + str.charCodeAt(i)) >>> 0;
      }
      return hash;
    }

    const base = window.__wisdomBaseUrl || '/wisdom';

    function getMediaForClientQuote(id, mood) {
      const idx = (djb2(id) % 2) + 1;
      const numStr = idx < 10 ? '0' + idx : '' + idx;
      return {
        video: `${base}/media/videos/${mood}-${numStr}.mp4`,
        gradient: `gradient-${mood}`,
        audio: `${base}/media/audio/chime-${mood}.wav`
      };
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // ── Factory to build full-fidelity slide DOM element from quote object ──
    function createSlideFromQuote(quote, templateElement, loopSuffix = '') {
      const clone = templateElement.cloneNode(true);
      const existingElem = document.getElementById(`slide-${quote.id}`);
      clone.id = (existingElem || loopSuffix) ? `slide-${quote.id}-${loopSuffix || 'dyn'}` : `slide-${quote.id}`;
      clone.classList.remove('is-active');

      const media = getMediaForClientQuote(quote.id, quote.mood);
      const moodInfo = moodMetaClient[quote.mood] || { label: quote.mood, emoji: '✨' };

      // Update data attributes
      clone.dataset.quoteId = quote.id;
      clone.dataset.quoteSlug = quote.slug;
      clone.dataset.content = quote.content;
      clone.dataset.author = quote.author;
      clone.dataset.authorSlug = quote.authorSlug;
      clone.dataset.videoSrc = media.video;
      clone.dataset.gradientClass = media.gradient;
      clone.dataset.mood = quote.mood;
      clone.dataset.category = quote.category;
      clone.dataset.categorySlug = quote.categorySlug;
      clone.dataset.audioSrc = media.audio;
      clone.dataset.topicMatch = 'true';

      // Remove continuation banner from cloned slides
      const banner = clone.querySelector('.continuation-banner');
      if (banner) banner.remove();

      // Double-tap zone
      const dtz = clone.querySelector('[data-doubletap-zone]');
      if (dtz) dtz.dataset.doubletapZone = quote.id;

      // Quote text & adaptive typography sizing
      const len = quote.content.length;
      let quoteSizeStyle = '';
      if (len < 55) {
        quoteSizeStyle = 'font-size: clamp(2.2rem, 5.5vw, 4.2rem); line-height: 1.18; max-width: 900px;';
      } else if (len < 110) {
        quoteSizeStyle = 'font-size: clamp(1.75rem, 4.2vw, 3.1rem); line-height: 1.25; max-width: 950px;';
      } else if (len < 180) {
        quoteSizeStyle = 'font-size: clamp(1.4rem, 3.2vw, 2.4rem); line-height: 1.32; max-width: 1000px;';
      } else {
        quoteSizeStyle = 'font-size: clamp(1.2rem, 2.6vw, 1.95rem); line-height: 1.38; max-width: 1050px;';
      }

      const quoteP = clone.querySelector('.quote-text');
      if (quoteP) {
        quoteP.textContent = quote.content;
        quoteP.style.cssText = `${quoteSizeStyle} font-family: 'Playfair Display', 'Cormorant Garamond', Georgia, serif;`;
      }

      // Author attribution
      const authorLink = clone.querySelector('a[href*="/author/"]');
      if (authorLink) {
        authorLink.href = `${base}/author/${quote.authorSlug}/`;
        authorLink.title = `More quotes by ${quote.author}`;
        const authorSpan = authorLink.querySelector('.author-name-text') || authorLink;
        authorSpan.textContent = quote.author;
      }

      // Category pill
      const categoryLink = clone.querySelector('a[href*="/category/"]');
      if (categoryLink) {
        categoryLink.href = `${base}/category/${quote.categorySlug}/`;
        categoryLink.textContent = quote.category;
      }

      // Mood pill
      const moodLink = clone.querySelector('a[href*="/mood/"]');
      if (moodLink) {
        moodLink.className = `pointer-events-auto mood-pill-${quote.mood} rounded-full px-5 py-1.5 text-xs font-semibold text-white hover:scale-105 transition-all duration-200 shadow-md shadow-black/20 inline-flex items-center gap-2 whitespace-nowrap shrink-0 leading-normal`;
        moodLink.href = `${base}/mood/${quote.mood}/`;
        moodLink.innerHTML = `<span class="shrink-0 text-sm leading-none">${moodInfo.emoji}</span><span class="whitespace-nowrap tracking-wide leading-normal">${moodInfo.label}</span>`;
      }

      // Tag chips
      const tagContainer = clone.querySelector('.flex.flex-wrap.gap-2.pt-0.5');
      if (tagContainer) {
        tagContainer.innerHTML = (quote.tags || []).map(t =>
          `<a href="${base}/tag/${encodeURIComponent(t)}/" class="pointer-events-auto text-xs font-medium text-white/75 hover:text-white transition-colors duration-200 bg-white/10 hover:bg-white/20 active:scale-95 px-4 py-1.5 rounded-full backdrop-blur-sm border border-white/15 cursor-pointer shadow-sm inline-flex items-center leading-normal">#${escapeHtml(t)}</a>`
        ).join('');
      }

      return clone;
    }

    // ── Check for deep-link hash and feed configuration ──
    const rawHash = window.location.hash ? window.location.hash.slice(1) : null;
    const targetHash = rawHash ? decodeURIComponent(rawHash) : null;
    const feedType = container.dataset.feedType || 'master';
    const matchedCount = parseInt(container.dataset.matchedCount, 10) || 0;

    // Retrieve user's recently viewed quote IDs (last 50 seen quotes)
    const recentSeenList = (window.recentQuotes && typeof window.recentQuotes.getAll === 'function')
      ? window.recentQuotes.getAll()
      : [];
    const recentSeenSet = new Set(recentSeenList);

    // ── Intelligent Reordering & Shuffling with 50-Quote Deduplication ──
    if (targetHash) {
      // If a #hash permalink exists, pin the target quote to index 0 and randomize the rest avoiding recent 50
      const targetIdx = initialSlides.findIndex(s =>
        s.dataset.quoteSlug === targetHash ||
        s.id === `slide-${targetHash}` ||
        s.dataset.quoteId === targetHash
      );
      if (targetIdx !== -1) {
        const [targetSlide] = initialSlides.splice(targetIdx, 1);
        const unseenRemaining = initialSlides.filter(s => !recentSeenSet.has(s.dataset.quoteId));
        const seenRemaining = initialSlides.filter(s => recentSeenSet.has(s.dataset.quoteId));
        shuffleArray(unseenRemaining);
        seenRemaining.sort((a, b) => recentSeenList.indexOf(a.dataset.quoteId) - recentSeenList.indexOf(b.dataset.quoteId));
        initialSlides = [targetSlide, ...unseenRemaining, ...seenRemaining];
      } else {
        const unseen = initialSlides.filter(s => !recentSeenSet.has(s.dataset.quoteId));
        const seen = initialSlides.filter(s => recentSeenSet.has(s.dataset.quoteId));
        shuffleArray(unseen);
        seen.sort((a, b) => recentSeenList.indexOf(a.dataset.quoteId) - recentSeenList.indexOf(b.dataset.quoteId));
        initialSlides = [...unseen, ...seen];
      }
    } else if (feedType === 'quote') {
      // On individual canonical quote pages, keep target quote first, shuffle continuation stream avoiding last 50 seen
      const primary = initialSlides[0];
      const rest = initialSlides.slice(1);
      const unseenRest = rest.filter(s => !recentSeenSet.has(s.dataset.quoteId));
      const seenRest = rest.filter(s => recentSeenSet.has(s.dataset.quoteId));
      shuffleArray(unseenRest);
      seenRest.sort((a, b) => recentSeenList.indexOf(a.dataset.quoteId) - recentSeenList.indexOf(b.dataset.quoteId));
      initialSlides = [primary, ...unseenRest, ...seenRest];
    } else if (matchedCount > 0 && matchedCount < initialSlides.length) {
      // In filtered feeds (author, category, mood, tag), place unseen matched quotes first,
      // and unseen continuation quotes before seen continuation quotes
      const matched = initialSlides.slice(0, matchedCount);
      const continuation = initialSlides.slice(matchedCount);

      const unseenMatched = matched.filter(s => !recentSeenSet.has(s.dataset.quoteId));
      const seenMatched = matched.filter(s => recentSeenSet.has(s.dataset.quoteId));
      shuffleArray(unseenMatched);
      seenMatched.sort((a, b) => recentSeenList.indexOf(a.dataset.quoteId) - recentSeenList.indexOf(b.dataset.quoteId));

      const unseenCont = continuation.filter(s => !recentSeenSet.has(s.dataset.quoteId));
      const seenCont = continuation.filter(s => recentSeenSet.has(s.dataset.quoteId));
      shuffleArray(unseenCont);
      seenCont.sort((a, b) => recentSeenList.indexOf(a.dataset.quoteId) - recentSeenList.indexOf(b.dataset.quoteId));

      initialSlides = [...unseenMatched, ...seenMatched, ...unseenCont, ...seenCont];

      // Keep continuation banner precisely positioned on the first continuation slide
      initialSlides.forEach(s => {
        const b = s.querySelector('.continuation-banner');
        if (b) b.remove();
      });
      if (initialSlides[matchedCount]) {
        const bannerDiv = document.createElement('div');
        bannerDiv.className = 'continuation-banner pointer-events-none absolute top-14 sm:top-16 z-30 left-1/2 -translate-x-1/2 flex items-center gap-2 glass px-4 py-1.5 rounded-full border border-white/20 text-[11px] font-medium text-white/90 shadow-xl shadow-black/40 select-none tracking-wider uppercase leading-normal';
        bannerDiv.innerHTML = '<span class="text-amber-300">✦</span><span>More Wisdom Ahead</span>';
        initialSlides[matchedCount].appendChild(bannerDiv);
      }
    } else {
      // General master feed:
      // Separate into unseen and seen slides
      let unseen = initialSlides.filter(s => !recentSeenSet.has(s.dataset.quoteId));
      const seen = initialSlides.filter(s => recentSeenSet.has(s.dataset.quoteId));

      // If user has seen many of the static initial slides, inject fresh unseen quotes from client catalog
      if (unseen.length < 25 && window.__wisdomQuoteMap) {
        const existingIds = new Set(initialSlides.map(s => s.dataset.quoteId));
        const allQuotes = Object.values(window.__wisdomQuoteMap);
        const freshCatalogQuotes = allQuotes.filter(q => !recentSeenSet.has(q.id) && !existingIds.has(q.id));
        shuffleArray(freshCatalogQuotes);
        const needed = 30 - unseen.length;
        const toInject = freshCatalogQuotes.slice(0, needed);
        toInject.forEach(q => {
          const newSlide = createSlideFromQuote(q, templateSlide, 'init');
          unseen.push(newSlide);
        });
      }

      shuffleArray(unseen);
      // Sort seen slides by oldest seen first
      seen.sort((a, b) => recentSeenList.indexOf(a.dataset.quoteId) - recentSeenList.indexOf(b.dataset.quoteId));
      initialSlides = [...unseen, ...seen];
    }

    // Reorder DOM nodes in container
    const fragment = document.createDocumentFragment();
    initialSlides.forEach(slide => fragment.appendChild(slide));
    container.innerHTML = '';
    container.appendChild(fragment);

    let batchNumber = 1;

    // ── Infinite Scroll Appender: Appends fresh unseen quotes avoiding the last 50 seen ──
    function appendNextBatch() {
      const batchFragment = document.createDocumentFragment();
      const appendedSlides = [];

      const currentSeenList = (window.recentQuotes && typeof window.recentQuotes.getAll === 'function')
        ? window.recentQuotes.getAll()
        : [];
      const currentSeenSet = new Set(currentSeenList);

      // Quote IDs currently rendered in the DOM
      const domQuoteIds = new Set(
        Array.from(container.querySelectorAll('.reel-slide')).map(s => s.dataset.quoteId)
      );

      const quoteMap = window.__wisdomQuoteMap || {};
      const allQuoteList = Object.values(quoteMap);

      // Candidate quotes from full catalog:
      // 1. Must NOT be in the last 50 seen quotes (currentSeenSet)
      // 2. Must NOT be currently in the DOM (domQuoteIds)
      let freshCandidates = allQuoteList.filter(q =>
        !currentSeenSet.has(q.id) && !domQuoteIds.has(q.id)
      );

      // In filtered feeds, prioritize matching topic quotes if any remain unseen
      const firstSlide = initialSlides[0];
      if (feedType === 'category' && firstSlide && firstSlide.dataset.categorySlug) {
        const catSlug = firstSlide.dataset.categorySlug;
        const matchingFresh = freshCandidates.filter(q => q.categorySlug === catSlug);
        if (matchingFresh.length > 0) {
          freshCandidates = matchingFresh;
        }
      } else if (feedType === 'author' && firstSlide && firstSlide.dataset.authorSlug) {
        const authSlug = firstSlide.dataset.authorSlug;
        const matchingFresh = freshCandidates.filter(q => q.authorSlug === authSlug);
        if (matchingFresh.length > 0) {
          freshCandidates = matchingFresh;
        }
      } else if (feedType === 'mood' && firstSlide && firstSlide.dataset.mood) {
        const m = firstSlide.dataset.mood;
        const matchingFresh = freshCandidates.filter(q => q.mood === m);
        if (matchingFresh.length > 0) {
          freshCandidates = matchingFresh;
        }
      }

      if (freshCandidates.length > 0) {
        shuffleArray(freshCandidates);
        const batch = freshCandidates.slice(0, 15);
        batch.forEach(quote => {
          const slide = createSlideFromQuote(quote, templateSlide, `b${batchNumber}`);
          batchFragment.appendChild(slide);
          appendedSlides.push(slide);
        });
      } else {
        // Fallback when all catalog quotes were viewed:
        // Pick quotes from catalog that are NOT currently in the last 50 seen quotes
        let eligible = allQuoteList.filter(q => !currentSeenSet.has(q.id));
        if (eligible.length === 0) {
          // If total catalog <= 50, select quotes whose last view was oldest in history
          eligible = allQuoteList.slice().sort((a, b) => {
            const idxA = currentSeenList.indexOf(a.id);
            const idxB = currentSeenList.indexOf(b.id);
            return (idxA === -1 ? -1 : idxA) - (idxB === -1 ? -1 : idxB);
          });
        }
        shuffleArray(eligible);
        const batch = eligible.slice(0, 15);
        batch.forEach(quote => {
          const slide = createSlideFromQuote(quote, templateSlide, `b${batchNumber}`);
          batchFragment.appendChild(slide);
          appendedSlides.push(slide);
        });
      }

      batchNumber++;
      container.appendChild(batchFragment);

      // Observe all newly appended slides
      appendedSlides.forEach(slide => observer.observe(slide));
    }

    let lastTapTime = 0;
    let lastTapTarget = null;

    // ── IntersectionObserver for active slide detection ──
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          const slide = entry.target;
          const quoteId = slide.dataset.quoteId;
          const videoSrc = slide.dataset.videoSrc;
          const gradientClass = slide.dataset.gradientClass;
          const mood = slide.dataset.mood;
          const audioSrc = slide.dataset.audioSrc;

          // Check if approaching the end of current slides — append next batch!
          const currentSlides = Array.from(container.querySelectorAll('.reel-slide'));
          const activeIdx = currentSlides.indexOf(slide);

          if (activeIdx >= currentSlides.length - 4) {
            appendNextBatch();
          }

          currentSlides.forEach(s => s.classList.remove('is-active'));
          slide.classList.add('is-active');

          // Record as viewed in the last 50 seen quotes history
          recordQuoteSeen(quoteId);

          // Update background animation with quoteId for unique diverse visual personality
          if (window.setBackground) {
            window.setBackground(videoSrc, gradientClass, mood, quoteId);
          }

          // Play peaceful Zen chime once on slide arrival (then complete silence)
          if (window.wisdomAudio && mood) {
            window.wisdomAudio.playOnce(mood);
          }

          const quoteSlug = slide.dataset.quoteSlug;

          // Update URL hash for natural-language quote permalink
          if (quoteSlug) {
            history.replaceState(null, '', `#${quoteSlug}`);
          } else if (quoteId) {
            history.replaceState(null, '', `#${quoteId}`);
          }

          // Update like button state
          if (window.likedQuotes && window.updateLikeUI) {
            window.updateLikeUI(window.likedQuotes.has(quoteId));
          }

          // Update header topic text (remove on scroll if topic is deviated in infinite scroll)
          updateHeaderTopicState(slide);

          // Update share context & background prepare 4:5 quote card image
          if (window.updateShareContext) {
            window.updateShareContext(slide);
          }
          if (window.prepareQuoteCardImage) {
            window.prepareQuoteCardImage(slide);
            const nextSlide = slide.nextElementSibling;
            if (nextSlide && nextSlide.classList && nextSlide.classList.contains('reel-slide')) {
              if ('requestIdleCallback' in window) {
                requestIdleCallback(() => window.prepareQuoteCardImage(nextSlide));
              } else {
                setTimeout(() => window.prepareQuoteCardImage(nextSlide), 350);
              }
            }
          }
        }
      });
    }, {
      root: container,
      threshold: 0.5,
    });

    // Helper: update header topic visibility when scrolling between matched and continuation quotes
    function updateHeaderTopicState(slide) {
      if (!slide) return;
      const isTopicMatch = slide.dataset.topicMatch !== 'false';
      const headerTitle = document.getElementById('feed-header-title');
      if (headerTitle && feedType !== 'master') {
        if (isTopicMatch) {
          headerTitle.classList.remove('opacity-0', 'pointer-events-none');
          headerTitle.classList.add('opacity-100');
          headerTitle.removeAttribute('aria-hidden');
        } else {
          headerTitle.classList.remove('opacity-100');
          headerTitle.classList.add('opacity-0', 'pointer-events-none');
          headerTitle.setAttribute('aria-hidden', 'true');
        }
      }
    }

    initialSlides.forEach(slide => observer.observe(slide));

    // Initialize first slide (target quote or freshly randomized top quote)
    if (initialSlides.length > 0) {
      const first = initialSlides[0];
      initialSlides.forEach(s => s.classList.remove('is-active'));
      first.classList.add('is-active');
      recordQuoteSeen(first.dataset.quoteId);
      updateHeaderTopicState(first);

      if (window.setBackground) {
        window.setBackground(first.dataset.videoSrc, first.dataset.gradientClass, first.dataset.mood, first.dataset.quoteId);
      }
      if (window.likedQuotes && window.updateLikeUI) {
        window.updateLikeUI(window.likedQuotes.has(first.dataset.quoteId));
      }
      if (window.updateShareContext) {
        window.updateShareContext(first);
      }
      if (window.prepareQuoteCardImage) {
        window.prepareQuoteCardImage(first);
        const second = initialSlides[1];
        if (second) {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(() => window.prepareQuoteCardImage(second));
          } else {
            setTimeout(() => window.prepareQuoteCardImage(second), 400);
          }
        }
      }
      if (window.wisdomAudio && first.dataset.mood) {
        window.wisdomAudio.setMood(first.dataset.mood);
        window.wisdomAudio.playOnce(first.dataset.mood);
      }

      // Sync URL hash with the first quote
      if (targetHash) {
        history.replaceState(null, '', `#${targetHash}`);
      } else if (first.dataset.quoteSlug) {
        history.replaceState(null, '', `#${first.dataset.quoteSlug}`);
      }
    }

    // ── Double-tap to Like ──
    container.onclick = (e) => {
      const zone = e.target.closest('[data-doubletap-zone]');
      if (!zone) return;

      const now = Date.now();
      const zoneId = zone.dataset.doubletapZone;

      if (now - lastTapTime < 380 && lastTapTarget === zoneId) {
        e.preventDefault();
        triggerDoubleTapLike(zoneId);
        lastTapTime = 0;
        lastTapTarget = null;
      } else {
        lastTapTime = now;
        lastTapTarget = zoneId;
      }
    };

    function triggerDoubleTapLike(quoteId) {
      if (window.likedQuotes) {
        if (!window.likedQuotes.has(quoteId)) {
          window.likedQuotes.toggle(quoteId);
          if (window.updateLikeUI) window.updateLikeUI(true);
        }
      }

      // Heart burst animation
      const overlay = document.getElementById('heart-burst-overlay');
      if (overlay) {
        overlay.style.display = 'flex';
        const svg = overlay.querySelector('svg');
        if (svg) {
          svg.style.animation = 'none';
          svg.offsetHeight; // force reflow
          svg.style.animation = 'heart-burst 0.65s var(--ease-spring) forwards';
        }
        setTimeout(() => { overlay.style.display = 'none'; }, 700);
      }
    }
  }

  document.addEventListener('DOMContentLoaded', setupReelFeed);
  document.addEventListener('astro:page-load', setupReelFeed);
</script>
