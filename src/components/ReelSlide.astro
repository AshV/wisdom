---
/**
 * ReelSlide — Individual quote slide for the vertical reel.
 *
 * Centered layout:
 * - Quote text centered vertically and horizontally
 * - Decorative quote mark, author attribution badge, category pill, mood badge, tag chips
 * - Data attributes for IntersectionObserver media switching
 */
import { getMediaForQuote, getAudioForMood, moodMeta } from '../data/mediaRegistry';
import type { Mood } from '../data/mediaRegistry';

interface Props {
  id: string;
  content: string;
  author: string;
  authorSlug: string;
  category: string;
  categorySlug: string;
  mood: Mood;
  tags: string[];
  index: number;
}

const { id, content, author, authorSlug, category, categorySlug, mood, tags, index } = Astro.props;

const media = getMediaForQuote(id, mood);
const audioSrc = getAudioForMood(mood);
const moodInfo = moodMeta[mood];
const BASE = '/wisdom';
---
<section
  class="reel-slide relative flex flex-col justify-center items-center px-6 md:px-16 lg:px-24 w-full h-[100dvh] text-center"
  id={`slide-${id}`}
  data-quote-id={id}
  data-content={content}
  data-author={author}
  data-video-src={media.video}
  data-gradient-class={media.gradient}
  data-mood={mood}
  data-audio-src={audioSrc}
  data-index={index}
>
  <!-- Double-tap detection zone -->
  <div
    class="absolute inset-0 z-10 cursor-pointer"
    data-doubletap-zone={id}
  ></div>

  <!-- Centered Quote Content Card -->
  <div class="relative z-20 max-w-3xl pointer-events-none flex flex-col items-center justify-center px-4 my-auto">
    <!-- Decorative Quote Mark Icon -->
    <div class="text-5xl md:text-7xl leading-none text-white/30 font-serif select-none mb-2">
      &ldquo;
    </div>

    <!-- Centered Quote Text -->
    <p class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-light leading-snug tracking-tight text-white text-shadow-quote mb-8 select-none quote-text">
      {content}
    </p>

    <!-- Author Attribution Badge -->
    <div class="mb-5 flex justify-center">
      <a
        href={`${BASE}/author/${authorSlug}/`}
        class="pointer-events-auto inline-flex items-center gap-2.5 text-sm md:text-base font-bold text-white/95 hover:text-white text-shadow-soft transition-all duration-200 hover:scale-105 group glass px-4 py-2 rounded-full border border-white/20 shadow-lg shadow-black/20"
      >
        <!-- Author avatar circle -->
        <span class="w-7 h-7 rounded-full bg-gradient-to-br from-accent-start to-accent-end flex items-center justify-center text-xs font-bold text-white shadow-sm">
          {author.charAt(0)}
        </span>
        <span class="author-name-text tracking-wide">{author}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="opacity-40 group-hover:opacity-100 transition-opacity">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </a>
    </div>

    <!-- Meta Row: Category + Mood Badges -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 mb-4">
      <!-- Category Pill -->
      <a
        href={`${BASE}/category/${categorySlug}/`}
        class="pointer-events-auto glass rounded-full px-4 py-1.5 text-xs font-semibold text-white/85 hover:text-white hover:bg-white/20 transition-all duration-200 shadow-sm"
      >
        {category}
      </a>

      <!-- Mood Badge -->
      <a
        href={`${BASE}/mood/${mood}/`}
        class={`pointer-events-auto mood-pill-${mood} rounded-full px-4 py-1.5 text-xs font-bold text-white hover:scale-105 transition-all duration-200 shadow-md shadow-black/20 flex items-center gap-1.5`}
      >
        <span>{moodInfo.emoji}</span>
        <span>{moodInfo.label}</span>
      </a>
    </div>

    <!-- Tag Chips -->
    <div class="flex flex-wrap items-center justify-center gap-2">
      {tags.map((tag) => (
        <a
          href={`${BASE}/tag/${tag}/`}
          class="pointer-events-auto text-xs font-medium text-white/60 hover:text-white transition-colors duration-200 bg-white/5 hover:bg-white/15 px-3 py-1 rounded-full backdrop-blur-sm border border-white/10"
        >
          #{tag}
        </a>
      ))}
    </div>
  </div>
</section>
