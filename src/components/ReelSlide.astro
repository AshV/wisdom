---
/**
 * ReelSlide — Individual quote slide for the vertical reel.
 *
 * Artistic Typography Engine:
 * - Font: 'Playfair Display' high-contrast editorial serif
 * - Adaptive space utilization: Font size scales fluidly based on quote length and viewport dimensions
 * - Perfect vertical & horizontal centering for the quote
 * - Bottom-docked metadata (Author, Category, Mood, Tags)
 * - Symmetrical clamp padding guarantees zero overlap with right rail buttons
 */
import { getMediaForQuote, getAudioForMood, moodMeta } from '../data/mediaRegistry';
import type { Mood } from '../data/mediaRegistry';
import { slugifyQuote } from '../utils/slug';

interface Props {
  id: string;
  content: string;
  author: string;
  authorSlug: string;
  category: string;
  categorySlug: string;
  mood: Mood;
  tags: string[];
  index: number;
  isStreamContinuation?: boolean;
}

const { id, content, author, authorSlug, category, categorySlug, mood, tags, index, isStreamContinuation = false } = Astro.props;

const media = getMediaForQuote(id, mood);
const audioSrc = getAudioForMood(mood);
const moodInfo = moodMeta[mood];
const BASE = '/wisdom';
const quoteSlug = slugifyQuote(content);

// Length-adaptive typography sizing: utilizes screen space dynamically
const len = content.length;
let quoteSizeStyle = '';
let maxContainerClass = '';

if (len < 55) {
  quoteSizeStyle = 'font-size: clamp(2.2rem, 5.5vw, 4.2rem); line-height: 1.18; max-width: 900px;';
  maxContainerClass = 'max-w-3xl';
} else if (len < 110) {
  quoteSizeStyle = 'font-size: clamp(1.75rem, 4.2vw, 3.1rem); line-height: 1.25; max-width: 950px;';
  maxContainerClass = 'max-w-4xl';
} else if (len < 180) {
  quoteSizeStyle = 'font-size: clamp(1.4rem, 3.2vw, 2.4rem); line-height: 1.32; max-width: 1000px;';
  maxContainerClass = 'max-w-4xl';
} else {
  quoteSizeStyle = 'font-size: clamp(1.2rem, 2.6vw, 1.95rem); line-height: 1.38; max-width: 1050px;';
  maxContainerClass = 'max-w-5xl';
}
---
<section
  id={`slide-${id}`}
  class="reel-slide relative z-10 w-full h-[100dvh] flex flex-col justify-between overflow-hidden select-none"
  data-quote-id={id}
  data-quote-slug={quoteSlug}
  data-content={content}
  data-author={author}
  data-video-src={media.video}
  data-gradient-class={media.gradient}
  data-mood={mood}
  data-category={category}
  data-audio-src={audioSrc}
  data-index={index}
>
  <!-- Double-tap detection zone across entire slide -->
  <div
    class="absolute inset-0 z-10 cursor-pointer"
    data-doubletap-zone={id}
  ></div>

  <!-- Top spacer to balance the fixed header bar (56px) -->
  <div class="h-14 sm:h-16 w-full shrink-0 pointer-events-none" aria-hidden="true"></div>

  {isStreamContinuation && (
    <div class="continuation-banner pointer-events-none absolute top-14 sm:top-16 z-30 left-1/2 -translate-x-1/2 flex items-center gap-2 glass px-4 py-1.5 rounded-full border border-white/20 text-[11px] font-medium text-white/90 shadow-xl shadow-black/40 select-none tracking-wider uppercase leading-normal">
      <span class="text-amber-300">✦</span>
      <span>More Wisdom Ahead</span>
    </div>
  )}

  <!-- ── CENTER OF SCREEN: ONLY THE QUOTE ── -->
  <!-- Wide, spacious canvas — action rail is positioned down in the bottom-right corner -->
  <div
    class="relative z-20 flex-1 flex flex-col items-center justify-center pointer-events-none text-center w-full my-auto"
    style="padding-right: clamp(1.75rem, 6vw, 4.5rem); padding-left: clamp(1.75rem, 6vw, 4.5rem);"
  >
    <div class={`${maxContainerClass} w-full flex flex-col items-center justify-center`}>
      <!-- Artistic Decorative Quote Mark -->
      <div class="text-4xl sm:text-5xl md:text-6xl leading-none text-white/30 font-serif select-none mb-3 font-display">
        &ldquo;
      </div>

      <!-- The Centered Artistic Quote Text -->
      <p
        class="font-display font-normal tracking-[-0.01em] text-white text-shadow-artistic select-none quote-text"
        style={`${quoteSizeStyle} font-family: 'Playfair Display', 'Cormorant Garamond', Georgia, serif;`}
      >
        {content}
      </p>

      <!-- Author Attribution Directly Below Quote (No initial circle) with one line space -->
      <div class="mt-7 sm:mt-9 select-none">
        <a
          href={`${BASE}/author/${authorSlug}/`}
          class="pointer-events-auto inline-flex items-center gap-1.5 text-base sm:text-lg md:text-xl font-normal text-white/80 hover:text-white transition-all duration-200 group cursor-pointer"
          style="font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; letter-spacing: 0.02em;"
          title={`More quotes by ${author}`}
        >
          <span class="text-white/40 not-italic font-light select-none">&mdash;</span>
          <span class="author-name-text group-hover:underline underline-offset-4 decoration-white/40 transition-all">{author}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- ── BOTTOM OF SCREEN: METADATA ONLY ── -->
  <!-- Anchored with generous bottom clearance for easy, comfortable tapping on mobile devices -->
  <div
    class="relative z-20 shrink-0 mb-6 sm:mb-8 md:mb-10 pb-[max(env(safe-area-inset-bottom,28px),44px)] pt-2 pointer-events-none"
    style="padding-right: clamp(4.5rem, 12vw, 6.5rem); padding-left: clamp(1.25rem, 4vw, 2.5rem);"
  >
    <div class="flex flex-col gap-2.5 w-full max-w-md md:max-w-lg">
      <!-- Meta Row: Category Pill + Mood Badge -->
      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href={`${BASE}/category/${categorySlug}/`}
          class="pointer-events-auto glass rounded-full px-4.5 py-1.5 text-xs font-medium text-white/90 hover:text-white hover:bg-white/20 transition-all duration-200 shadow-sm whitespace-nowrap inline-flex items-center leading-normal"
        >
          {category}
        </a>

        <a
          href={`${BASE}/mood/${mood}/`}
          class={`pointer-events-auto mood-pill-${mood} rounded-full px-5 py-1.5 text-xs font-semibold text-white hover:scale-105 transition-all duration-200 shadow-md shadow-black/20 inline-flex items-center gap-2 whitespace-nowrap shrink-0 leading-normal`}
        >
          <span class="shrink-0 text-sm leading-none">{moodInfo.emoji}</span>
          <span class="whitespace-nowrap tracking-wide leading-normal">{moodInfo.label}</span>
        </a>
      </div>

      <!-- Tag Chips with generous tap targets and safe bottom clearance -->
      <div class="flex flex-wrap gap-2 pt-0.5">
        {tags.map((tag) => (
          <a
            href={`${BASE}/tag/${tag}/`}
            class="pointer-events-auto text-xs font-medium text-white/75 hover:text-white transition-colors duration-200 bg-white/10 hover:bg-white/20 active:scale-95 px-4 py-1.5 rounded-full backdrop-blur-sm border border-white/15 cursor-pointer shadow-sm inline-flex items-center leading-normal"
          >
            #{tag}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
