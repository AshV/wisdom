---
/**
 * ReelSlide — Individual quote slide for the vertical reel.
 *
 * Layout requirements:
 * 1. ONLY quote in the center of the screen (vertically & horizontally centered)
 * 2. Rest of the metadata (Author, Category, Mood, Tags) at the bottom of the screen
 * 3. Dedicated safe right padding guarantees buttons NEVER overlap the quote or metadata
 */
import { getMediaForQuote, getAudioForMood, moodMeta } from '../data/mediaRegistry';
import type { Mood } from '../data/mediaRegistry';

interface Props {
  id: string;
  content: string;
  author: string;
  authorSlug: string;
  category: string;
  categorySlug: string;
  mood: Mood;
  tags: string[];
  index: number;
}

const { id, content, author, authorSlug, category, categorySlug, mood, tags, index } = Astro.props;

const media = getMediaForQuote(id, mood);
const audioSrc = getAudioForMood(mood);
const moodInfo = moodMeta[mood];
const BASE = '/wisdom';
---
<section
  class="reel-slide relative flex flex-col justify-between w-full h-[100dvh] overflow-hidden select-none"
  id={`slide-${id}`}
  data-quote-id={id}
  data-content={content}
  data-author={author}
  data-video-src={media.video}
  data-gradient-class={media.gradient}
  data-mood={mood}
  data-audio-src={audioSrc}
  data-index={index}
>
  <!-- Double-tap detection zone across entire slide -->
  <div
    class="absolute inset-0 z-10 cursor-pointer"
    data-doubletap-zone={id}
  ></div>

  <!-- Top spacer to balance the fixed header bar (56px) -->
  <div class="h-14 sm:h-16 w-full shrink-0 pointer-events-none" aria-hidden="true"></div>

  <!-- ── CENTER OF SCREEN: ONLY THE QUOTE ── -->
  <!-- Equal left and right clamp padding guarantees true visual center and ZERO overlap with action rail -->
  <div
    class="relative z-20 flex-1 flex flex-col items-center justify-center pointer-events-none text-center w-full my-auto"
    style="padding-right: clamp(5.5rem, 14vw, 8.5rem); padding-left: clamp(5.5rem, 14vw, 8.5rem);"
  >
    <div class="max-w-lg md:max-w-xl w-full flex flex-col items-center justify-center">
      <!-- Decorative Quote Mark -->
      <div class="text-4xl sm:text-5xl md:text-6xl leading-none text-white/30 font-serif select-none mb-3">
        &ldquo;
      </div>

      <!-- The Centered Quote Text -->
      <p class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-light leading-relaxed tracking-tight text-white text-shadow-quote select-none quote-text">
        {content}
      </p>
    </div>
  </div>

  <!-- ── BOTTOM OF SCREEN: METADATA ONLY ── -->
  <!-- Anchored to bottom with safe right clearance -->
  <div
    class="relative z-20 shrink-0 pb-[max(env(safe-area-inset-bottom,20px),20px)] pt-3 pointer-events-none"
    style="padding-right: clamp(5rem, 12vw, 7rem); padding-left: clamp(1.25rem, 5vw, 3.5rem);"
  >
    <div class="flex flex-col gap-2.5 max-w-lg">
      <!-- Author Attribution Badge -->
      <div class="flex items-center">
        <a
          href={`${BASE}/author/${authorSlug}/`}
          class="pointer-events-auto inline-flex items-center gap-2 text-sm md:text-base font-bold text-white/95 hover:text-white text-shadow-soft transition-all duration-200 hover:scale-105 group glass px-3.5 py-1.5 rounded-full border border-white/20 shadow-lg shadow-black/20"
        >
          <span class="w-6 h-6 rounded-full bg-gradient-to-br from-accent-start to-accent-end flex items-center justify-center text-[11px] font-bold text-white shadow-sm">
            {author.charAt(0)}
          </span>
          <span class="author-name-text tracking-wide">{author}</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="opacity-40 group-hover:opacity-100 transition-opacity">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      </div>

      <!-- Meta Row: Category Pill + Mood Badge -->
      <div class="flex flex-wrap items-center gap-2">
        <a
          href={`${BASE}/category/${categorySlug}/`}
          class="pointer-events-auto glass rounded-full px-3 py-1 text-xs font-semibold text-white/85 hover:text-white hover:bg-white/20 transition-all duration-200 shadow-sm"
        >
          {category}
        </a>

        <a
          href={`${BASE}/mood/${mood}/`}
          class={`pointer-events-auto mood-pill-${mood} rounded-full px-3 py-1 text-xs font-bold text-white hover:scale-105 transition-all duration-200 shadow-md shadow-black/20 flex items-center gap-1.5`}
        >
          <span>{moodInfo.emoji}</span>
          <span>{moodInfo.label}</span>
        </a>
      </div>

      <!-- Tag Chips -->
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <a
            href={`${BASE}/tag/${tag}/`}
            class="pointer-events-auto text-[11px] font-medium text-white/60 hover:text-white transition-colors duration-200 bg-white/5 hover:bg-white/15 px-2.5 py-0.5 rounded-full backdrop-blur-sm border border-white/10"
          >
            #{tag}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
