---
/**
 * RightActionRail — Vertical icon stack on the right edge.
 *
 * Buttons: Like, Share, Audio Toggle, Explore.
 * All icons are inline SVG for zero external dependencies.
 */
---
<div
  id="right-action-rail"
  class="fixed right-3 sm:right-4 md:right-5 bottom-[max(env(safe-area-inset-bottom,28px),40px)] mb-4 sm:mb-6 z-30 flex flex-col items-center gap-2.5 sm:gap-3"
>
  <!-- Like Button -->
  <button
    id="like-btn"
    class="group transition-transform duration-200 active:scale-90 cursor-pointer block"
    aria-label="Like this quote"
    title="Like"
  >
    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full glass flex items-center justify-center group-hover:bg-white/20 transition-all duration-200 shadow-md shadow-black/30">
      <svg id="like-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white transition-all duration-300 sm:w-5 sm:h-5">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
      </svg>
    </div>
  </button>

  <!-- Share Button -->
  <button
    id="share-btn"
    class="group transition-transform duration-200 active:scale-90 cursor-pointer block"
    aria-label="Share this quote"
    title="Share"
  >
    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full glass flex items-center justify-center group-hover:bg-white/20 transition-all duration-200 shadow-md shadow-black/30">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white sm:w-[19px] sm:h-[19px]">
        <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
        <polyline points="16 6 12 2 8 6" />
        <line x1="12" y1="2" x2="12" y2="15" />
      </svg>
    </div>
  </button>

  <!-- Zen Chime Toggle (Play Once on Quote Arrival) -->
  <button
    id="audio-toggle-btn"
    class="group transition-transform duration-200 active:scale-90 cursor-pointer block"
    aria-label="Enable zen chime sound"
    title="Chimes Muted (Click to enable)"
  >
    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full glass flex items-center justify-center transition-all duration-200 shadow-md shadow-black/30 bg-white/5 border border-white/10 text-white/40 group-hover:bg-white/15 group-hover:text-white/70">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white/50 sm:w-[19px] sm:h-[19px]">
        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        <line x1="2" y1="2" x2="22" y2="22" stroke="currentColor" stroke-width="2"/>
      </svg>
    </div>
  </button>

  <!-- Delve into Meaning Button -->
  <button
    id="delve-rail-btn"
    class="group transition-transform duration-200 active:scale-90 cursor-pointer block"
    aria-label="Delve into quote explanation and meaning"
    title="Delve into Meaning"
  >
    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full glass flex items-center justify-center group-hover:bg-amber-400/25 group-hover:border-amber-400/50 transition-all duration-200 shadow-md shadow-black/30 text-amber-300/90 group-hover:text-amber-100">
      <span class="text-sm font-serif select-none leading-none">✦</span>
    </div>
  </button>

  <!-- Explore Button -->
  <button
    id="explore-btn"
    class="group transition-transform duration-200 active:scale-90 cursor-pointer block"
    aria-label="Explore quotes"
    title="Explore Quotes"
  >
    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full glass flex items-center justify-center group-hover:bg-white/20 transition-all duration-200 shadow-md shadow-black/30">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white sm:w-[19px] sm:h-[19px]">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
    </div>
  </button>
</div>

<script is:inline>
  function setupRightRail() {
    const likeBtn = document.getElementById('like-btn');
    const shareBtn = document.getElementById('share-btn');
    const audioBtn = document.getElementById('audio-toggle-btn');
    const exploreBtn = document.getElementById('explore-btn');

    if (likeBtn) {
      likeBtn.onclick = () => {
        const activeSlide = document.querySelector('.reel-slide.is-active') || document.querySelector('.reel-slide');
        if (!activeSlide) return;
        const quoteId = activeSlide.dataset.quoteId;
        const quoteObj = {
          id: quoteId,
          content: activeSlide.dataset.content || activeSlide.querySelector('blockquote p')?.textContent?.trim() || '',
          author: activeSlide.dataset.author || '',
          authorSlug: activeSlide.dataset.authorSlug || '',
          category: activeSlide.dataset.category || '',
          categorySlug: activeSlide.dataset.categorySlug || '',
          mood: activeSlide.dataset.mood || '',
          slug: activeSlide.dataset.quoteSlug || quoteId,
        };
        const isLiked = window.likedQuotes.toggle(quoteObj);
        updateLikeUI(isLiked);
        if (window.refreshExploreLikes) window.refreshExploreLikes();
      };
    }

    if (shareBtn) {
      shareBtn.onclick = () => {
        const modal = document.getElementById('share-modal');
        if (modal) {
          modal.classList.remove('hidden');
          modal.style.display = 'flex';
          const activeSlide = document.querySelector('.reel-slide.is-active') || document.querySelector('.reel-slide');
          if (window.updateShareContext && activeSlide) {
            window.updateShareContext(activeSlide, true);
          }
        }
      };
    }

    const delveBtn = document.getElementById('delve-rail-btn');

    if (delveBtn) {
      delveBtn.onclick = () => {
        const activeSlide = document.querySelector('.reel-slide.is-active') || document.querySelector('.reel-slide');
        if (activeSlide && window.openQuoteDelveModal) {
          window.openQuoteDelveModal({
            id: activeSlide.dataset.quoteId,
            content: activeSlide.dataset.content || activeSlide.querySelector('.quote-text')?.textContent?.trim(),
            author: activeSlide.dataset.author,
            authorSlug: activeSlide.dataset.authorSlug,
            sourceWork: activeSlide.dataset.sourceWork,
            explanation: activeSlide.dataset.explanation || activeSlide.dataset.story,
            practicalInsight: activeSlide.dataset.practicalInsight,
            reflectionPrompt: activeSlide.dataset.reflectionPrompt,
          });
        }
      };
    }

    if (exploreBtn) {
      exploreBtn.onclick = () => {
        if (window.openExploreDrawer) {
          window.openExploreDrawer();
        } else {
          const drawer = document.getElementById('explore-drawer');
          if (drawer) {
            drawer.classList.remove('hidden');
            drawer.style.display = 'flex';
          }
        }
      };
    }

    // Refresh like status for the currently active slide
    const activeSlide = document.querySelector('.reel-slide.is-active') || document.querySelector('.reel-slide');
    if (activeSlide && window.likedQuotes) {
      updateLikeUI(window.likedQuotes.has(activeSlide.dataset.quoteId));
    }
  }

  function updateLikeUI(isLiked) {
    const icon = document.getElementById('like-icon');
    const label = document.getElementById('like-count');
    if (!icon) return;
    if (isLiked) {
      icon.setAttribute('fill', '#ef4444');
      icon.setAttribute('stroke', '#ef4444');
      icon.style.transform = 'scale(1.2)';
      setTimeout(() => { icon.style.transform = 'scale(1)'; }, 200);
      if (label) label.textContent = 'Liked';
    } else {
      icon.setAttribute('fill', 'none');
      icon.setAttribute('stroke', 'currentColor');
      if (label) label.textContent = 'Like';
    }
  }

  window.updateLikeUI = updateLikeUI;

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupRightRail);
  } else {
    setupRightRail();
  }
  document.addEventListener('astro:page-load', setupRightRail);
</script>
