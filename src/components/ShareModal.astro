---
/**
 * ShareModal — Share overlay with 4:5 (1080×1350) HD quote card pre-generation and native file sharing.
 *
 * Key Capabilities:
 * 1. Background Pre-Generation: Canvas 2D renders 1080×1350 4:5 quote card in ~15ms in background
 * 2. In-Memory Cache: Pre-rendered { blob, file, dataUrl, objectUrl } stored per quote ID
 * 3. Native Web Share API with Files: Opens OS native share sheet directly with PNG attached (Instagram Stories, WhatsApp, etc.)
 * 4. Clipboard Image Copy: navigator.clipboard.write allows instant pasting on desktop without downloading
 * 5. Instant PNG Download: 1080×1350 PNG saved directly from pre-generated blob
 * 6. Live 4:5 Card Preview: Visual card thumbnail showing the ready-to-share graphic
 */
---

<div
  id="share-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center"
  style="display: none;"
>
  <!-- Backdrop -->
  <div id="share-backdrop" class="absolute inset-0 bg-black/80 backdrop-blur-md transition-opacity"></div>

  <!-- Modal Content -->
  <div class="relative z-10 glass-heavy rounded-3xl p-5 mx-4 max-w-[340px] w-full animate-slide-up overflow-hidden shadow-2xl border border-white/15">
    <!-- Header -->
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-base font-bold text-white tracking-wide">Share Quote</h3>
      <button
        id="share-close-btn"
        class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors text-white/80 hover:text-white cursor-pointer"
        aria-label="Close share modal"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <!-- Visual Card Preview (Hero) -->
    <div class="relative mb-5 flex flex-col items-center">
      <div class="relative w-44 aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl shadow-black/60 border border-white/20 bg-black/40 flex items-center justify-center">
        <!-- Ambient glow behind preview card -->
        <div id="share-preview-glow" class="absolute -inset-2 rounded-2xl bg-gradient-to-r from-purple-500/25 to-pink-500/25 blur-xl opacity-70 pointer-events-none"></div>

        <img
          id="share-preview-image"
          src=""
          alt="Quote Card Preview"
          class="w-full h-full object-cover transition-opacity duration-300 opacity-0 relative z-10"
        />

        <!-- Loading spinner while card finishes rendering -->
        <div id="share-preview-loader" class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-black/60 p-2 text-center transition-opacity z-20">
          <div class="w-6 h-6 rounded-full border-2 border-white/80 border-t-transparent animate-spin"></div>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="space-y-2.5">
      <!-- 1. Primary Action: Share Image -->
      <button
        id="share-image-btn"
        class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-semibold text-sm flex items-center justify-center gap-2 transition-all duration-200 cursor-pointer shadow-lg shadow-purple-900/30 active:scale-[0.98] leading-normal"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
          <polyline points="16 6 12 2 8 6" />
          <line x1="12" y1="2" x2="12" y2="15" />
        </svg>
        <span>Share Image</span>
      </button>

      <!-- 2. Secondary Quick Actions Row: Copy Image | Save PNG | Copy Link -->
      <div class="grid grid-cols-3 gap-2">
        <!-- Copy Image to Clipboard -->
        <button
          id="copy-image-btn"
          class="flex flex-col items-center justify-center gap-1.5 py-3 px-2 rounded-xl glass hover:bg-white/10 active:scale-95 transition-all text-white/85 hover:text-white cursor-pointer"
          title="Copy image to clipboard"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span class="text-[11px] font-medium leading-normal text-center">Copy Image</span>
        </button>

        <!-- Save PNG -->
        <button
          id="download-image-btn"
          class="flex flex-col items-center justify-center gap-1.5 py-3 px-2 rounded-xl glass hover:bg-white/10 active:scale-95 transition-all text-white/85 hover:text-white cursor-pointer"
          title="Download PNG image"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span class="text-[11px] font-medium leading-normal text-center">Save PNG</span>
        </button>

        <!-- Copy Link -->
        <button
          id="share-link-btn"
          class="flex flex-col items-center justify-center gap-1.5 py-3 px-2 rounded-xl glass hover:bg-white/10 active:scale-95 transition-all text-white/85 hover:text-white cursor-pointer"
          title="Share or copy quote link"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
          <span class="text-[11px] font-medium leading-normal text-center">Copy Link</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // ── High-Performance Canvas 2D 4:5 Quote Card Generator ──
  // Renders a stunning 1080×1350 (4:5) image matching the exact visual style, colors, and live ambient background shown on screen.
  function renderQuoteCard4x5(quote) {
    const width = 1080;
    const height = 1350;
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d');
    if (!ctx) return null;

    const content = quote.content || '';
    const author = quote.author || 'Anonymous';
    const mood = quote.mood || 'reflective';
    const category = quote.category || 'Wisdom';

    // Helper: Rounded Rectangle Fallback
    function drawRoundRect(c, x, y, w, h, r) {
      if (typeof c.roundRect === 'function') {
        c.roundRect(x, y, w, h, r);
      } else {
        c.moveTo(x + r, y);
        c.arcTo(x + w, y, x + w, y + h, r);
        c.arcTo(x + w, y + h, x, y + h, r);
        c.arcTo(x, y + h, x, y, r);
        c.arcTo(x, y, x + w, y, r);
      }
    }

    const moodInfoMap = {
      reflective: { label: 'Reflective', emoji: '🌙', colors: ['#6366f1', '#818cf8'] },
      motivational: { label: 'Motivational', emoji: '🔥', colors: ['#f59e0b', '#fbbf24'] },
      serene: { label: 'Serene', emoji: '🌊', colors: ['#06b6d4', '#22d3ee'] },
      bold: { label: 'Bold', emoji: '⚡', colors: ['#ef4444', '#f87171'] },
      melancholic: { label: 'Melancholic', emoji: '🌧️', colors: ['#8b5cf6', '#a78bfa'] },
      joyful: { label: 'Joyful', emoji: '✨', colors: ['#10b981', '#34d399'] },
      philosophical: { label: 'Philosophical', emoji: '🤔', colors: ['#6366f1', '#818cf8'] },
      romantic: { label: 'Romantic', emoji: '💜', colors: ['#ec4899', '#f472b6'] },
    };
    const moodInfo = moodInfoMap[mood] || moodInfoMap.reflective;

    // ── 1. Live Screen Background Canvas Snapshot ──
    const ambientCanvas = document.getElementById('ambient-canvas');
    let hasDrawnCanvas = false;

    if (ambientCanvas && ambientCanvas.width > 0 && ambientCanvas.height > 0) {
      try {
        const cw = ambientCanvas.width;
        const ch = ambientCanvas.height;
        const targetRatio = width / height; // 1080 / 1350 = 0.8
        const srcRatio = cw / ch;

        let sx = 0, sy = 0, sw = cw, sh = ch;
        if (srcRatio > targetRatio) {
          sw = ch * targetRatio;
          sx = (cw - sw) / 2;
        } else {
          sh = cw / targetRatio;
          sy = (ch - sh) / 2;
        }

        ctx.drawImage(ambientCanvas, sx, sy, sw, sh, 0, 0, width, height);
        hasDrawnCanvas = true;
      } catch (err) {
        console.warn('Live canvas snapshot fallback:', err);
      }
    }

    // Fallback if ambient-canvas was not yet painted:
    if (!hasDrawnCanvas) {
      const activePalette = (window.wisdomBackground && window.wisdomBackground.getCurrentPalette && window.wisdomBackground.getCurrentPalette()) || null;
      const bgTop = activePalette ? `rgb(${activePalette.bgTop.join(',')})` : '#0b0f19';
      const bgMid = activePalette ? `rgb(${activePalette.bgMid.join(',')})` : '#1e1b4b';
      const bgBottom = activePalette ? `rgb(${activePalette.bgBottom.join(',')})` : '#05070e';

      const baseGrad = ctx.createLinearGradient(0, 0, 0, height);
      baseGrad.addColorStop(0, bgTop);
      baseGrad.addColorStop(0.5, bgMid);
      baseGrad.addColorStop(1, bgBottom);
      ctx.fillStyle = baseGrad;
      ctx.fillRect(0, 0, width, height);

      if (activePalette && activePalette.colors) {
        const c1 = activePalette.colors[0];
        const r1 = ctx.createRadialGradient(width * 0.35, height * 0.35, 0, width * 0.35, height * 0.35, width * 0.7);
        r1.addColorStop(0, `rgba(${c1[0]}, ${c1[1]}, ${c1[2]}, 0.28)`);
        r1.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = r1;
        ctx.fillRect(0, 0, width, height);
      }
    }

    // ── 2. Atmospheric Soft Light Bloom Overlays (Matching Screen Glows) ──
    const activePalette = (window.wisdomBackground && window.wisdomBackground.getCurrentPalette && window.wisdomBackground.getCurrentPalette()) || null;
    const glow1 = activePalette?.glow1 || 'rgba(123, 44, 191, 0.45)';
    const glow2 = activePalette?.glow2 || 'rgba(0, 245, 212, 0.40)';
    const glowCenter = activePalette?.glowCenter || 'rgba(167, 139, 250, 0.25)';

    // Glow 1: Top-Left
    const g1 = ctx.createRadialGradient(width * 0.05, height * 0.05, 0, width * 0.05, height * 0.05, width * 0.75);
    g1.addColorStop(0, glow1);
    g1.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = g1;
    ctx.fillRect(0, 0, width, height);

    // Glow 2: Bottom-Right
    const g2 = ctx.createRadialGradient(width * 0.95, height * 0.95, 0, width * 0.95, height * 0.95, width * 0.80);
    g2.addColorStop(0, glow2);
    g2.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = g2;
    ctx.fillRect(0, 0, width, height);

    // Glow Center: Soft ambient illumination
    const gc = ctx.createRadialGradient(width * 0.5, height * 0.48, 0, width * 0.5, height * 0.48, width * 0.55);
    gc.addColorStop(0, glowCenter);
    gc.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = gc;
    ctx.fillRect(0, 0, width, height);

    // ── 3. Screen Vignette (from-black/85 via-black/40 to-black/70) ──
    const vignette = ctx.createLinearGradient(0, height, 0, 0); // bottom to top
    vignette.addColorStop(0, 'rgba(0, 0, 0, 0.88)');    // bottom: protects badges & branding
    vignette.addColorStop(0.35, 'rgba(0, 0, 0, 0.50)');
    vignette.addColorStop(0.65, 'rgba(0, 0, 0, 0.42)');
    vignette.addColorStop(1, 'rgba(0, 0, 0, 0.72)');    // top: protects header
    ctx.fillStyle = vignette;
    ctx.fillRect(0, 0, width, height);

    // ── 4. Editorial Inner Border Frame (Inset 40px, rounded 24px) ──
    const inset = 40;
    const radius = 24;
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    drawRoundRect(ctx, inset, inset, width - inset * 2, height - inset * 2, radius);
    ctx.stroke();

    // ── 5. Minimalist Screen Header Bar (Matching Top Screen Bar) ──
    const topY = 88;

    // Emerald Active Dot
    ctx.save();
    ctx.fillStyle = '#10b981';
    ctx.shadowColor = 'rgba(16, 185, 129, 0.85)';
    ctx.shadowBlur = 12;
    ctx.beginPath();
    ctx.arc(inset + 32, topY, 4.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();

    // Brand Title "WISDOM"
    ctx.save();
    ctx.fillStyle = 'rgba(255, 255, 255, 0.90)';
    ctx.font = '700 14px "Inter", -apple-system, sans-serif';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    if ('letterSpacing' in ctx) ctx.letterSpacing = '3px';
    ctx.fillText('WISDOM', inset + 46, topY);
    ctx.restore();

    // Header Right: "TIMELESS WISDOM"
    ctx.save();
    ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
    ctx.font = '500 13px "Inter", -apple-system, sans-serif';
    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    if ('letterSpacing' in ctx) ctx.letterSpacing = '2px';
    ctx.fillText('TIMELESS WISDOM', width - inset - 32, topY);
    ctx.restore();

    // ── 6. Typography Engine (Matching Screen Font & Artistic Shadows) ──
    const len = content.length;
    let fontSize = 54;
    let lineHeight = 76;

    if (len < 65) {
      fontSize = 64;
      lineHeight = 90;
    } else if (len < 130) {
      fontSize = 54;
      lineHeight = 76;
    } else if (len < 200) {
      fontSize = 44;
      lineHeight = 62;
    } else {
      fontSize = 36;
      lineHeight = 52;
    }

    ctx.font = `400 ${fontSize}px "Playfair Display", "Cormorant Garamond", Georgia, serif`;
    const maxTextWidth = 860;
    const words = content.split(/\s+/);
    const lines = [];
    let curLine = '';

    for (let i = 0; i < words.length; i++) {
      const test = curLine ? curLine + ' ' + words[i] : words[i];
      const m = ctx.measureText(test);
      if (m.width > maxTextWidth && curLine) {
        lines.push(curLine);
        curLine = words[i];
      } else {
        curLine = test;
      }
    }
    if (curLine) lines.push(curLine);

    const quoteMarkHeight = 56;
    const quoteMarkGap = 20;
    const totalQuoteTextHeight = lines.length * lineHeight;
    const authorGap = lineHeight; // Exactly one line space below quote
    const authorHeight = 40;
    const totalBlockHeight = quoteMarkHeight + quoteMarkGap + totalQuoteTextHeight + authorGap + authorHeight;

    // Center quote block comfortably in viewport
    let blockStartY = (height - totalBlockHeight) / 2 - 25;
    if (blockStartY < 170) blockStartY = 170;

    // Decorative Quotation Mark (Playfair Display, delicate white/35)
    const quoteMarkY = blockStartY + (quoteMarkHeight / 2);
    ctx.save();
    ctx.fillStyle = 'rgba(255, 255, 255, 0.35)';
    ctx.font = 'italic 400 84px "Playfair Display", Georgia, serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('“', width / 2, quoteMarkY);
    ctx.restore();

    // Quote Text Lines (Crisp white with multi-layered artistic text shadows)
    const quoteStartY = blockStartY + quoteMarkHeight + quoteMarkGap;
    ctx.save();
    ctx.font = `400 ${fontSize}px "Playfair Display", "Cormorant Garamond", Georgia, serif`;
    ctx.fillStyle = '#ffffff';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.shadowColor = 'rgba(0, 0, 0, 0.95)';
    ctx.shadowBlur = 32;
    ctx.shadowOffsetY = 4;

    for (let i = 0; i < lines.length; i++) {
      ctx.fillText(lines[i], width / 2, quoteStartY + (i * lineHeight) + (lineHeight / 2));
    }
    ctx.restore();

    // Author Attribution (Italic Serif, Original Case, Exactly 1 Line Space Below Quote)
    const authorY = quoteStartY + totalQuoteTextHeight + authorGap;
    ctx.save();
    ctx.fillStyle = 'rgba(255, 255, 255, 0.90)';
    ctx.font = 'italic 400 34px "Cormorant Garamond", "Playfair Display", Georgia, serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    if ('letterSpacing' in ctx) ctx.letterSpacing = '1.5px';
    ctx.shadowColor = 'rgba(0, 0, 0, 0.75)';
    ctx.shadowBlur = 14;
    ctx.shadowOffsetY = 2;
    ctx.fillText(`— ${author}`, width / 2, authorY);
    ctx.restore();

    // ── 7. Screen Category & Mood Pills (Exact Replica of Screen UI) ──
    const pillsY = 1120;
    const pillHeight = 46;
    const pillRadius = 23;

    // Category pill calculation
    const categoryText = category;
    ctx.font = '500 17px "Inter", -apple-system, sans-serif';
    const catMetrics = ctx.measureText(categoryText);
    const catPillWidth = catMetrics.width + 48;

    // Mood badge calculation
    ctx.font = '600 17px "Inter", -apple-system, sans-serif';
    const moodMetrics = ctx.measureText(`${moodInfo.emoji}  ${moodInfo.label}`);
    const moodPillWidth = moodMetrics.width + 48;

    const gap = 16;
    const totalPillsWidth = catPillWidth + gap + moodPillWidth;
    const pillsStartX = (width - totalPillsWidth) / 2;

    // Draw Category Pill (Glass Rounded Full)
    const catX = pillsStartX;
    ctx.save();
    ctx.fillStyle = 'rgba(255, 255, 255, 0.10)';
    ctx.beginPath();
    drawRoundRect(ctx, catX, pillsY, catPillWidth, pillHeight, pillRadius);
    ctx.fill();
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.18)';
    ctx.lineWidth = 1;
    ctx.stroke();

    ctx.fillStyle = 'rgba(255, 255, 255, 0.90)';
    ctx.font = '500 17px "Inter", -apple-system, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(categoryText, catX + catPillWidth / 2, pillsY + pillHeight / 2);
    ctx.restore();

    // Draw Mood Badge (Tailored Mood Gradient Pill)
    const moodX = catX + catPillWidth + gap;
    const moodGradColors = moodInfo.colors;
    ctx.save();
    const mGrad = ctx.createLinearGradient(moodX, pillsY, moodX + moodPillWidth, pillsY + pillHeight);
    mGrad.addColorStop(0, moodGradColors[0]);
    mGrad.addColorStop(1, moodGradColors[1]);
    ctx.fillStyle = mGrad;
    ctx.shadowColor = 'rgba(0, 0, 0, 0.40)';
    ctx.shadowBlur = 12;
    ctx.shadowOffsetY = 3;
    ctx.beginPath();
    drawRoundRect(ctx, moodX, pillsY, moodPillWidth, pillHeight, pillRadius);
    ctx.fill();
    ctx.restore();

    // Mood Badge Text + Emoji
    ctx.save();
    ctx.fillStyle = '#ffffff';
    ctx.font = '600 16px "Inter", -apple-system, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(`${moodInfo.emoji}  ${moodInfo.label}`, moodX + moodPillWidth / 2, pillsY + pillHeight / 2);
    ctx.restore();

    // ── 8. Footer Domain Watermark ──
    ctx.save();
    ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
    ctx.font = '500 15px "Inter", -apple-system, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    if ('letterSpacing' in ctx) ctx.letterSpacing = '3px';
    ctx.fillText('ashishvishwakarma.com/wisdom', width / 2, 1265);
    ctx.restore();

    return canvas;
  }

  // ── In-Memory Pre-Rendered Cache ──
  window.quoteCardCache = window.quoteCardCache || new Map();
  window.quoteCardPromises = window.quoteCardPromises || new Map();

  // ── Background Quote Image Pre-Generation Engine ──
  window.prepareQuoteCardImage = async function(slideOrData, forceFresh = false) {
    if (!slideOrData) return null;

    let id = '';
    let slug = '';
    let content = '';
    let author = '';
    let mood = '';
    let category = '';

    if (slideOrData instanceof HTMLElement) {
      id = slideOrData.dataset.quoteId || '';
      slug = slideOrData.dataset.quoteSlug || id;
      content = slideOrData.dataset.content || (slideOrData.querySelector('.quote-text')?.textContent.trim() || '');
      author = slideOrData.dataset.author || (slideOrData.querySelector('.author-name-text')?.textContent.trim() || '');
      mood = slideOrData.dataset.mood || 'reflective';
      category = slideOrData.dataset.category || (slideOrData.querySelector('.glass.rounded-full')?.textContent.trim() || 'Wisdom');
    } else {
      id = slideOrData.id || '';
      slug = slideOrData.slug || id;
      content = slideOrData.content || '';
      author = slideOrData.author || '';
      mood = slideOrData.mood || 'reflective';
      category = slideOrData.category || 'Wisdom';
    }

    if (!id || !content) return null;

    // Return if already prepared in cache and fresh generation not requested
    if (!forceFresh && window.quoteCardCache.has(id)) {
      return window.quoteCardCache.get(id);
    }

    // Return active promise if already generating
    if (!forceFresh && window.quoteCardPromises.has(id)) {
      return window.quoteCardPromises.get(id);
    }

    const genPromise = (async () => {
      try {
        // Ensure web fonts are ready so Playfair & Cormorant render crisply
        if (document.fonts && document.fonts.ready) {
          await document.fonts.ready;
        }

        const canvas = renderQuoteCard4x5({ id, content, author, mood, category, slug });
        if (!canvas) return null;

        const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
        if (!blob) return null;

        const file = new File([blob], `wisdom-${id}-4x5.png`, { type: 'image/png' });
        const objectUrl = URL.createObjectURL(blob);
        const dataUrl = canvas.toDataURL('image/png');

        const entry = {
          id,
          slug,
          content,
          author,
          mood,
          category,
          blob,
          file,
          objectUrl,
          dataUrl,
          width: 1080,
          height: 1350,
        };

        window.quoteCardCache.set(id, entry);

        // Update modal UI if currently active quote matches
        if (window._currentActiveQuoteId === id) {
          updateModalPreviewUI(entry);
        }

        return entry;
      } catch (err) {
        console.warn('Quote card generation error:', err);
        return null;
      } finally {
        window.quoteCardPromises.delete(id);
      }
    })();

    window.quoteCardPromises.set(id, genPromise);
    return genPromise;
  };

  // Helper: Update modal preview when image is ready
  function updateModalPreviewUI(entry) {
    const previewImg = document.getElementById('share-preview-image');
    const previewLoader = document.getElementById('share-preview-loader');

    if (previewImg && entry && entry.objectUrl) {
      previewImg.src = entry.objectUrl;
      previewImg.classList.remove('opacity-0');
      if (previewLoader) previewLoader.classList.add('opacity-0', 'pointer-events-none');
    }
  }

  // ── Share Modal Controller ──
  function setupShareModal() {
    const modal = document.getElementById('share-modal');
    const backdrop = document.getElementById('share-backdrop');
    const closeBtn = document.getElementById('share-close-btn');
    const linkBtn = document.getElementById('share-link-btn');
    const imageBtn = document.getElementById('share-image-btn');
    const copyImageBtn = document.getElementById('copy-image-btn');
    const downloadImageBtn = document.getElementById('download-image-btn');

    let currentQuoteId = '';
    let currentQuoteSlug = '';
    let currentQuoteText = '';
    let currentAuthor = '';
    let currentMood = '';
    let currentCategory = '';

    function closeModal() {
      if (modal) {
        modal.style.display = 'none';
        modal.classList.add('hidden');
      }
    }

    if (backdrop) backdrop.addEventListener('click', closeModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    // ESC key closes modal
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.style.display !== 'none') {
        closeModal();
      }
    });

    // Update share context whenever active slide changes
    window.updateShareContext = function(slide, isOpeningModal = false) {
      if (!slide) return;
      currentQuoteId = slide.dataset.quoteId || '';
      currentQuoteSlug = slide.dataset.quoteSlug || currentQuoteId;
      currentMood = slide.dataset.mood || 'reflective';
      currentCategory = slide.dataset.category || (slide.querySelector('.glass.rounded-full')?.textContent.trim() || 'Wisdom');
      currentQuoteText = slide.dataset.content || (slide.querySelector('.quote-text')?.textContent.trim() || '');
      currentAuthor = slide.dataset.author || (slide.querySelector('.author-name-text')?.textContent.trim() || '');

      window._currentActiveQuoteId = currentQuoteId;

      // Reset preview state
      const previewImg = document.getElementById('share-preview-image');
      const previewLoader = document.getElementById('share-preview-loader');

      if (isOpeningModal) {
        if (previewImg) previewImg.classList.add('opacity-0');
        if (previewLoader) previewLoader.classList.remove('opacity-0', 'pointer-events-none');
        window.prepareQuoteCardImage(slide, true);
        return;
      }

      if (window.quoteCardCache.has(currentQuoteId)) {
        updateModalPreviewUI(window.quoteCardCache.get(currentQuoteId));
      } else {
        if (previewImg) previewImg.classList.add('opacity-0');
        if (previewLoader) previewLoader.classList.remove('opacity-0', 'pointer-events-none');

        // Immediately trigger background preparation
        window.prepareQuoteCardImage(slide, false);
      }
    };

    // Helper: Ensure quote card is ready
    async function ensureQuoteEntry() {
      if (window.quoteCardCache.has(currentQuoteId)) {
        return window.quoteCardCache.get(currentQuoteId);
      }
      const activeSlide = document.querySelector('.reel-slide.is-active') || document.querySelector('.reel-slide');
      if (activeSlide && activeSlide.dataset.quoteId === currentQuoteId) {
        return await window.prepareQuoteCardImage(activeSlide, true);
      }
      return await window.prepareQuoteCardImage({
        id: currentQuoteId,
        slug: currentQuoteSlug,
        content: currentQuoteText,
        author: currentAuthor,
        mood: currentMood,
        category: currentCategory,
      }, true);
    }

    // Helper: Instant PNG download
    function triggerDownload(entry) {
      if (!entry) return;
      const link = document.createElement('a');
      link.download = `wisdom-${entry.id}-4x5.png`;
      link.href = entry.objectUrl || entry.dataUrl;
      link.click();
      if (window.showToast) window.showToast('Quote image saved! ✓');
    }

    // 1. Primary: Native Share Image (Web Share API with Files)
    if (imageBtn) {
      imageBtn.onclick = async () => {
        const entry = await ensureQuoteEntry();
        if (!entry) {
          if (window.showToast) window.showToast('Could not prepare image');
          return;
        }

        const origin = window.location.origin.includes('localhost') ? window.location.origin : 'https://www.ashishvishwakarma.com';
        const url = `${origin}/wisdom/quote/${currentQuoteSlug}/`;
        const shareData = {
          title: `"${currentQuoteText}" — ${currentAuthor}`,
          text: `"${currentQuoteText}" — ${currentAuthor}\n${url}`,
          files: [entry.file],
        };

        // If native file sharing is supported (iOS, Android, macOS Safari)
        if (navigator.canShare && navigator.canShare({ files: [entry.file] })) {
          try {
            await navigator.share(shareData);
            closeModal();
            return;
          } catch (err) {
            if (err.name === 'AbortError') return; // User simply dismissed share sheet
            console.warn('Native share failed, falling back:', err);
          }
        }

        // Desktop / Unsupported Fallback: Copy Image to Clipboard
        if (navigator.clipboard && window.ClipboardItem) {
          try {
            await navigator.clipboard.write([
              new ClipboardItem({ 'image/png': entry.blob })
            ]);
            if (window.showToast) window.showToast('Image copied to clipboard! Paste anywhere (Ctrl+V) ✓');
            closeModal();
            return;
          } catch (clipErr) {
            console.warn('Clipboard write failed:', clipErr);
          }
        }

        // Final Fallback: Direct Download
        triggerDownload(entry);
        closeModal();
      };
    }

    // 2. Quick Action: Copy Image to Clipboard
    if (copyImageBtn) {
      copyImageBtn.onclick = async () => {
        const entry = await ensureQuoteEntry();
        if (!entry) return;

        if (navigator.clipboard && window.ClipboardItem) {
          try {
            await navigator.clipboard.write([
              new ClipboardItem({ 'image/png': entry.blob })
            ]);
            if (window.showToast) window.showToast('4:5 Quote Card copied to clipboard! Paste anywhere (Ctrl+V) ✓');
            closeModal();
            return;
          } catch (err) {
            console.warn('Copy to clipboard failed:', err);
          }
        }

        triggerDownload(entry);
        closeModal();
      };
    }

    // 3. Quick Action: Download 1080×1350 PNG
    if (downloadImageBtn) {
      downloadImageBtn.onclick = async () => {
        const entry = await ensureQuoteEntry();
        if (entry) triggerDownload(entry);
        closeModal();
      };
    }

    // 4. Quick Action: Share Link
    if (linkBtn) {
      linkBtn.onclick = async () => {
        const origin = window.location.origin.includes('localhost') ? window.location.origin : 'https://www.ashishvishwakarma.com';
        const url = `${origin}/wisdom/quote/${currentQuoteSlug}/`;
        const shareData = {
          title: `"${currentQuoteText}" — ${currentAuthor}`,
          text: `"${currentQuoteText}" — ${currentAuthor}`,
          url: url,
        };

        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch (err) {
            if (err.name !== 'AbortError') {
              await copyToClipboard(url);
            }
          }
        } else {
          await copyToClipboard(url);
        }
        closeModal();
      };
    }

    async function copyToClipboard(text) {
      try {
        await navigator.clipboard.writeText(text);
        if (window.showToast) window.showToast('Link copied to clipboard ✓');
      } catch {
        if (window.showToast) window.showToast('Could not copy link');
      }
    }
  }

  document.addEventListener('DOMContentLoaded', setupShareModal);
  document.addEventListener('astro:page-load', setupShareModal);
</script>
