---
/**
 * ShareModal — Share overlay with 4:5 (1080×1350) HD quote card pre-generation and native file sharing.
 *
 * Key Capabilities:
 * 1. Background Pre-Generation: Canvas 2D renders 1080×1350 4:5 quote card in ~15ms in background
 * 2. In-Memory Cache: Pre-rendered { blob, file, dataUrl, objectUrl } stored per quote ID
 * 3. Native Web Share API with Files: Opens OS native share sheet directly with PNG attached (Instagram Stories, WhatsApp, etc.)
 * 4. Clipboard Image Copy: navigator.clipboard.write allows instant pasting on desktop without downloading
 * 5. Instant PNG Download: 1080×1350 PNG saved directly from pre-generated blob
 * 6. Live 4:5 Card Preview: Visual card thumbnail showing the ready-to-share graphic
 */
---

<div
  id="share-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center"
  style="display: none;"
>
  <!-- Backdrop -->
  <div id="share-backdrop" class="absolute inset-0 bg-black/80 backdrop-blur-md transition-opacity"></div>

  <!-- Modal Content -->
  <div class="relative z-10 glass-heavy rounded-3xl p-5 mx-4 max-w-[340px] w-full animate-slide-up overflow-hidden shadow-2xl border border-white/15">
    <!-- Header -->
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-base font-bold text-white tracking-wide">Share Quote</h3>
      <button
        id="share-close-btn"
        class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors text-white/80 hover:text-white cursor-pointer"
        aria-label="Close share modal"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <!-- Visual Card Preview (Hero) -->
    <div class="relative mb-5 flex flex-col items-center">
      <div class="relative w-44 aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl shadow-black/60 border border-white/20 bg-black/40 flex items-center justify-center">
        <!-- Ambient glow behind preview card -->
        <div id="share-preview-glow" class="absolute -inset-2 rounded-2xl bg-gradient-to-r from-purple-500/25 to-pink-500/25 blur-xl opacity-70 pointer-events-none"></div>

        <img
          id="share-preview-image"
          src=""
          alt="Quote Card Preview"
          class="w-full h-full object-cover transition-opacity duration-300 opacity-0 relative z-10"
        />

        <!-- Loading spinner while card finishes rendering -->
        <div id="share-preview-loader" class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-black/60 p-2 text-center transition-opacity z-20">
          <div class="w-6 h-6 rounded-full border-2 border-white/80 border-t-transparent animate-spin"></div>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="space-y-2.5">
      <!-- 1. Primary Action: Share Image -->
      <button
        id="share-image-btn"
        class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-semibold text-sm flex items-center justify-center gap-2 transition-all duration-200 cursor-pointer shadow-lg shadow-purple-900/30 active:scale-[0.98] leading-normal"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
          <polyline points="16 6 12 2 8 6" />
          <line x1="12" y1="2" x2="12" y2="15" />
        </svg>
        <span>Share Image</span>
      </button>

      <!-- 2. Secondary Quick Actions Row: Copy Image | Save PNG | Copy Link -->
      <div class="grid grid-cols-3 gap-2">
        <!-- Copy Image to Clipboard -->
        <button
          id="copy-image-btn"
          class="flex flex-col items-center justify-center gap-1.5 py-3 px-2 rounded-xl glass hover:bg-white/10 active:scale-95 transition-all text-white/85 hover:text-white cursor-pointer"
          title="Copy image to clipboard"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
          </svg>
          <span class="text-[11px] font-medium leading-normal text-center">Copy Image</span>
        </button>

        <!-- Save PNG -->
        <button
          id="download-image-btn"
          class="flex flex-col items-center justify-center gap-1.5 py-3 px-2 rounded-xl glass hover:bg-white/10 active:scale-95 transition-all text-white/85 hover:text-white cursor-pointer"
          title="Download PNG image"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span class="text-[11px] font-medium leading-normal text-center">Save PNG</span>
        </button>

        <!-- Copy Link -->
        <button
          id="share-link-btn"
          class="flex flex-col items-center justify-center gap-1.5 py-3 px-2 rounded-xl glass hover:bg-white/10 active:scale-95 transition-all text-white/85 hover:text-white cursor-pointer"
          title="Share or copy quote link"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
          </svg>
          <span class="text-[11px] font-medium leading-normal text-center">Copy Link</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // ── High-Performance Canvas 2D 4:5 Quote Card Generator ──
  // Renders a stunning 1080×1350 (4:5) image in ~15ms on an offscreen canvas.
  function renderQuoteCard4x5(quote) {
    const width = 1080;
    const height = 1350;
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d');
    if (!ctx) return null;

    const content = quote.content || '';
    const author = quote.author || 'Anonymous';
    const mood = quote.mood || 'reflective';

    // Helper: Rounded Rectangle Fallback
    function drawRoundRect(c, x, y, w, h, r) {
      if (typeof c.roundRect === 'function') {
        c.roundRect(x, y, w, h, r);
      } else {
        c.moveTo(x + r, y);
        c.arcTo(x + w, y, x + w, y + h, r);
        c.arcTo(x + w, y + h, x, y + h, r);
        c.arcTo(x, y + h, x, y, r);
        c.arcTo(x, y, x + w, y, r);
      }
    }

    // 1. Mood Gradients (135° diagonal from top-left to bottom-right)
    const moodGradients = {
      reflective: ['#0f172a', '#1e1b4b', '#312e81', '#4c1d95'],
      motivational: ['#1c1917', '#451a03', '#78350f', '#b45309'],
      serene: ['#022c22', '#042f2e', '#0e4a46', '#115e59'],
      bold: ['#18181b', '#450a0a', '#7f1d1d', '#991b1c'],
      melancholic: ['#18181b', '#2e1065', '#4c1d95', '#6d28d9'],
      joyful: ['#064e3b', '#047857', '#059669', '#10b981'],
      philosophical: ['#0b0f19', '#1e1b4b', '#3730a3', '#4f46e5'],
      romantic: ['#2a0818', '#500724', '#831843', '#be185d'],
    };
    const stops = moodGradients[mood] || moodGradients.reflective;
    const grad = ctx.createLinearGradient(0, 0, width, height);
    stops.forEach((color, idx) => {
      grad.addColorStop(idx / (stops.length - 1), color);
    });
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, width, height);

    // 2. Atmospheric Soft Vignette & Glow
    const vignette = ctx.createRadialGradient(width / 2, height / 2, 220, width / 2, height / 2, height * 0.72);
    vignette.addColorStop(0, 'rgba(255, 255, 255, 0.04)');
    vignette.addColorStop(0.5, 'rgba(0, 0, 0, 0.08)');
    vignette.addColorStop(1, 'rgba(0, 0, 0, 0.62)');
    ctx.fillStyle = vignette;
    ctx.fillRect(0, 0, width, height);

    // 3. Editorial Inner Border (40px inset, rounded corners)
    const inset = 40;
    const radius = 24;
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    drawRoundRect(ctx, inset, inset, width - inset * 2, height - inset * 2, radius);
    ctx.stroke();

    // 4. Header Badge: "✨ WISDOM REELS"
    const badgeW = 310;
    const badgeH = 50;
    const badgeX = (width - badgeW) / 2;
    const badgeY = 100;
    ctx.fillStyle = 'rgba(255, 255, 255, 0.08)';
    ctx.beginPath();
    drawRoundRect(ctx, badgeX, badgeY, badgeW, badgeH, 25);
    ctx.fill();
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.18)';
    ctx.lineWidth = 1;
    ctx.stroke();

    ctx.save();
    ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
    ctx.font = '700 18px "Inter", -apple-system, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    if ('letterSpacing' in ctx) ctx.letterSpacing = '4px';
    ctx.fillText('✨  WISDOM REELS', width / 2, badgeY + badgeH / 2);
    ctx.restore();

    // 5. Large Decorative Quotation Mark
    ctx.save();
    ctx.fillStyle = 'rgba(255, 255, 255, 0.22)';
    ctx.font = 'italic 115px "Playfair Display", Georgia, serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('“', width / 2, 260);
    ctx.restore();

    // 6. Dynamic Typography Auto-Wrapping & Sizing
    const len = content.length;
    let fontSize = 50;
    let lineHeight = 72;

    if (len < 65) {
      fontSize = 58;
      lineHeight = 82;
    } else if (len < 130) {
      fontSize = 50;
      lineHeight = 72;
    } else if (len < 200) {
      fontSize = 42;
      lineHeight = 60;
    } else {
      fontSize = 35;
      lineHeight = 52;
    }

    ctx.font = `400 ${fontSize}px "Playfair Display", "Cormorant Garamond", Georgia, serif`;
    const maxTextWidth = 860;
    const words = content.split(/\s+/);
    const lines = [];
    let curLine = '';

    for (let i = 0; i < words.length; i++) {
      const test = curLine ? curLine + ' ' + words[i] : words[i];
      const m = ctx.measureText(test);
      if (m.width > maxTextWidth && curLine) {
        lines.push(curLine);
        curLine = words[i];
      } else {
        curLine = test;
      }
    }
    if (curLine) lines.push(curLine);

    // Vertical positioning calculation
    const totalTextHeight = lines.length * lineHeight;
    let textStartY = 610 - (totalTextHeight / 2);
    if (textStartY < 340) textStartY = 340;

    ctx.save();
    ctx.fillStyle = '#ffffff';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.shadowColor = 'rgba(0, 0, 0, 0.65)';
    ctx.shadowBlur = 24;
    ctx.shadowOffsetY = 4;

    for (let i = 0; i < lines.length; i++) {
      ctx.fillText(lines[i], width / 2, textStartY + (i * lineHeight) + (lineHeight / 2));
    }
    ctx.restore();

    // 7. Author Attribution (one line space below quote)
    const authorY = textStartY + totalTextHeight + lineHeight;
    ctx.save();
    ctx.fillStyle = '#f3f4f6';
    ctx.font = '700 28px "Inter", -apple-system, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    if ('letterSpacing' in ctx) ctx.letterSpacing = '3.5px';
    ctx.shadowColor = 'rgba(0, 0, 0, 0.5)';
    ctx.shadowBlur = 14;
    ctx.shadowOffsetY = 2;
    ctx.fillText(`— ${author.toUpperCase()}`, width / 2, authorY);
    ctx.restore();

    // 8. Subtle Gradient Divider Line
    const divY = authorY + 50;
    const divWidth = 160;
    const divGrad = ctx.createLinearGradient((width - divWidth) / 2, divY, (width + divWidth) / 2, divY);
    divGrad.addColorStop(0, 'rgba(255, 255, 255, 0)');
    divGrad.addColorStop(0.5, 'rgba(255, 255, 255, 0.45)');
    divGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
    ctx.strokeStyle = divGrad;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo((width - divWidth) / 2, divY);
    ctx.lineTo((width + divWidth) / 2, divY);
    ctx.stroke();

    // 9. Footer Domain Watermark
    ctx.save();
    ctx.fillStyle = 'rgba(255, 255, 255, 0.55)';
    ctx.font = '500 20px "Inter", -apple-system, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    if ('letterSpacing' in ctx) ctx.letterSpacing = '3.5px';
    ctx.fillText('ashishvishwakarma.com/wisdom', width / 2, 1260);
    ctx.restore();

    return canvas;
  }

  // ── In-Memory Pre-Rendered Cache ──
  window.quoteCardCache = window.quoteCardCache || new Map();
  window.quoteCardPromises = window.quoteCardPromises || new Map();

  // ── Background Quote Image Pre-Generation Engine ──
  window.prepareQuoteCardImage = async function(slideOrData) {
    if (!slideOrData) return null;

    let id = '';
    let slug = '';
    let content = '';
    let author = '';
    let mood = '';

    if (slideOrData instanceof HTMLElement) {
      id = slideOrData.dataset.quoteId || '';
      slug = slideOrData.dataset.quoteSlug || id;
      content = slideOrData.dataset.content || (slideOrData.querySelector('.quote-text')?.textContent.trim() || '');
      author = slideOrData.dataset.author || (slideOrData.querySelector('.author-name-text')?.textContent.trim() || '');
      mood = slideOrData.dataset.mood || 'reflective';
    } else {
      id = slideOrData.id || '';
      slug = slideOrData.slug || id;
      content = slideOrData.content || '';
      author = slideOrData.author || '';
      mood = slideOrData.mood || 'reflective';
    }

    if (!id || !content) return null;

    // Return if already prepared in cache
    if (window.quoteCardCache.has(id)) {
      return window.quoteCardCache.get(id);
    }

    // Return active promise if already generating
    if (window.quoteCardPromises.has(id)) {
      return window.quoteCardPromises.get(id);
    }

    const genPromise = (async () => {
      try {
        // Ensure web fonts are ready so Playfair & Inter render crisply
        if (document.fonts && document.fonts.ready) {
          await document.fonts.ready;
        }

        const canvas = renderQuoteCard4x5({ id, content, author, mood, slug });
        if (!canvas) return null;

        const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
        if (!blob) return null;

        const file = new File([blob], `wisdom-${id}-4x5.png`, { type: 'image/png' });
        const objectUrl = URL.createObjectURL(blob);
        const dataUrl = canvas.toDataURL('image/png');

        const entry = {
          id,
          slug,
          content,
          author,
          mood,
          blob,
          file,
          objectUrl,
          dataUrl,
          width: 1080,
          height: 1350,
        };

        window.quoteCardCache.set(id, entry);

        // Update modal UI if currently active quote matches
        if (window._currentActiveQuoteId === id) {
          updateModalPreviewUI(entry);
        }

        return entry;
      } catch (err) {
        console.warn('Quote card generation error:', err);
        return null;
      } finally {
        window.quoteCardPromises.delete(id);
      }
    })();

    window.quoteCardPromises.set(id, genPromise);
    return genPromise;
  };

  // Helper: Update modal preview when image is ready
  function updateModalPreviewUI(entry) {
    const previewImg = document.getElementById('share-preview-image');
    const previewLoader = document.getElementById('share-preview-loader');

    if (previewImg && entry && entry.objectUrl) {
      previewImg.src = entry.objectUrl;
      previewImg.classList.remove('opacity-0');
      if (previewLoader) previewLoader.classList.add('opacity-0', 'pointer-events-none');
    }
  }

  // ── Share Modal Controller ──
  function setupShareModal() {
    const modal = document.getElementById('share-modal');
    const backdrop = document.getElementById('share-backdrop');
    const closeBtn = document.getElementById('share-close-btn');
    const linkBtn = document.getElementById('share-link-btn');
    const imageBtn = document.getElementById('share-image-btn');
    const copyImageBtn = document.getElementById('copy-image-btn');
    const downloadImageBtn = document.getElementById('download-image-btn');

    let currentQuoteId = '';
    let currentQuoteSlug = '';
    let currentQuoteText = '';
    let currentAuthor = '';
    let currentMood = '';

    function closeModal() {
      if (modal) {
        modal.style.display = 'none';
        modal.classList.add('hidden');
      }
    }

    if (backdrop) backdrop.addEventListener('click', closeModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    // ESC key closes modal
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.style.display !== 'none') {
        closeModal();
      }
    });

    // Update share context whenever active slide changes
    window.updateShareContext = function(slide) {
      if (!slide) return;
      currentQuoteId = slide.dataset.quoteId || '';
      currentQuoteSlug = slide.dataset.quoteSlug || currentQuoteId;
      currentMood = slide.dataset.mood || 'reflective';
      currentQuoteText = slide.dataset.content || (slide.querySelector('.quote-text')?.textContent.trim() || '');
      currentAuthor = slide.dataset.author || (slide.querySelector('.author-name-text')?.textContent.trim() || '');

      window._currentActiveQuoteId = currentQuoteId;

      // Reset preview state
      const previewImg = document.getElementById('share-preview-image');
      const previewLoader = document.getElementById('share-preview-loader');

      if (window.quoteCardCache.has(currentQuoteId)) {
        updateModalPreviewUI(window.quoteCardCache.get(currentQuoteId));
      } else {
        if (previewImg) previewImg.classList.add('opacity-0');
        if (previewLoader) previewLoader.classList.remove('opacity-0', 'pointer-events-none');

        // Immediately trigger background preparation
        window.prepareQuoteCardImage(slide);
      }
    };

    // Helper: Ensure quote card is ready
    async function ensureQuoteEntry() {
      if (window.quoteCardCache.has(currentQuoteId)) {
        return window.quoteCardCache.get(currentQuoteId);
      }
      return await window.prepareQuoteCardImage({
        id: currentQuoteId,
        slug: currentQuoteSlug,
        content: currentQuoteText,
        author: currentAuthor,
        mood: currentMood,
      });
    }

    // Helper: Instant PNG download
    function triggerDownload(entry) {
      if (!entry) return;
      const link = document.createElement('a');
      link.download = `wisdom-${entry.id}-4x5.png`;
      link.href = entry.objectUrl || entry.dataUrl;
      link.click();
      if (window.showToast) window.showToast('Quote image saved! ✓');
    }

    // 1. Primary: Native Share Image (Web Share API with Files)
    if (imageBtn) {
      imageBtn.onclick = async () => {
        const entry = await ensureQuoteEntry();
        if (!entry) {
          if (window.showToast) window.showToast('Could not prepare image');
          return;
        }

        const origin = window.location.origin.includes('localhost') ? window.location.origin : 'https://www.ashishvishwakarma.com';
        const url = `${origin}/wisdom/quote/${currentQuoteSlug}/`;
        const shareData = {
          title: `"${currentQuoteText}" — ${currentAuthor}`,
          text: `"${currentQuoteText}" — ${currentAuthor}\n${url}`,
          files: [entry.file],
        };

        // If native file sharing is supported (iOS, Android, macOS Safari)
        if (navigator.canShare && navigator.canShare({ files: [entry.file] })) {
          try {
            await navigator.share(shareData);
            closeModal();
            return;
          } catch (err) {
            if (err.name === 'AbortError') return; // User simply dismissed share sheet
            console.warn('Native share failed, falling back:', err);
          }
        }

        // Desktop / Unsupported Fallback: Copy Image to Clipboard
        if (navigator.clipboard && window.ClipboardItem) {
          try {
            await navigator.clipboard.write([
              new ClipboardItem({ 'image/png': entry.blob })
            ]);
            if (window.showToast) window.showToast('Image copied to clipboard! Paste anywhere (Ctrl+V) ✓');
            closeModal();
            return;
          } catch (clipErr) {
            console.warn('Clipboard write failed:', clipErr);
          }
        }

        // Final Fallback: Direct Download
        triggerDownload(entry);
        closeModal();
      };
    }

    // 2. Quick Action: Copy Image to Clipboard
    if (copyImageBtn) {
      copyImageBtn.onclick = async () => {
        const entry = await ensureQuoteEntry();
        if (!entry) return;

        if (navigator.clipboard && window.ClipboardItem) {
          try {
            await navigator.clipboard.write([
              new ClipboardItem({ 'image/png': entry.blob })
            ]);
            if (window.showToast) window.showToast('4:5 Quote Card copied to clipboard! Paste anywhere (Ctrl+V) ✓');
            closeModal();
            return;
          } catch (err) {
            console.warn('Copy to clipboard failed:', err);
          }
        }

        triggerDownload(entry);
        closeModal();
      };
    }

    // 3. Quick Action: Download 1080×1350 PNG
    if (downloadImageBtn) {
      downloadImageBtn.onclick = async () => {
        const entry = await ensureQuoteEntry();
        if (entry) triggerDownload(entry);
        closeModal();
      };
    }

    // 4. Quick Action: Share Link
    if (linkBtn) {
      linkBtn.onclick = async () => {
        const origin = window.location.origin.includes('localhost') ? window.location.origin : 'https://www.ashishvishwakarma.com';
        const url = `${origin}/wisdom/quote/${currentQuoteSlug}/`;
        const shareData = {
          title: `"${currentQuoteText}" — ${currentAuthor}`,
          text: `"${currentQuoteText}" — ${currentAuthor}`,
          url: url,
        };

        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch (err) {
            if (err.name !== 'AbortError') {
              await copyToClipboard(url);
            }
          }
        } else {
          await copyToClipboard(url);
        }
        closeModal();
      };
    }

    async function copyToClipboard(text) {
      try {
        await navigator.clipboard.writeText(text);
        if (window.showToast) window.showToast('Link copied to clipboard ✓');
      } catch {
        if (window.showToast) window.showToast('Could not copy link');
      }
    }
  }

  document.addEventListener('DOMContentLoaded', setupShareModal);
  document.addEventListener('astro:page-load', setupShareModal);
</script>
