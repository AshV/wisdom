---
import '../styles/global.css';
import GlobalBackground from '../components/GlobalBackground.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  keywords?: string[];
  breadcrumbs?: Array<{ name: string; url: string }>;
  robots?: string;
}

const {
  title = 'Wisdom — Timeless Quotes, Reimagined',
  description = 'Experience the world\'s greatest quotes as immersive, full-screen reels. Swipe through wisdom from Rumi, Seneca, Angelou, Shakespeare, and more.',
  image = '/wisdom/og-image.jpg',
  ogType = 'website',
  keywords = [
    'wisdom',
    'quotes',
    'timeless quotes',
    'inspirational quotes',
    'philosophy',
    'stoicism',
    'mindfulness',
    'life quotes',
    'rumi',
    'marcus aurelius',
    'seneca',
    'maya angelou',
    'steve jobs',
    'albert einstein',
    'quote reels',
  ],
  breadcrumbs = [],
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const BASE = '/wisdom';
const ogImageUrl = new URL(image, Astro.site).toString();

// Base WebSite Schema for Search Engines
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Wisdom',
  url: 'https://www.ashishvishwakarma.com/wisdom/',
  description: 'Timeless quotes, reimagined as immersive visual reels.',
  author: {
    '@type': 'Person',
    name: 'Ashish Vishwakarma',
    url: 'https://www.ashishvishwakarma.com',
  },
  inLanguage: 'en-US',
};

// Breadcrumbs Schema if provided
const breadcrumbsSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Wisdom',
      item: 'https://www.ashishvishwakarma.com/wisdom/',
    },
    ...breadcrumbs.map((b, idx) => ({
      '@type': 'ListItem',
      position: idx + 2,
      name: b.name,
      item: new URL(b.url, Astro.site).toString(),
    })),
  ],
} : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1, user-scalable=no" />
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content="Ashish Vishwakarma" />
    <meta name="robots" content={robots} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
    <meta property="og:site_name" content="Wisdom" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content="Wisdom — Timeless Quotes, Reimagined" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Wisdom — Timeless Quotes, Reimagined" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${BASE}/favicon.png`} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}/favicon.svg`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${BASE}/icons/apple-touch-icon.png`} />
    <link rel="manifest" href={`${BASE}/manifest.webmanifest`} />
    <meta name="application-name" content="Wisdom" />
    <meta name="mobile-web-app-capable" content="yes" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbsSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsSchema)} />
    )}

    <!-- Google Fonts: Inter, Playfair Display, Cormorant Garamond -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,900;1,400;1,600;1,700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-surface text-text-primary overflow-hidden no-select">
    <!-- Global Atmospheric Canvas & Fluid Aura -->
    <GlobalBackground />

    <!-- Page Content -->
    <main>
      <slot />
    </main>

    <!-- Heart Burst Overlay (global, reused by all slides) -->
    <div
      id="heart-burst-overlay"
      class="fixed inset-0 z-50 flex items-center justify-center pointer-events-none"
      style="display: none;"
    >
      <svg
        width="120"
        height="120"
        viewBox="0 0 24 24"
        fill="none"
        class="animate-heart-burst"
      >
        <path
          d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
          fill="#ef4444"
        />
      </svg>
    </div>

    <!-- Toast Container -->
    <div
      id="toast-container"
      class="fixed bottom-24 left-1/2 -translate-x-1/2 z-[60] pointer-events-none"
    ></div>

    <!-- Offline Sanctuary Indicator Badge -->
    <div
      id="offline-sanctuary-badge"
      class="fixed top-3.5 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 -translate-y-6 transition-all duration-500 flex items-center gap-2 px-3.5 py-1.5 rounded-full glass border border-emerald-400/40 text-emerald-300 text-xs font-medium tracking-wide shadow-2xl backdrop-blur-md select-none"
      role="status"
      aria-live="polite"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Offline Sanctuary Active</span>
    </div>

    <!-- Engagement-Gated PWA Install Toast -->
    <div
      id="pwa-install-toast"
      class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[70] pointer-events-none opacity-0 translate-y-8 transition-all duration-500 w-[94vw] max-w-md rounded-2xl bg-neutral-900/95 border border-amber-300/30 px-4 py-3.5 shadow-2xl backdrop-blur-xl text-white flex items-center justify-between gap-3 select-none"
      role="alert"
    >
      <div class="flex items-center gap-3 min-w-0">
        <img src={`${BASE}/icons/icon-192.png`} alt="Wisdom" class="w-10 h-10 rounded-xl shadow-md shrink-0 border border-white/10" />
        <div class="leading-tight truncate">
          <div class="text-xs font-semibold text-white">Install Wisdom App</div>
          <div class="text-[11px] text-white/60 truncate">Meditate anytime, even offline.</div>
        </div>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <button
          id="pwa-dismiss-btn"
          type="button"
          class="px-2.5 py-1.5 rounded-lg text-white/50 hover:text-white text-xs font-medium transition-colors cursor-pointer"
        >
          Later
        </button>
        <button
          id="pwa-install-btn"
          type="button"
          class="px-3.5 py-1.5 rounded-lg bg-amber-400 text-black text-xs font-semibold hover:bg-amber-300 active:scale-95 transition-all shadow-md cursor-pointer whitespace-nowrap"
        >
          Install
        </button>
      </div>
    </div>

    <!-- Zen Mindfulness Contemplation Breath Pill -->
    <div
      id="zen-breath-pill"
      class="fixed top-6 left-1/2 -translate-x-1/2 z-[55] pointer-events-none opacity-0 -translate-y-4 transition-all duration-700 flex items-center gap-2.5 px-4 py-2 rounded-full glass border border-amber-300/40 text-amber-200 text-xs font-serif tracking-widest shadow-2xl backdrop-blur-md select-none"
      role="status"
      aria-live="polite"
    >
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
      <span>✦ A moment of stillness... pause and breathe</span>
    </div>

    <script is:inline>
      // ── Zen Chime Controller (Play-Once on Slide Arrival) ──
      // Plays a single soothing Tibetan singing bowl / Zen chime once on arrival, then complete silence.
      // Zero loop fatigue, zero continuous drone, pure peaceful contemplation.
      // Guarantees: Currently playing chime is ALWAYS strictly different from the last 2 played chimes.
      class ZenChimeEngine {
        constructor() {
          this.enabled = false;
          this.audioEl = new Audio();
          this.audioEl.preload = 'auto';
          this.audioEl.volume = 0.55;
          this.currentMood = 'reflective';
          this.lastChimeTime = 0;
          this.pendingTimer = null;
          this.base = '/wisdom';
          this.recentChimes = [];
          this.allChimes = [
            'chime-reflective',
            'chime-reflective-alt',
            'chime-serene',
            'chime-serene-alt',
            'chime-philosophical',
            'chime-philosophical-alt',
            'chime-motivational',
            'chime-motivational-alt',
            'chime-joyful',
            'chime-joyful-alt',
            'chime-bold',
            'chime-bold-alt',
            'chime-melancholic',
            'chime-melancholic-alt',
            'chime-romantic',
            'chime-romantic-alt',
            'zen-chime',
            'chime-temple-bell',
            'chime-crystal-bowl',
            'chime-tingsha',
            'chime-celestial',
            'chime-bamboo',
          ];

          // Harmonic mood affinities for intelligent variety
          this.moodAffinities = {
            reflective: ['chime-reflective', 'chime-reflective-alt', 'zen-chime', 'chime-temple-bell'],
            motivational: ['chime-motivational', 'chime-motivational-alt', 'chime-celestial', 'chime-crystal-bowl'],
            serene: ['chime-serene', 'chime-serene-alt', 'chime-bamboo', 'zen-chime'],
            bold: ['chime-bold', 'chime-bold-alt', 'chime-temple-bell', 'chime-tingsha'],
            melancholic: ['chime-melancholic', 'chime-melancholic-alt', 'chime-crystal-bowl', 'chime-reflective-alt'],
            joyful: ['chime-joyful', 'chime-joyful-alt', 'chime-celestial', 'chime-tingsha'],
            philosophical: ['chime-philosophical', 'chime-philosophical-alt', 'chime-temple-bell', 'chime-reflective-alt'],
            romantic: ['chime-romantic', 'chime-romantic-alt', 'chime-crystal-bowl', 'chime-celestial'],
          };
        }

        init() {
          const saved = localStorage.getItem('wisdom_chime_enabled');
          this.enabled = saved === 'true';
          try {
            const cached = sessionStorage.getItem('wisdom_recent_chimes');
            if (cached) this.recentChimes = JSON.parse(cached);
          } catch {
            this.recentChimes = [];
          }
          this.updateUI();
        }

        setMood(mood) {
          if (mood) this.currentMood = mood;
        }

        // Guarantees the selected chime is strictly different from the last 2 played
        selectChime(preferredMood) {
          const rawMood = preferredMood ? preferredMood.replace(/^chime-/, '') : 'reflective';
          const affinities = this.moodAffinities[rawMood] || this.moodAffinities.reflective;

          // 1. Pick from mood-compatible chimes that are NOT in the last 2 played
          const moodEligible = affinities.filter(c => !this.recentChimes.includes(c));
          if (moodEligible.length > 0) {
            return moodEligible[Math.floor(Math.random() * moodEligible.length)];
          }

          // 2. Otherwise, select from the entire 22-chime library excluding the last 2 played
          const allEligible = this.allChimes.filter(c => !this.recentChimes.includes(c));
          if (allEligible.length === 0) return 'zen-chime';

          return allEligible[Math.floor(Math.random() * allEligible.length)];
        }

        // Plays single peaceful chime after 1s of settling on a quote
        playOnce(mood = 'reflective', delay = 1000) {
          if (!this.enabled) return;
          this.currentMood = mood;

          // Clear previous pending chime if user swipes through quickly
          if (this.pendingTimer) {
            clearTimeout(this.pendingTimer);
            this.pendingTimer = null;
          }

          this.pendingTimer = setTimeout(() => {
            const chimeKey = this.selectChime(this.currentMood);

            // Record in history (strictly keep only the last 2)
            this.recentChimes.push(chimeKey);
            if (this.recentChimes.length > 2) {
              this.recentChimes.shift();
            }
            try {
              sessionStorage.setItem('wisdom_recent_chimes', JSON.stringify(this.recentChimes));
            } catch {}

            const chimeUrl = `${this.base}/media/audio/${chimeKey}.wav`;
            try {
              this.audioEl.pause();
              this.audioEl.currentTime = 0;
              this.audioEl.src = chimeUrl;
              const p = this.audioEl.play();
              if (p) p.catch(() => {});
            } catch (e) {}
            this.pendingTimer = null;
          }, delay);
        }

        playZenBell() {
          const chimeUrl = `${this.base}/media/audio/zen-chime.wav`;
          try {
            const zenAudio = new Audio(chimeUrl);
            zenAudio.volume = 0.65;
            zenAudio.play().catch(() => {});
          } catch (e) {}
        }

        toggle() {
          this.enabled = !this.enabled;
          localStorage.setItem('wisdom_chime_enabled', String(this.enabled));
          this.updateUI();

          if (this.pendingTimer) {
            clearTimeout(this.pendingTimer);
            this.pendingTimer = null;
          }

          if (this.enabled) {
            if (window.showToast) window.showToast('Zen chime enabled (plays 1s after arrival)');
            this.playOnce(this.currentMood, 0); // immediate preview when explicitly enabled
          } else {
            if (window.showToast) window.showToast('Zen chime muted');
            try {
              this.audioEl.pause();
              this.audioEl.currentTime = 0;
            } catch (e) {}
          }
          return this.enabled;
        }

        updateUI() {
          const btn = document.getElementById('audio-toggle-btn');
          if (!btn) return;
          const icon = btn.querySelector('svg');
          const label = btn.querySelector('span');

          if (this.enabled) {
            btn.classList.add('text-amber-300');
            if (icon) {
              // Ringing Bell SVG
              icon.innerHTML = `
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
              `;
            }
            if (label) {
              label.textContent = 'Chime On';
              label.classList.add('text-amber-300');
            }
          } else {
            btn.classList.remove('text-amber-300');
            if (icon) {
              // Muted Bell SVG (with strike line)
              icon.innerHTML = `
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                <line x1="2" y1="2" x2="22" y2="22" stroke="currentColor" stroke-width="2"/>
              `;
            }
            if (label) {
              label.textContent = 'Chime';
              label.classList.remove('text-amber-300');
            }
          }
        }
      }

      window.wisdomAudio = new ZenChimeEngine();
      // Initialize on DOM ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => window.wisdomAudio.init());
      } else {
        window.wisdomAudio.init();
      }

      // ── Toast Utility ──
      window.showToast = function(message, duration = 2500) {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = 'glass rounded-2xl px-6 py-3.5 text-sm font-medium text-text-primary animate-toast-in leading-normal shadow-2xl';
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(() => {
          toast.style.animation = 'toast-out 0.3s ease-in forwards';
          setTimeout(() => toast.remove(), 300);
        }, duration);
      };

      // ── Liked Quotes Store ──
      window.likedQuotes = {
        _key: 'liked_quotes',
        getAll() {
          try { return JSON.parse(localStorage.getItem(this._key) || '[]'); }
          catch { return []; }
        },
        has(id) { return this.getAll().includes(id); },
        toggle(id) {
          const all = this.getAll();
          const idx = all.indexOf(id);
          if (idx > -1) { all.splice(idx, 1); }
          else { all.push(id); }
          localStorage.setItem(this._key, JSON.stringify(all));
          return idx === -1; // returns true if now liked
        }
      };

      // ── Recent Viewed Quotes Store (Last 50 Quotes FIFO Queue) ──
      window.recentQuotes = {
        _key: 'wisdom_recent_quotes',
        _max: 50,
        getAll() {
          try {
            const data = JSON.parse(localStorage.getItem(this._key) || '[]');
            return Array.isArray(data) ? data : [];
          } catch {
            return [];
          }
        },
        has(id) {
          if (!id) return false;
          return this.getAll().includes(id);
        },
        add(id) {
          if (!id) return;
          try {
            let list = this.getAll();
            const idx = list.indexOf(id);
            if (idx > -1) {
              list.splice(idx, 1);
            }
            list.push(id);
            if (list.length > this._max) {
              list = list.slice(-this._max);
            }
            localStorage.setItem(this._key, JSON.stringify(list));
          } catch {}
        },
        clear() {
          try { localStorage.removeItem(this._key); } catch {}
        }
      };

      // ── Progressive Web App (PWA) & Offline Sanctuary Controller ──
      (function() {
        const BASE = '/wisdom';

        // 1. Register Service Worker
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register(`${BASE}/sw.js`, { scope: `${BASE}/` })
              .catch((err) => console.debug('SW reg failed', err));
          });
        }

        // 2. Offline Sanctuary Status Monitoring
        function updateNetworkStatus() {
          const badge = document.getElementById('offline-sanctuary-badge');
          if (!badge) return;
          if (!navigator.onLine) {
            badge.classList.remove('opacity-0', '-translate-y-6', 'pointer-events-none');
            badge.classList.add('opacity-100', 'translate-y-0');
          } else {
            badge.classList.remove('opacity-100', 'translate-y-0');
            badge.classList.add('opacity-0', '-translate-y-6', 'pointer-events-none');
          }
        }
        window.addEventListener('offline', updateNetworkStatus);
        window.addEventListener('online', updateNetworkStatus);
        document.addEventListener('DOMContentLoaded', updateNetworkStatus);
        document.addEventListener('astro:page-load', updateNetworkStatus);

        // 3. Mindful Engagement-Gated Install Prompt
        let deferredPrompt = null;
        let quotesViewed = 0;
        let installPromptShown = false;
        const SNOOZE_DAYS = 14;
        const SNOOZE_KEY = 'wisdom_pwa_snooze_until';

        function isSnoozed() {
          try {
            const until = localStorage.getItem(SNOOZE_KEY);
            return until && Date.now() < parseInt(until, 10);
          } catch {
            return false;
          }
        }

        function isStandalone() {
          return window.matchMedia('(display-mode: standalone)').matches ||
                 window.navigator.standalone === true;
        }

        function showInstallToast() {
          if (installPromptShown || isSnoozed() || isStandalone() || !deferredPrompt) return;
          const toast = document.getElementById('pwa-install-toast');
          if (!toast) return;
          installPromptShown = true;
          toast.classList.remove('opacity-0', 'translate-y-8', 'pointer-events-none');
          toast.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        }

        function hideInstallToast() {
          const toast = document.getElementById('pwa-install-toast');
          if (!toast) return;
          toast.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
          toast.classList.add('opacity-0', 'translate-y-8', 'pointer-events-none');
        }

        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          deferredPrompt = e;
          window.__pwaInstallPrompt = e;

          // Reveal drawer install button if present and not installed
          const drawerBtn = document.getElementById('pwa-drawer-install-btn');
          if (drawerBtn && !isStandalone()) {
            drawerBtn.classList.remove('hidden');
            drawerBtn.classList.add('inline-flex');
          }

          // Trigger after 45s of meditation
          setTimeout(() => {
            showInstallToast();
          }, 45000);
        });

        // Trigger after viewing 4+ quotes
        window.addEventListener('quoteChange', () => {
          quotesViewed++;
          if (quotesViewed >= 4) {
            showInstallToast();
          }
        });

        function setupInstallButtons() {
          const installBtn = document.getElementById('pwa-install-btn');
          const dismissBtn = document.getElementById('pwa-dismiss-btn');
          const drawerBtn = document.getElementById('pwa-drawer-install-btn');

          if (installBtn) {
            installBtn.onclick = async () => {
              hideInstallToast();
              if (deferredPrompt) {
                deferredPrompt.prompt();
                await deferredPrompt.userChoice;
                deferredPrompt = null;
                window.__pwaInstallPrompt = null;
              }
            };
          }

          if (dismissBtn) {
            dismissBtn.onclick = () => {
              hideInstallToast();
              try {
                const snoozeUntil = Date.now() + (SNOOZE_DAYS * 24 * 60 * 60 * 1000);
                localStorage.setItem(SNOOZE_KEY, snoozeUntil.toString());
              } catch {}
            };
          }

          if (drawerBtn) {
            if (window.__pwaInstallPrompt && !isStandalone()) {
              drawerBtn.classList.remove('hidden');
              drawerBtn.classList.add('inline-flex');
            }
            drawerBtn.onclick = async () => {
              const promptToUse = deferredPrompt || window.__pwaInstallPrompt;
              if (promptToUse) {
                promptToUse.prompt();
                await promptToUse.userChoice;
                deferredPrompt = null;
                window.__pwaInstallPrompt = null;
                drawerBtn.classList.add('hidden');
              }
            };
          }
        }

        document.addEventListener('DOMContentLoaded', setupInstallButtons);
        document.addEventListener('astro:page-load', setupInstallButtons);

        window.addEventListener('appinstalled', () => {
          deferredPrompt = null;
          window.__pwaInstallPrompt = null;
          hideInstallToast();
          const drawerBtn = document.getElementById('pwa-drawer-install-btn');
          if (drawerBtn) drawerBtn.classList.add('hidden');
        });
      })();

      // ── Daily Rituals & Zen Mindfulness Scheduler ──
      (function() {
        const BASE = '/wisdom';
        let zenTimer = null;

        function triggerZenMoment() {
          if (window.wisdomAudio && typeof window.wisdomAudio.playZenBell === 'function') {
            window.wisdomAudio.playZenBell();
          }
          const pill = document.getElementById('zen-breath-pill');
          if (pill) {
            pill.classList.remove('opacity-0', '-translate-y-4');
            pill.classList.add('opacity-100', 'translate-y-0');
            setTimeout(() => {
              pill.classList.remove('opacity-100', 'translate-y-0');
              pill.classList.add('opacity-0', '-translate-y-4');
            }, 6000);
          }
        }

        function setupZenBell() {
          if (zenTimer) {
            clearInterval(zenTimer);
            zenTimer = null;
          }
          try {
            const raw = localStorage.getItem('wisdom_ritual_settings');
            const settings = raw ? JSON.parse(raw) : null;
            if (settings && settings.zenBell) {
              const minutes = Number(settings.zenIntervalMinutes) || 10;
              zenTimer = setInterval(() => {
                triggerZenMoment();
              }, minutes * 60 * 1000);
            }
          } catch {}
        }

        async function checkScheduledRituals() {
          if (!('Notification' in window) || Notification.permission !== 'granted') return;
          try {
            const raw = localStorage.getItem('wisdom_ritual_settings');
            if (!raw) return;
            const settings = JSON.parse(raw);
            if (!settings.morning && !settings.evening) return;

            const now = new Date();
            const todayStr = `${now.getFullYear()}-${now.getMonth() + 1}-${now.getDate()}`;
            const currentHours = now.getHours();
            const currentMinutes = now.getMinutes();
            const currentTotalMin = currentHours * 60 + currentMinutes;

            let delivered = {};
            try {
              delivered = JSON.parse(localStorage.getItem('wisdom_last_delivered_rituals') || '{}');
            } catch {}
            const todayDelivered = delivered[todayStr] || [];

            let dueType = null;
            if (settings.morning && !todayDelivered.includes('morning')) {
              const [mH, mM] = (settings.morningTime || '08:00').split(':').map(Number);
              const target = mH * 60 + mM;
              if (currentTotalMin >= target && currentTotalMin < target + 180) {
                dueType = 'morning';
              }
            }

            if (!dueType && settings.evening && !todayDelivered.includes('evening')) {
              const [eH, eM] = (settings.eveningTime || '21:00').split(':').map(Number);
              const target = eH * 60 + eM;
              if (currentTotalMin >= target && currentTotalMin < target + 180) {
                dueType = 'evening';
              }
            }

            if (!dueType) return;

            // Fetch daily quote
            const res = await fetch(`${BASE}/daily-quotes.json`);
            const quotes = await res.json();
            const startOfYear = new Date(now.getFullYear(), 0, 1);
            const dayOfYear = Math.floor((now.getTime() - startOfYear.getTime()) / 86400000);
            const quote = quotes[dayOfYear % quotes.length] || quotes[0];

            const title = `${dueType === 'morning' ? 'Morning Reflection' : 'Evening Stillness'} — ${quote.author}`;
            const options = {
              body: `“${quote.content}”`,
              icon: `${BASE}/icons/icon-192.png`,
              badge: `${BASE}/icons/favicon-64.png`,
              tag: `wisdom-${dueType}-reflection`,
              data: { url: `${BASE}/#${quote.slug}` }
            };

            if ('serviceWorker' in navigator) {
              const reg = await navigator.serviceWorker.ready;
              if (reg && 'showNotification' in reg) {
                await reg.showNotification(title, options);
              } else {
                new Notification(title, options);
              }
            } else {
              new Notification(title, options);
            }

            todayDelivered.push(dueType);
            delivered[todayStr] = todayDelivered;
            localStorage.setItem('wisdom_last_delivered_rituals', JSON.stringify(delivered));
          } catch (err) {
            console.debug('Ritual check error:', err);
          }
        }

        // Initialize and listen for changes
        setupZenBell();
        checkScheduledRituals();

        // Periodic check every 60s
        setInterval(checkScheduledRituals, 60000);

        // Visibility change check (when user comes back to tab)
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') {
            checkScheduledRituals();
          }
        });

        // Listen for setting changes
        window.addEventListener('wisdom:ritual-settings-changed', () => {
          setupZenBell();
          checkScheduledRituals();
        });

        // Expose trigger for preview or testing
        window.triggerZenContemplation = triggerZenMoment;
      })();
    </script>
  </body>
</html>
