---
import '../styles/global.css';
import GlobalBackground from '../components/GlobalBackground.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Wisdom — Timeless Quotes, Reimagined',
  description = 'Experience the world\'s greatest quotes as immersive, full-screen reels. Swipe through wisdom from Rumi, Seneca, Angelou, and more.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const BASE = '/wisdom';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1, user-scalable=no" />
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="description" content={description} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}/favicon.svg`} />

    <!-- Google Fonts: Inter, Playfair Display, Cormorant Garamond -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,900;1,400;1,600;1,700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="bg-surface text-text-primary overflow-hidden no-select">
    <!-- Global Video Background -->
    <GlobalBackground />

    <!-- Page Content -->
    <main>
      <slot />
    </main>

    <!-- Heart Burst Overlay (global, reused by all slides) -->
    <div
      id="heart-burst-overlay"
      class="fixed inset-0 z-50 flex items-center justify-center pointer-events-none"
      style="display: none;"
    >
      <svg
        width="120"
        height="120"
        viewBox="0 0 24 24"
        fill="none"
        class="animate-heart-burst"
      >
        <path
          d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
          fill="#ef4444"
        />
      </svg>
    </div>

    <!-- Toast Container -->
    <div
      id="toast-container"
      class="fixed bottom-24 left-1/2 -translate-x-1/2 z-[60] pointer-events-none"
    ></div>

    <script is:inline>
      // ── Procedural Web Audio API Soundscape Engine (Option 1) ──
      // Generates endless, organic, warm meditative chords and ambient drones.
      // Zero repetition, zero static file loop fatigue, zero network dependencies.
      class ProceduralAmbientEngine {
        constructor() {
          this.ctx = null;
          this.masterGain = null;
          this.currentMood = 'reflective';
          this.activeNodes = [];
          this.isPlaying = false;
        }

        init() {
          if (this.ctx) return;
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (!AudioContextClass) return;
          this.ctx = new AudioContextClass();
          this.masterGain = this.ctx.createGain();
          this.masterGain.gain.setValueAtTime(0, this.ctx.currentTime);
          this.masterGain.connect(this.ctx.destination);
        }

        getMoodConfig(mood) {
          const configs = {
            reflective: {
              notes: [146.83, 220.00, 261.63, 329.63], // D3, A3, C4, E4 (Dm9 meditative)
              type: 'sine',
              filterFreq: 340,
              lfoSpeed: 0.07,
            },
            motivational: {
              notes: [196.00, 246.94, 293.66, 369.99], // G3, B3, D4, F#4 (Gmaj7 golden dawn)
              type: 'triangle',
              filterFreq: 480,
              lfoSpeed: 0.1,
            },
            serene: {
              notes: [164.81, 220.00, 329.63, 440.00], // E3, A3, E4, A4 (Open Zen 5ths)
              type: 'sine',
              filterFreq: 300,
              lfoSpeed: 0.05,
            },
            bold: {
              notes: [65.41, 98.00, 130.81, 196.00], // C2, G2, C3, G3 (Deep earth sub-bass)
              type: 'triangle',
              filterFreq: 240,
              lfoSpeed: 0.08,
            },
            melancholic: {
              notes: [138.59, 164.81, 207.65, 246.94], // C#3, E3, G#3, B3 (C#m7 introspective)
              type: 'sine',
              filterFreq: 320,
              lfoSpeed: 0.06,
            },
            joyful: {
              notes: [261.63, 329.63, 392.00, 523.25], // C4, E4, G4, C5 (Luminous C major)
              type: 'sine',
              filterFreq: 620,
              lfoSpeed: 0.12,
            },
            philosophical: {
              notes: [110.00, 164.81, 220.00, 293.66], // A2, E3, A3, D4 (Cosmic space drone)
              type: 'triangle',
              filterFreq: 380,
              lfoSpeed: 0.05,
            },
            romantic: {
              notes: [174.61, 220.00, 261.63, 349.23], // F3, A3, C4, F4 (Warm rose pad)
              type: 'sine',
              filterFreq: 420,
              lfoSpeed: 0.08,
            },
          };
          return configs[mood] || configs.reflective;
        }

        startSoundscape(mood) {
          if (!this.ctx) return;
          this.currentMood = mood;
          const config = this.getMoodConfig(mood);
          const now = this.ctx.currentTime;

          // Gracefully fade out old chord layer over 1.8s
          const oldNodes = this.activeNodes;
          this.activeNodes = [];

          oldNodes.forEach(({ gain, oscs }) => {
            try {
              gain.gain.setValueAtTime(gain.gain.value, now);
              gain.gain.exponentialRampToValueAtTime(0.0001, now + 1.8);
              setTimeout(() => {
                oscs.forEach(o => {
                  try { o.stop(); o.disconnect(); } catch (e) {}
                });
                gain.disconnect();
              }, 2000);
            } catch (e) {}
          });

          // Create new lush ambient layer
          const layerGain = this.ctx.createGain();
          layerGain.gain.setValueAtTime(0.0001, now);
          layerGain.gain.exponentialRampToValueAtTime(0.18, now + 1.8);

          // Resonant Lowpass Filter
          const filter = this.ctx.createBiquadFilter();
          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(config.filterFreq, now);
          filter.Q.setValueAtTime(2.2, now);

          // Subtle LFO modulation for continuous organic movement
          const lfo = this.ctx.createOscillator();
          const lfoGain = this.ctx.createGain();
          lfo.frequency.setValueAtTime(config.lfoSpeed, now);
          lfoGain.gain.setValueAtTime(config.filterFreq * 0.3, now);
          lfo.connect(lfoGain);
          lfoGain.connect(filter.frequency);
          lfo.start(now);

          const oscs = [lfo];

          // Generate warm polyphonic chord oscillators
          config.notes.forEach((freq, idx) => {
            const osc = this.ctx.createOscillator();
            osc.type = config.type;
            // Detune slightly for analog acoustic warmth
            const detune = (idx % 2 === 0 ? 1 : -1) * (idx * 2.0);
            osc.frequency.setValueAtTime(freq, now);
            osc.detune.setValueAtTime(detune, now);

            const noteGain = this.ctx.createGain();
            const relativeVol = 1 / (1 + idx * 0.4);
            noteGain.gain.setValueAtTime(relativeVol, now);

            osc.connect(noteGain);
            noteGain.connect(filter);
            osc.start(now);
            oscs.push(osc);
          });

          filter.connect(layerGain);
          layerGain.connect(this.masterGain);

          this.activeNodes.push({ gain: layerGain, oscs });
        }

        setMood(mood) {
          if (mood === this.currentMood && this.activeNodes.length > 0) return;
          this.currentMood = mood;
          if (this.isPlaying && this.ctx) {
            this.startSoundscape(mood);
          }
        }

        async toggle() {
          this.init();
          if (!this.ctx) return;
          if (this.ctx.state === 'suspended') {
            await this.ctx.resume();
          }

          const now = this.ctx.currentTime;
          if (this.isPlaying) {
            // Smooth fade out
            this.masterGain.gain.setValueAtTime(this.masterGain.gain.value, now);
            this.masterGain.gain.linearRampToValueAtTime(0, now + 0.6);
            this.isPlaying = false;
            if (window.showToast) window.showToast('Ambient audio muted');
          } else {
            // Smooth fade in
            this.startSoundscape(this.currentMood);
            this.masterGain.gain.setValueAtTime(0, now);
            this.masterGain.gain.linearRampToValueAtTime(0.25, now + 0.8);
            this.isPlaying = true;
            if (window.showToast) window.showToast('Playing generative ambient soundscape');
          }
          this.updateUI();
          return this.isPlaying;
        }

        updateUI() {
          const btn = document.getElementById('audio-toggle-btn');
          if (!btn) return;
          const icon = btn.querySelector('svg');
          const label = btn.querySelector('span');
          if (this.isPlaying) {
            btn.classList.add('text-emerald-400');
            if (icon) {
              icon.innerHTML = `
                <path d="M11 5L6 9H2v6h4l5 4V5z"/>
                <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
              `;
            }
            if (label) {
              label.textContent = 'Playing';
              label.classList.add('text-emerald-300');
            }
          } else {
            btn.classList.remove('text-emerald-400');
            if (icon) {
              icon.innerHTML = `
                <path d="M11 5L6 9H2v6h4l5 4V5z"/>
                <line x1="23" y1="9" x2="17" y2="15"/>
                <line x1="17" y1="9" x2="23" y2="15"/>
              `;
            }
            if (label) {
              label.textContent = 'Audio';
              label.classList.remove('text-emerald-300');
            }
          }
        }
      }

      window.wisdomAudio = new ProceduralAmbientEngine();

      // ── Toast Utility ──
      window.showToast = function(message, duration = 2500) {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = 'glass rounded-xl px-5 py-3 text-sm font-medium text-text-primary animate-toast-in';
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(() => {
          toast.style.animation = 'toast-out 0.3s ease-in forwards';
          setTimeout(() => toast.remove(), 300);
        }, duration);
      };

      // ── Liked Quotes Store ──
      window.likedQuotes = {
        _key: 'liked_quotes',
        getAll() {
          try { return JSON.parse(localStorage.getItem(this._key) || '[]'); }
          catch { return []; }
        },
        has(id) { return this.getAll().includes(id); },
        toggle(id) {
          const all = this.getAll();
          const idx = all.indexOf(id);
          if (idx > -1) { all.splice(idx, 1); }
          else { all.push(id); }
          localStorage.setItem(this._key, JSON.stringify(all));
          return idx === -1; // returns true if now liked
        }
      };
    </script>
  </body>
</html>
