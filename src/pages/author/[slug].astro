---
/**
 * Author Feed — Quotes filtered by author.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReelFeed from '../../components/ReelFeed.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const allQuotes = await getCollection('quotes');
  const quotesData = allQuotes.map((q) => q.data);
  const slugs = [...new Set(quotesData.map((q) => q.authorSlug))];

  return slugs.map((slug) => {
    const matched = quotesData.filter((q) => q.authorSlug === slug);
    const remaining = quotesData.filter((q) => q.authorSlug !== slug);
    const authorName = matched[0]?.author || slug;
    return {
      params: { slug },
      props: {
        quotes: [...matched, ...remaining],
        matchedCount: matched.length,
        authorName,
      },
    };
  });
};

interface Props {
  quotes: any[];
  matchedCount: number;
  authorName: string;
}

const { slug } = Astro.params;
const { quotes, matchedCount, authorName } = Astro.props;
---
<BaseLayout
  title={`${authorName} Quotes — Wisdom`}
  description={`Explore timeless wisdom, reflections, and inspirational quotes by ${authorName}, reimagined as immersive reels.`}
  keywords={[`${authorName} quotes`, authorName, 'wisdom', 'philosophy', 'quotes', 'timeless reflections']}
  breadcrumbs={[
    { name: 'Authors', url: '/wisdom/' },
    { name: authorName, url: `/wisdom/author/${slug}/` },
  ]}
>
  <ReelFeed
    quotes={quotes}
    matchedCount={matchedCount}
    filterLabel={`Quotes by ${authorName}`}
    feedTitle={`Quotes by ${authorName}`}
    feedType="author"
  />
</BaseLayout>
