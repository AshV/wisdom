---
/**
 * Author Feed — Quotes and philosophical context filtered by author.
 * Thick pillar hub page featuring author biography, historical context,
 * primary source bibliography, core concepts, and quote reels.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReelFeed from '../../components/ReelFeed.astro';
import { getCollection } from 'astro:content';
import { getAuthorProfile } from '../../data/authorProfiles';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const allQuotes = await getCollection('quotes');
  const quotesData = allQuotes.map((q) => q.data);
  const slugs = [...new Set(quotesData.map((q) => q.authorSlug))];

  return slugs.map((slug) => {
    const matched = quotesData.filter((q) => q.authorSlug === slug);
    const remaining = quotesData.filter((q) => q.authorSlug !== slug);
    const authorName = matched[0]?.author || slug;
    return {
      params: { slug },
      props: {
        quotes: [...matched, ...remaining.slice(0, 15)],
        matchedCount: matched.length,
        authorName,
      },
    };
  });
};

interface Props {
  quotes: any[];
  matchedCount: number;
  authorName: string;
}

const { slug } = Astro.params;
const { quotes, matchedCount, authorName } = Astro.props;

const profile = getAuthorProfile(slug!, authorName);

const initials = profile.name
  .split(' ')
  .filter(Boolean)
  .map((n) => n[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

const firstName = profile.name.split(' ')[0];

const pageTitle = `${profile.name} Quotes & Philosophy — Wisdom`;
const pageDescription = `Explore ${matchedCount}+ verified quotes, reflections, and primary philosophy of ${profile.name} (${profile.era}), ${profile.tradition}. Immersive quote reels & context.`;

// Rich Schema.org CollectionPage & Person Structured Data for Google E-E-A-T
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: profile.summary,
  url: `https://www.ashishvishwakarma.com/wisdom/author/${slug}/`,
  about: {
    '@type': 'Person',
    name: profile.name,
    description: profile.bio,
    sameAs: profile.wikipediaUrl,
    knowsAbout: [profile.tradition, ...profile.pillars.map((p) => p.concept)],
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: matchedCount,
    itemListElement: quotes.slice(0, 30).map((q, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      item: {
        '@type': 'Quotation',
        text: q.content,
        creator: {
          '@type': 'Person',
          name: profile.name,
        },
      },
    })),
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  keywords={[
    `${profile.name} quotes`,
    `${profile.name} philosophy`,
    profile.tradition,
    ...profile.pillars.map((p) => p.concept.toLowerCase()),
    'wisdom',
    'quotes',
    'timeless reflections',
  ]}
  breadcrumbs={[
    { name: 'Authors', url: '/wisdom/' },
    { name: profile.name, url: `/wisdom/author/${slug}/` },
  ]}
>
  <!-- Schema.org JSON-LD for Google E-E-A-T and Knowledge Graph -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Author Context Pill Button (Responsive: Centered below header on mobile, docked in top-right header on desktop) -->
  <button
    id="author-context-trigger"
    type="button"
    class="fixed top-14 left-1/2 -translate-x-1/2 sm:top-3.5 sm:left-auto sm:right-24 md:right-28 sm:translate-x-0 z-40 px-3 py-1 sm:py-1.5 rounded-full glass border border-amber-300/30 text-amber-200 hover:text-white hover:border-amber-300/60 hover:bg-amber-400/10 text-xs font-medium tracking-wide transition-all duration-300 flex items-center gap-2 shadow-lg backdrop-blur-md cursor-pointer group active:scale-95 whitespace-nowrap"
    aria-label={`Read biographical context for ${profile.name}`}
    title={`Biographical & Philosophical Context for ${profile.name} (Press 'i')`}
  >
    <span class="w-4 h-4 rounded-full bg-amber-400/20 text-amber-300 text-[9px] font-serif font-bold flex items-center justify-center border border-amber-400/40 group-hover:scale-110 transition-transform">
      {initials}
    </span>
    <span class="text-white/90">About</span>
    <span class="font-semibold text-amber-300">{firstName}</span>
    <span class="hidden md:inline-block text-[10px] text-white/40 font-mono pl-0.5">[i]</span>
  </button>

  <!-- Accessible Author Editorial Dossier Modal -->
  <div
    id="author-context-modal"
    class="fixed inset-0 z-50 bg-black/85 backdrop-blur-xl opacity-0 pointer-events-none transition-all duration-300 flex items-center justify-center"
    style="padding: clamp(1rem, 3.5vw, 3rem);"
    role="dialog"
    aria-modal="true"
    aria-labelledby="author-modal-title"
  >
    <div
      class="relative w-full max-w-6xl flex flex-col rounded-2xl sm:rounded-3xl overflow-hidden border border-amber-400/25 bg-[#0c0a15] shadow-[0_25px_90px_rgba(0,0,0,0.95),0_0_60px_rgba(251,191,36,0.08)] text-white"
      style="height: min(84vh, 780px); max-height: calc(100vh - 4rem);"
    >
      <!-- Top Sticky App Bar (Safe insets away from outer borders) -->
      <header
        class="relative z-20 shrink-0 border-b border-white/10 flex items-center justify-between select-none shadow-md"
        style="background-color: #0d0a1a; padding-left: clamp(1.5rem, 5vw, 4.5rem); padding-right: clamp(1.5rem, 5vw, 4.5rem); padding-top: 1.25rem; padding-bottom: 1.25rem;"
      >
        <div class="flex items-center gap-4 min-w-0">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-amber-400/20 via-rose-500/15 to-purple-500/20 border border-amber-300/40 flex items-center justify-center text-amber-200 font-serif font-bold text-xs shrink-0 shadow-sm">
            {initials}
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="text-[10px] uppercase font-mono tracking-[0.2em] text-amber-400/90 font-semibold">
                Philosopher Dossier
              </span>
              <span class="hidden sm:inline text-white/30 text-xs">•</span>
              <span class="hidden sm:inline text-xs text-white/60 font-mono">{profile.era}</span>
            </div>
            <h1 class="text-sm sm:text-base font-serif font-bold text-white tracking-wide truncate">
              {profile.name}
            </h1>
          </div>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <button
            id="author-context-close"
            type="button"
            class="w-10 h-10 rounded-full bg-white/10 hover:bg-amber-400/20 border border-white/10 hover:border-amber-300/40 text-white/70 hover:text-white flex items-center justify-center transition-all duration-200 cursor-pointer group active:scale-95 shadow-sm"
            aria-label="Close author bio (Esc)"
            title="Close (Esc)"
          >
            <svg class="w-4 h-4 group-hover:rotate-90 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>
      </header>

      <!-- Scrollable Editorial Body with Generous Border Clearance & Insets -->
      <div
        class="flex-1 overflow-y-auto author-modal-scroll space-y-10"
        style="padding-left: clamp(1.5rem, 5vw, 4.5rem); padding-right: clamp(1.5rem, 5vw, 4.5rem); padding-top: 2rem; padding-bottom: 7rem;"
      >
        
        <!-- 2-COLUMN EDITORIAL MAGAZINE GRID ON DESKTOP (lg:) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
          
          <!-- ── LEFT COLUMN (lg:col-span-5): Identity, Essence, Callout Card, Quick Actions ── -->
          <div class="lg:col-span-5 flex flex-col gap-6">
            
            <!-- Hero Presentation Box with generous interior padding -->
            <div
              class="rounded-2xl sm:rounded-3xl bg-white/[0.035] border border-white/10 shadow-lg space-y-6"
              style="padding: clamp(1.5rem, 3vw, 2.25rem);"
            >
              
              <!-- Crest Avatar & Badges -->
              <div class="flex items-center gap-4">
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-amber-400/25 via-amber-600/15 to-purple-800/25 border-2 border-amber-300/40 shadow-xl flex items-center justify-center relative overflow-hidden shrink-0">
                  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(251,191,36,0.25)_0%,transparent_70%)] pointer-events-none"></div>
                  <span class="font-serif italic font-bold text-2xl sm:text-3xl text-amber-100 tracking-wider drop-shadow-md select-none">
                    {initials}
                  </span>
                </div>

                <div class="flex-1 min-w-0 space-y-2">
                  <div class="flex flex-wrap items-center gap-1.5">
                    <span class="text-[10px] uppercase tracking-wider text-amber-300 font-semibold px-2.5 py-1 rounded-full bg-amber-400/10 border border-amber-400/30">
                      {profile.tradition}
                    </span>
                    <span class="text-[10px] text-white/60 font-mono px-2.5 py-1 rounded-full bg-white/5 border border-white/10">
                      {profile.era}
                    </span>
                  </div>
                  <div class="text-xs text-amber-200/90 font-medium flex items-center gap-1.5">
                    <span>{matchedCount} Curated Quotes</span>
                    <span class="text-amber-400/70 font-sans">&infin;</span>
                  </div>
                </div>
              </div>

              <!-- Author Title & Summary -->
              <div class="space-y-3">
                <h2 id="author-modal-title" class="text-2xl sm:text-3xl font-serif font-bold text-white tracking-tight leading-tight">
                  {profile.name}
                </h2>
                <p class="text-xs sm:text-sm text-amber-100/90 font-serif italic leading-relaxed border-l-2 border-amber-400/50 pl-4 pr-3 py-2 bg-amber-400/[0.03] rounded-r-lg">
                  "{profile.summary}"
                </p>
              </div>

              <!-- Action Buttons embedded inside profile card for instant access -->
              <div class="pt-2 flex flex-col gap-2.5">
                <button
                  id="author-modal-explore-cta"
                  type="button"
                  class="w-full py-3 px-5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-300 hover:from-amber-300 hover:to-amber-200 text-neutral-950 font-bold text-xs sm:text-sm shadow-[0_0_20px_rgba(251,191,36,0.3)] hover:shadow-[0_0_28px_rgba(251,191,36,0.5)] active:scale-95 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span>Explore Quotes &amp; Reels</span>
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="12" y1="5" x2="12" y2="19" />
                    <polyline points="19 12 12 19 5 12" />
                  </svg>
                </button>

                <div class="flex items-center gap-2.5">
                  <button
                    id="author-modal-share-btn"
                    type="button"
                    class="flex-1 py-2 px-3.5 rounded-xl glass border border-white/15 hover:border-amber-300/40 text-white/80 hover:text-white text-xs font-medium flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
                    title={`Share link to ${profile.name}'s quotes`}
                  >
                    <svg class="w-3.5 h-3.5 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" />
                      <polyline points="16 6 12 2 8 6" />
                      <line x1="12" y1="2" x2="12" y2="15" />
                    </svg>
                    <span>Share Link</span>
                  </button>

                  {profile.wikipediaUrl && (
                    <a
                      href={profile.wikipediaUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex-1 py-2 px-3.5 rounded-xl glass border border-white/15 hover:border-amber-300/40 text-amber-300 hover:text-amber-200 text-xs font-medium flex items-center justify-center gap-1.5 transition-colors"
                    >
                      <span>Wikipedia</span>
                      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15 3 21 3 21 9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </div>

            <!-- Why Timeless Master Quote Callout Card -->
            <div
              class="relative rounded-2xl sm:rounded-3xl bg-gradient-to-r from-amber-950/40 via-purple-950/30 to-black/60 border border-amber-400/30 overflow-hidden shadow-xl"
              style="padding: clamp(1.5rem, 3vw, 2.25rem);"
            >
              <span class="absolute -top-6 right-3 text-7xl font-serif text-amber-300/10 select-none pointer-events-none">
                &ldquo;
              </span>
              <div class="relative z-10 space-y-2.5">
                <div class="flex items-center gap-2 text-[10px] sm:text-xs font-mono uppercase tracking-[0.2em] text-amber-400 font-semibold">
                  <span>✦</span> Why This Voice Endures
                </div>
                <blockquote class="text-xs sm:text-sm text-amber-100/95 font-serif italic leading-relaxed pt-1 pr-3">
                  "{profile.whyTimeless}"
                </blockquote>
              </div>
            </div>

          </div>

          <!-- ── RIGHT COLUMN (lg:col-span-7): Narrative, Pillars, Bibliography ── -->
          <div class="lg:col-span-7 flex flex-col gap-8">
            
            <!-- Biography / Narrative Section -->
            <section class="space-y-3.5">
              <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-amber-300/90 font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                Biographical Narrative
              </div>
              <div
                class="rounded-2xl sm:rounded-3xl bg-gradient-to-b from-white/[0.06] to-white/[0.02] border border-white/10 text-base sm:text-lg text-white/90 leading-relaxed font-sans shadow-inner"
                style="padding: clamp(1.75rem, 3.5vw, 2.5rem);"
              >
                <p class="first-letter:font-serif first-letter:text-5xl sm:first-letter:text-6xl first-letter:font-bold first-letter:text-amber-300 first-letter:float-left first-letter:mr-4 first-letter:leading-none">
                  {profile.bio}
                </p>
              </div>
            </section>

            <!-- Core Philosophical Pillars -->
            {profile.pillars.length > 0 && (
              <section class="space-y-3.5">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                  <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-amber-300/90 font-semibold">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    Core Philosophical Pillars
                  </div>
                  <span class="text-[11px] text-white/50 font-mono">Foundational concepts &amp; principles</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
                  {profile.pillars.map((pillar, idx) => (
                    <div
                      class="rounded-2xl bg-white/[0.035] border border-white/10 hover:border-amber-400/35 hover:bg-white/[0.06] transition-all duration-300 flex flex-col justify-between group shadow-sm"
                      style="padding: 1.5rem 1.75rem;"
                    >
                      <div>
                        <div class="flex items-center justify-between gap-3 mb-2.5">
                          <span class="text-sm sm:text-base font-bold font-serif text-white group-hover:text-amber-200 transition-colors">
                            {pillar.concept}
                          </span>
                          <span class="text-[10px] font-mono font-bold text-amber-400/70 bg-amber-400/10 px-2.5 py-0.5 rounded border border-amber-400/20 shrink-0">
                            {String(idx + 1).padStart(2, '0')}
                          </span>
                        </div>
                        <p class="text-xs sm:text-sm text-white/75 leading-relaxed font-sans">
                          {pillar.description}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            )}

            <!-- Primary Sourced Works -->
            {profile.keyWorks.length > 0 && (
              <section class="space-y-3.5">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                  <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-amber-300/90 font-semibold">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    Primary Sourced Works
                  </div>
                  <span class="text-[11px] text-white/50 font-mono">Essential literature &amp; treatises</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
                  {profile.keyWorks.map((work) => (
                    <div
                      class="rounded-2xl bg-white/[0.03] border border-white/10 hover:border-white/20 transition-colors flex items-start gap-4 shadow-sm"
                      style="padding: 1.5rem 1.75rem;"
                    >
                      <div class="w-10 h-10 rounded-xl bg-amber-400/10 border border-amber-400/20 text-amber-300 flex items-center justify-center shrink-0 mt-0.5">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                        </svg>
                      </div>
                      <div class="min-w-0 flex-1">
                        <h4 class="text-sm sm:text-base font-semibold font-serif text-white tracking-wide">
                          {work.title}
                        </h4>
                        <p class="text-xs sm:text-sm text-white/70 leading-relaxed mt-1 font-sans">
                          {work.description}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            )}

          </div>
        </div>

        <!-- Ample Bottom Clearance Spacer -->
        <div class="h-16 sm:h-20"></div>
      </div>
    </div>
  </div>

  <style is:inline>
    .author-modal-scroll {
      scrollbar-width: thin;
      scrollbar-color: rgba(251, 191, 36, 0.35) rgba(255, 255, 255, 0.03);
    }
    .author-modal-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .author-modal-scroll::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.03);
      border-radius: 8px;
    }
    .author-modal-scroll::-webkit-scrollbar-thumb {
      background: rgba(251, 191, 36, 0.3);
      border-radius: 8px;
    }
    .author-modal-scroll::-webkit-scrollbar-thumb:hover {
      background: rgba(251, 191, 36, 0.6);
    }
  </style>

  <!-- Semantic Hidden-to-Viewers / Visible-to-Crawlers Fallback Block for SEO (No-JS Crawlers) -->
  <article class="sr-only" itemscope itemtype="https://schema.org/Person">
    <h1 itemprop="name">{profile.name}</h1>
    <p><strong>Historical Era:</strong> {profile.era}</p>
    <p><strong>Philosophical Tradition:</strong> {profile.tradition}</p>
    <div itemprop="description">
      <p>{profile.bio}</p>
      <h2>Philosophical Teachings</h2>
      <ul>
        {profile.pillars.map((p) => (
          <li><strong>{p.concept}:</strong> {p.description}</li>
        ))}
      </ul>
      <h2>Sourced Works & Literature</h2>
      <ul>
        {profile.keyWorks.map((w) => (
          <li><strong>{w.title}:</strong> {w.description}</li>
        ))}
      </ul>
      <p>{profile.whyTimeless}</p>
    </div>
  </article>

  <!-- Interactive Full-Screen Reel Feed -->
  <ReelFeed
    quotes={quotes}
    matchedCount={matchedCount}
    filterLabel={`Quotes by ${profile.name}`}
    feedTitle={`Quotes by ${profile.name}`}
    feedType="author"
  />

  <script is:inline>
    // Client-side controller for Author Context Modal
    function setupAuthorModal() {
      const trigger = document.getElementById('author-context-trigger');
      const modal = document.getElementById('author-context-modal');
      const closeBtn = document.getElementById('author-context-close');
      const exploreCta = document.getElementById('author-modal-explore-cta');
      const shareBtn = document.getElementById('author-modal-share-btn');

      if (!trigger || !modal) return;

      function openModal() {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        modal.classList.remove('opacity-100', 'pointer-events-auto');
        modal.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      }

      trigger.onclick = openModal;
      if (closeBtn) closeBtn.onclick = closeModal;

      if (exploreCta) {
        exploreCta.onclick = () => {
          closeModal();
          const reel = document.getElementById('reel-container');
          if (reel) {
            reel.scrollIntoView({ behavior: 'smooth' });
          }
        };
      }

      if (shareBtn) {
        shareBtn.onclick = () => {
          if (navigator.clipboard) {
            navigator.clipboard.writeText(window.location.href.split('#')[0].split('?')[0]).then(() => {
              if (window.showToast) {
                window.showToast('Link to author profile copied! ✓');
              }
            }).catch(() => {
              if (window.showToast) window.showToast('Could not copy link');
            });
          }
        };
      }

      modal.onclick = (e) => {
        if (e.target === modal) closeModal();
      };

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
        if ((e.key === 'i' || e.key === 'I') && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {
          if (modal.classList.contains('opacity-100')) {
            closeModal();
          } else {
            openModal();
          }
        }
      });

      // Auto-open modal if ?about=1 or ?bio=1 in URL
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('about') === '1' || urlParams.get('bio') === '1') {
        openModal();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupAuthorModal);
    } else {
      setupAuthorModal();
    }
    document.addEventListener('astro:page-load', setupAuthorModal);
  </script>
</BaseLayout>
