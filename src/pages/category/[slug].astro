---
/**
 * Category Feed — Quotes filtered by category.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReelFeed from '../../components/ReelFeed.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const allQuotes = await getCollection('quotes');
  const quotesData = allQuotes.map((q) => q.data);
  const slugs = [...new Set(quotesData.map((q) => q.categorySlug))];

  return slugs.map((slug) => {
    const matched = quotesData.filter((q) => q.categorySlug === slug);
    const remaining = quotesData.filter((q) => q.categorySlug !== slug);
    const categoryName = matched[0]?.category || slug;
    return {
      params: { slug },
      props: {
        quotes: [...matched, ...remaining.slice(0, 15)],
        matchedCount: matched.length,
        categoryName,
      },
    };
  });
};

interface Props {
  quotes: any[];
  matchedCount: number;
  categoryName: string;
}

const { slug } = Astro.params;
const { quotes, matchedCount, categoryName } = Astro.props;
---
<BaseLayout
  title={`${categoryName} Quotes — Wisdom`}
  description={`Explore timeless ${categoryName.toLowerCase()} quotes and philosophy reimagined as immersive reels.`}
  keywords={[`${categoryName} quotes`, categoryName, 'wisdom', 'philosophy', 'quotes', 'inspirational thoughts']}
  breadcrumbs={[
    { name: 'Categories', url: '/wisdom/' },
    { name: categoryName, url: `/wisdom/category/${slug}/` },
  ]}
>
  <ReelFeed
    quotes={quotes}
    matchedCount={matchedCount}
    filterLabel={`${categoryName} Wisdom`}
    feedTitle={categoryName}
    feedType="category"
  />
</BaseLayout>
