---
/**
 * Master Feed — All quotes, reverse-chronological.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ReelFeed from '../components/ReelFeed.astro';
import { getCollection } from 'astro:content';

const allQuotes = await getCollection('quotes');
const parseQuoteNum = (id: string) => parseInt(id.replace(/\D/g, ''), 10) || 0;
const quotes = allQuotes
  .map((q) => q.data)
  .sort((a, b) => parseQuoteNum(b.id) - parseQuoteNum(a.id))
  .slice(0, 50);
---
<BaseLayout title="Wisdom — Timeless Quotes, Reimagined">
  <ReelFeed
    quotes={quotes}
    feedTitle="Wisdom"
    feedType="master"
  />
</BaseLayout>
