---
/**
 * Tag Feed — Quotes filtered by tag.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReelFeed from '../../components/ReelFeed.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const allQuotes = await getCollection('quotes');
  const quotesData = allQuotes.map((q) => q.data);

  const tags = [...new Set(quotesData.flatMap((q) => q.tags))];

  return tags.map((tag) => {
    const matched = quotesData.filter((q) => q.tags.includes(tag));
    const remaining = quotesData.filter((q) => !q.tags.includes(tag));
    return {
      params: { slug: tag },
      props: {
        quotes: [...matched, ...remaining.slice(0, 15)],
        matchedCount: matched.length,
        tagName: tag,
      },
    };
  });
};

interface Props {
  quotes: any[];
  matchedCount: number;
  tagName: string;
}

const { slug } = Astro.params;
const { quotes, matchedCount, tagName } = Astro.props;
---
<BaseLayout
  title={`#${tagName} Quotes — Wisdom`}
  description={`Discover inspiring quotes and wisdom tagged #${tagName}, reimagined as immersive reels.`}
  keywords={[`#${tagName}`, `${tagName} quotes`, tagName, 'wisdom', 'quotes', 'inspirational thoughts']}
  breadcrumbs={[
    { name: 'Tags', url: '/wisdom/' },
    { name: `#${tagName}`, url: `/wisdom/tag/${slug}/` },
  ]}
>
  <ReelFeed
    quotes={quotes}
    matchedCount={matchedCount}
    filterLabel={`#${tagName} Quotes`}
    feedTitle={`#${tagName}`}
    feedType="tag"
  />
</BaseLayout>
