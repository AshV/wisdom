 * An editorial overview and live roadmap of planned and completed
 * author expansions, prioritizing timeless thinkers over ephemeral celebrities.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allQuotes = await getCollection('quotes');
const quoteCount = allQuotes.length;

// Pre-calculate live counts for authors currently in the catalog
const authorQuoteCounts: Record<string, number> = {};
allQuotes.forEach((q) => {
  const slug = q.data.authorSlug;
  authorQuoteCounts[slug] = (authorQuoteCounts[slug] || 0) + 1;
});

const BASE = '/wisdom';

