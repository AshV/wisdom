  name: string;
  slug: string;
  era: string;
  category: string;
  tradition: string;
  tier: 'completed' | 'tier1' | 'ancient' | 'eastern' | 'nature' | 'existential' | 'literature' | 'science' | 'courage';
  primaryWorks: string[];
  themes: string[];
  whyTimeless: string;
}

