---

<BaseLayout
  title="Author Expansion Roadmap & ToDo — Wisdom"
  description="A curated roadmap for expanding Wisdom with 100+ verified quotes from history's most timeless and influential thinkers."
  keywords={[
    'wisdom roadmap',
    'philosophy quotes roadmap',
    'timeless authors',
    'stoicism quotes',
    'epictetus quotes',
    'rumi quotes',
    'marcus aurelius quotes',
    'plato quotes',
  ]}
  breadcrumbs={[
    { name: 'Roadmap & ToDo', url: `${BASE}/todo/` },
  ]}
>
  <!-- Full-page scrollable glassmorphic container -->
  <div class="min-h-screen w-full overflow-y-auto px-4 sm:px-6 md:px-8 py-8 md:py-16 text-text-primary">
    <div class="max-w-4xl mx-auto space-y-10 pb-20">

      <!-- Top Navigation & Return to Feed -->
      <div class="flex items-center justify-between border-b border-white/10 pb-4">
        <a
          href={BASE}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 hover:bg-white/10 border border-white/15 text-sm font-medium text-text-primary transition-all duration-200 hover:scale-105 active:scale-95 shadow-lg backdrop-blur-md"
        >
          <svg class="w-4 h-4 text-accent-start" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Quote Reels
        </a>

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-start/15 border border-accent-start/30 text-xs font-semibold text-accent-start tracking-wide uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-start animate-ping"></span>
          Author Expansion Roadmap
        </div>
      </div>

      <!-- Hero Header -->
      <div class="space-y-4">
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight font-display bg-gradient-to-r from-white via-text-primary to-accent-start bg-clip-text text-transparent">
          Timeless Thinkers Roadmap
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-3xl">
          Wisdom exists to honor the thoughts that have anchored the human soul across centuries and millennia.
          We add <strong>100 verified quotes per author</strong> from primary translations and historic texts —
          strictly curating philosophers, mystics, classic writers, and scientific pioneers, and rejecting fleeting celebrity noise.
        </p>
      </div>

      <!-- Key Metrics Counter Bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md flex flex-col items-center text-center">
          <span class="text-2xl sm:text-3xl font-bold font-display text-accent-start">{quoteCount}</span>
          <span class="text-xs text-text-secondary uppercase tracking-wider mt-1">Quotes in Catalog</span>
        </div>
        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md flex flex-col items-center text-center">
          <span class="text-2xl sm:text-3xl font-bold font-display text-emerald-400">{completedCount}</span>
          <span class="text-xs text-text-secondary uppercase tracking-wider mt-1">100+ Author Batches</span>
        </div>
        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md flex flex-col items-center text-center">
          <span class="text-2xl sm:text-3xl font-bold font-display text-purple-300">{plannedCount}</span>
          <span class="text-xs text-text-secondary uppercase tracking-wider mt-1">Roadmap Authors</span>
        </div>
        <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-md flex flex-col items-center text-center">
          <span class="text-2xl sm:text-3xl font-bold font-display text-amber-300">100%</span>
          <span class="text-xs text-text-secondary uppercase tracking-wider mt-1">Primary Verified</span>
        </div>
      </div>

      <!-- Guiding Philosophy Callout: Timeless Thinkers vs. Celebrities -->
      <div class="p-5 sm:p-6 rounded-3xl bg-gradient-to-br from-purple-950/40 via-surface-elevated/80 to-surface-glass border border-white/15 backdrop-blur-xl shadow-2xl space-y-4">
        <div class="flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-accent-start">
          <span>🏛️</span>
          <span>Editorial Charter: Timelessness vs. Transient Noise</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm text-text-secondary">
          <div class="p-3.5 rounded-xl bg-emerald-950/20 border border-emerald-500/20 space-y-1.5">
            <div class="font-semibold text-emerald-400 flex items-center gap-1.5">
              <span>✓</span> What Belongs in Wisdom
            </div>
            <p>
              Thinkers whose ideas have stood the test of generations. Sourced strictly from published books,
              dialogues, poems, and philosophical letters. Exploring virtue, grief, courage, love, consciousness, and death.
            </p>
          </div>
          <div class="p-3.5 rounded-xl bg-rose-950/20 border border-rose-500/20 space-y-1.5">
            <div class="font-semibold text-rose-400 flex items-center gap-1.5">
              <span>✕</span> Strictly Excluded
            </div>
            <p>
              Ephemeral pop-culture celebrity gossip, modern influencer soundbites, corporate buzzwords,
              and unsourced internet clichés falsely attributed to famous figures.
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Filter Buttons -->
      <div class="space-y-3">
        <div class="text-xs uppercase font-bold tracking-wider text-text-muted">Filter by Tradition & Tier:</div>
        <div class="flex flex-wrap gap-2" id="filter-container">
          <button class="filter-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-white/20 text-white border border-white/30 transition-all cursor-pointer" data-filter="all">All ({authors.length})</button>
          <button class="filter-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-text-secondary border border-white/10 hover:bg-white/10 transition-all cursor-pointer" data-filter="completed">Completed 100+ ({completedCount})</button>
          <button class="filter-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-text-secondary border border-white/10 hover:bg-white/10 transition-all cursor-pointer" data-filter="tier1">⚡ Next Priority (5)</button>
          <button class="filter-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-text-secondary border border-white/10 hover:bg-white/10 transition-all cursor-pointer" data-filter="ancient">Ancient Greece & Rome</button>
          <button class="filter-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-text-secondary border border-white/10 hover:bg-white/10 transition-all cursor-pointer" data-filter="eastern">Eastern Wisdom</button>
          <button class="filter-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-text-secondary border border-white/10 hover:bg-white/10 transition-all cursor-pointer" data-filter="nature">Nature & Transcendentalism</button>
          <button class="filter-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-text-secondary border border-white/10 hover:bg-white/10 transition-all cursor-pointer" data-filter="existential">Existentialism & Psychology</button>
          <button class="filter-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-text-secondary border border-white/10 hover:bg-white/10 transition-all cursor-pointer" data-filter="literature">World Literature</button>
          <button class="filter-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-text-secondary border border-white/10 hover:bg-white/10 transition-all cursor-pointer" data-filter="science">Cosmos & Science</button>
          <button class="filter-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-text-secondary border border-white/10 hover:bg-white/10 transition-all cursor-pointer" data-filter="courage">Moral Courage</button>
        </div>
      </div>

      <!-- Author Cards Grid -->
      <div class="space-y-4" id="authors-list">
        {authors.map((author) => {
          const liveCount = authorQuoteCounts[author.slug] || 0;
          const isCompleted = author.tier === 'completed';
          const isTier1 = author.tier === 'tier1';

          return (
            <div
              class="author-card p-5 sm:p-6 rounded-3xl bg-surface-elevated/70 border border-white/10 hover:border-white/20 transition-all duration-300 backdrop-blur-lg space-y-4"
              data-tier={author.tier}
            >
              <!-- Card Header -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/5 pb-3">
                <div>
                  <div class="flex items-center gap-2.5 flex-wrap">
                    <h3 class="text-xl sm:text-2xl font-bold font-display text-white">{author.name}</h3>
                    <span class="text-xs text-text-muted font-sans">({author.era})</span>
                    <span class="px-2 py-0.5 rounded-md text-[11px] font-medium bg-white/5 text-text-secondary border border-white/10">{author.tradition}</span>
                  </div>
                  <p class="text-xs text-text-muted mt-1 italic">{author.whyTimeless}</p>
                </div>

                <!-- Status Pill & Link -->
                <div class="flex items-center gap-2 self-start sm:self-center shrink-0">
                  {isCompleted ? (
                    <a
                      href={`${BASE}/author/${author.slug}/`}
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-semibold hover:bg-emerald-500/25 transition-all shadow-sm"
                    >
                      <span>✓</span>
                      <span>{liveCount} Quotes Live</span>
                      <svg class="w-3 h-3 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </a>
                  ) : isTier1 ? (
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs font-semibold">
                      <span>⚡</span>
                      <span>Next Batch ({liveCount} current)</span>
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-text-muted text-xs font-medium">
                      <span>○</span>
                      <span>Planned ({liveCount} current)</span>
                    </span>
                  )}
                </div>
              </div>

              <!-- Card Body: Primary Sources & Themes -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs sm:text-sm">
                <div class="space-y-1.5">
                  <div class="text-[11px] font-bold uppercase tracking-wider text-accent-start">Primary Verified Sources:</div>
                  <div class="flex flex-wrap gap-1.5">
                    {author.primaryWorks.map((work) => (
                      <span class="px-2 py-0.5 rounded-md bg-white/[0.04] text-text-secondary border border-white/5 text-xs font-serif italic">
                        {work}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="space-y-1.5">
                  <div class="text-[11px] font-bold uppercase tracking-wider text-text-muted">Core Themes:</div>
                  <div class="flex flex-wrap gap-1.5">
                    {author.themes.map((theme) => (
                      <span class="px-2 py-0.5 rounded-md bg-accent-start/10 text-accent-start border border-accent-start/20 text-xs">
                        #{theme}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Verification Standard & Contribution Guidelines -->
      <div class="p-6 rounded-3xl bg-white/[0.02] border border-white/10 backdrop-blur-md space-y-4">
        <h2 class="text-xl font-bold font-display text-white flex items-center gap-2">
          <span>⚙️</span>
          <span>Technical Schema for Adding 100 Quotes</span>
        </h2>
        <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
          Every quote is stored as an individual JSON document inside <code class="text-accent-start font-mono bg-white/5 px-1.5 py-0.5 rounded">src/data/quotes/qXXXX.json</code> and validated at compile time against Astro's Content Collections schema.
        </p>
        <pre class="p-4 rounded-xl bg-black/50 border border-white/10 text-xs text-emerald-300 font-mono overflow-x-auto">
{`{
  "id": "q1001",
  "content": "Make the best use of what is in your power, and take the rest as it happens.",
  "author": "Epictetus",
  "authorSlug": "epictetus",
  "category": "Wisdom",
  "categorySlug": "wisdom",
  "mood": "reflective",
  "tags": ["control", "acceptance", "stoicism", "resilience"],
  "theme": "dark",
  "duration": 8
}`}
        </pre>
      </div>

      <!-- Bottom Return Button -->
      <div class="pt-6 flex justify-center">
        <a
          href={BASE}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gradient-to-r from-accent-start to-accent-end text-black font-semibold text-sm shadow-xl hover:scale-105 active:scale-95 transition-all"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
          Return to Wisdom Reel Feed
        </a>
      </div>

    </div>
  </div>

  <!-- Interactive Filter Logic -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const authorCards = document.querySelectorAll('.author-card');

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          // Toggle button styles
          filterBtns.forEach((b) => {
            b.classList.remove('bg-white/20', 'text-white', 'border-white/30');
            b.classList.add('bg-white/5', 'text-text-secondary', 'border-white/10');
          });
          btn.classList.remove('bg-white/5', 'text-text-secondary', 'border-white/10');
          btn.classList.add('bg-white/20', 'text-white', 'border-white/30');

          // Filter cards
          authorCards.forEach((card) => {
            const cardTier = card.getAttribute('data-tier');
            if (filter === 'all') {
              card.style.display = 'block';
            } else if (filter === 'completed' && cardTier === 'completed') {
              card.style.display = 'block';
            } else if (filter === 'tier1' && cardTier === 'tier1') {
              card.style.display = 'block';
            } else if (filter === cardTier) {
              card.style.display = 'block';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</BaseLayout>
